{%- comment -%}
  # crop: 'cover', 'contain', 'default'
  # height: px or %
  # limit: set max width values for image size
{%- endcomment -%}
{%- liquid
  if image == blank
    assign type = type | default: 'image'

    render 'empty-content', type: type, index: index
    break
  endif

  assign widths = width | default: '180,375,535,750,1024,1280,1366,1440,1920,2880' | split: ','
  assign limit = limit | default: image.width
  assign imageRatio = ratio | default: image.aspect_ratio | default: 1
  assign heightDefault = 1 | divided_by: imageRatio | times: 100 | append: '%'
  assign imageWidth = image.width | default: 10
  assign imageHeight = image.height | default: 10
  assign imageAlt = image.alt | default: image.title | escape
-%}
{%- comment -%} Sources {%- endcomment -%}

{%- capture widths -%}
  {%- for width in widths -%}
    {%- assign number = width | strip | times: 1 -%}
    {%- if number > limit -%}{%- break -%}{%- endif -%}
    ,{{- number -}}
  {%- endfor -%}
{%- endcapture -%}
{%- assign widths = widths | remove_first: ',' | default: image.width | append: '' -%}

{%- capture srcset -%}
  {{- image | image_url: width: image.width | image_tag: widths: widths -}}
{%- endcapture -%}

{%- if srcset contains 'srcset' -%}
  {%- assign srcset = srcset | split: 'srcset="' | last | split: '"' | first -%}
{%- else -%}
  {%- assign srcset = srcset | split: 'src="' | last | split: '"' | first -%}
{%- endif -%}

{%- if disableLazyload and request.design_mode == blank and preload != false -%}
  <!-- split:preload[ -->
  <link
    href="{{srcset | split: ',' | first }}"
    as="image"
    rel="preload"
    media="{{ media | default: 'all' }}"
    imagesrcset="{{srcset}}"
  >
  <!-- split:preload] -->
{%- endif -%}

{%- capture source -%}<source media="{{ media | default: 'all' }}"{% unless disableLazyload %}{% endunless %}srcset="{{srcset}}"/>{%- endcapture -%}

{%- if getSource -%}
  {{- source -}}
  {%- break -%}
{%- endif -%}

{%- capture styles -%}
  --imgHeight: {{ height | default: heightDefault }};
  {%- unless image.presentation.focal_point == blank -%}
    --imgPoint: {{ image.presentation.focal_point }};
  {%- endunless -%}
{%- endcapture -%}
{%- capture class -%}absolute l0 t0 w100 h100 {{ classImage }} image-{{crop | default: 'default'}}{% unless disableLazyload %} lazyloaded has-lazy{% endunless %}{%- endcapture -%}

<picture
  class="block image__style border-radius relative overflow-hidden {{ classImage }}"
  style="{{ styles | strip_newlines }}"
>
  {{ source }}
  {{ sourceHover }}

  <img
    src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
    class="{{class}}"
    alt="{{imageAlt}}"
    width="{{imageWidth}}"
    height="{{imageHeight}}"
    loading="lazy"
  >
</picture>
