{% assign description = product.description %}
{% capture description %}{{ description }}{% endcapture %}

<div class="product-simple-tab">
  <div role="tabpanel">

    <ul class="nav nav-tabs" role="tablist">
      {% if description and settings.product_full_multi_tabs_style != 'none' %}

        {% if settings.enable_multi_tabs %}
          {% assign description_parts = description | split: "<h5" %}

          {% for part in description_parts %}
            {% if part contains "</h5>" %}
              {% assign remove = part | split: ">" | first | append: ">" %}
              {% capture ind %}{{ forloop.index | plus: 0}}{% endcapture %}
              <li role="presentation"{% if ind == '2' %} class="active"{% endif %}><a href="#tabs-{{ forloop.index }}" aria-controls="tabs-{{ forloop.index }}" role="tab" data-toggle="tab">{{ part | split: "</h5>" | first | strip_html | replace: remove, "" }}</a></li>
            {% endif %}
          {% endfor %}

        {% else %}
          <li role="presentation" class="active"><a href="#tabs-description" aria-controls="tabs-description" role="tab" data-toggle="tab">{{ 'products.product.description' | t }}<div class="esc-size-matters-preinstall" id="preinstall-b5c75228b176ca1eb479d582cf1510ed"></div></a></li>

        {% endif %}

      {% endif %}

      {% if settings.product_tab_review %}
        <li role="presentation" id="tab_review_tabbed"{% if description == blank or settings.product_full_multi_tabs_style == 'none' %} class="active"{% endif %}><a href="#tab_review" aria-controls="tab_review" role="tab" data-toggle="tab">{{'products.product.customer_reviews' | t }}</a></li>
      {% endif %}
    </ul>

    <div class="tab-content">
      {% if description and settings.product_full_multi_tabs_style != 'none' %}

        {% if settings.enable_multi_tabs %}
          {% assign description_parts = description | split: "<h5" %}

          {% for part in description_parts %}
            {% assign fp = part | append: " " | split: "</h5>" | last %}
            {% assign p = part | append: " " | split: "</h5>" | last | strip_html | replace: "&nbsp;", "" | replace: " ", "" | strip_newlines %}
            {% capture ind %}{{ forloop.index | plus: 0}}{% endcapture %}
            {% if p != "" or fp contains "<img " or fp contains "<iframe " %}
              <div role="tabpanel" class="tab-pane{% if ind == '2' %} active{% endif %}" id="tabs-{{ forloop.index }}">
                {{ part | split: "</h5>" | last | replace: "<div", "<span" | replace: "</div", "</span" }}
              </div>
          {% endif %}
        {% endfor %}
      
        {% else %}
          <div role="tabpanel" class="tab-pane active" id="tabs-description">
            {{ description }}
          </div>
      
        {% endif %}
      
      {% endif %}

      {% if settings.product_tab_review %}
        <div role="tabpanel" class="tab-pane{% if description == blank or settings.product_full_multi_tabs_style == 'none' %} active{% endif %}" id="tab_review">
          <div id="shopify-product-reviews" data-id="{{product.id}}">{{ product.metafields.spr.reviews }}</div>
          <!-- Start of Judge.me code -->
      <div style='clear:both'></div>
      <div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}' data-auto-install='false'>
        {{ product.metafields.judgeme.widget }}
      </div>
      <!-- End of Judge.me code -->
        </div>
      {% endif %}
    </div>

  </div>
</div>