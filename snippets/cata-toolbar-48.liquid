<div class="cata-toolbar">
  <div class="group-toolbar">
    
    {% if settings.show_sb_filters and collection.all_tags.size > 0 %}
    
      {% if settings.catalog_sb_placement == 'none' %}
        <div class="filter-icon"><i class="fa fa-bars"></i>{{ 'collections.general.heading_sb_filters' | t }}</div>
      {% else %}
        <div class="mobile-filter visible-sm visible-xs"><i class="fa fa-bars"></i>{{ 'collections.general.heading_sb_filters' | t }}</div>
      {% endif %}
    
    {% endif %}
    
    {% if settings.show_col_gl %}
    <div class="group-gl">
      <ul class="list-inline">
        <li class="grid-list">
          <span class="grid active" title="{{ 'collections.general.title_grid' | t }}"><i class="fa fa-th-large"></i>{{ 'collections.general.title_grid' | t }}</span>
          <span class="list" title="{{ 'collections.general.title_list' | t }}"><i class="fa fa-bars"></i>{{ 'collections.general.title_list' | t }}</span>
        </li>
      </ul>
    </div>
    {% endif %}
    
    {% include 'collection-sorting' %}
    
    {% if settings.show_col_show_by %}
    <div class="show-by">
      <div class="show-by-inner">

        <div id="cata_show_by" class="dropdown-toggle" data-toggle="dropdown">
          <span class="title">{{ 'collections.general.show_by' | t }}</span>
          <button id="show_by_button">
            <span class="name">48</span>
            <i class="fa fa-caret-down"></i>
          </button>
        </div>

        <ul id="show_by_box" class="dropdown-menu">
          <li class="show-action"><a href="24">24</a></li>
          <li class="show-action"><a href="36">36</a></li>
          <li class="show-action active"><a href="48">48</a></li>
          <li class="show-action"><a href="50">50</a></li>
        </ul>

      </div>
    </div>
    {% endif %}
    
    {% include 'collection-pagination' %}
    
    
  </div>
</div>