<span class="product-label">
  {% unless settings.enable_saleoff_label == 'none' %}
    {% if product.variants.first.compare_at_price and product.variants.first.price < product.variants.first.compare_at_price %}
      <span class="label-sale">
        {% if settings.enable_saleoff_label == 'percent' %}
        {% assign percent_off = product.variants.first.price | times:100.00 | divided_by: product.variants.first.compare_at_price | round %}
        <span class="sale-text">{{ 100 | minus : percent_off }}%</span>
        
        {% else %}
        <span class="sale-text">{{ 'products.label.sale' | t }}</span>
        {% endif %}
      </span>
    {% endif %}
  {% endunless %}

  {% if settings.enable_new_label %}
    {% for tag in product.tags %}
      {% capture t %}{{ tag | downcase }}{% endcapture %}

      {% if t contains 'label new' %}
        <span class="label-new">
          <span class="new-text">{{ 'products.label.new' | t }}</span>
        </span>

      {% endif %}

    {% endfor %}
  {% endif %}
</span>