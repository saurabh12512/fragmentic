<div {% comment remove microdata structured data %}itemscope{% endcomment %} itemtype="http://schema.org/Product">
  <meta itemprop="url" content="{{ shop.url }}{{ product.url }}" />
  <meta itemprop="image" content="{{ product.featured_image.src | product_img_url: 'grande' }}">
  <span itemprop="name" class="hide">{{ product.title }}</span>

  {% assign _product_image_class = "col-md-6 col-sm-6" %}
  {% assign _product_info_class = "col-md-6 col-sm-6" %}
  {% assign _product_layout = '1' %}
  
  {% if settings.product_sb_placement == 'none' %}
    {% assign _product_layout = '2' %}
  {% endif %}

  {% assign meta_bw = product.metafields.c_f %}

  {% unless meta_bw.buy_with_1 == blank %}
    {% assign accessory_handle_1 = meta_bw.buy_with_1 %}
    {% assign accessory_1 = all_products[accessory_handle_1] %}
  {% endunless %}
  
  {% unless meta_bw.buy_with_2 == blank %}
    {% assign accessory_handle_2 = meta_bw.buy_with_2 %}
    {% assign accessory_2 = all_products[accessory_handle_2] %}
  {% endunless %}


  <div class="row">

    {% if settings.product_sb_placement == 'left' %}
      {% include 'sidebar-product' %}
    {% endif %}

    <!-- Begin #col-main -->

    <div class="{% if settings.product_sb_placement == 'none' %}col-md-12{% else %}col-md-9{% endif %} col-sm-12 col-xs-12">
      <div id="col-main" class="page-product product-single layout-{{ _product_layout }} product-combo">

        <div class="product">
          <div class="row">

            <!-- Begin #product-image -->

            <div id="product-image" class="{{ _product_image_class }} product-image">
              <div class="product-image-inner row">
                {% if product.images.size > 0 %}

                  {% if settings.meta_image360 %}
                    {% assign _meta_image360 = product.metafields.meta %}
                    {% assign key = 'image360' %}

                    {% unless _meta_image360.image360 == blank %}

                      <div class="meta-image360">
                        <a class="m-360" data-fancybox-type="iframe" href="{{ _meta_image360.image360 }}"><span class="icon-360"></span>{{ 'products.product.image360' | t }}</a>
                      </div> 

                      <script>
                        $(document).ready(function() {
                          $(".m-360").fancybox({
                            maxWidth	: 800,
                            maxHeight	: 600,
                            fitToView	: false,
                            width		: '70%',
                            height		: '70%',
                            autoSize	: false,
                            closeClick	: false,
                            openEffect	: 'none',
                            closeEffect	: 'none'
                          });
                        });
                      </script>

                    {% endunless %}

                  {% endif %}

                  {% assign featured_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image %}
                  <a href="{{ featured_image | product_img_url: 'original' }}" class="featured-image elevatezoom">
                    <img id="product-featured-image" class="magniflier zoom-image" src="{{ featured_image | product_img_url: '1024x1024' }}" data-zoom-image="{{ featured_image | product_img_url: 'original' }}" alt="{{ product.title | escape }}" />
                  </a>

                  {% if settings.meta_video %}
                    {% assign _meta_video = product.metafields.meta %}
                    {% assign key = 'video' %}

                    {% unless _meta_video.video == blank %}

                      <div class="meta-video">
                        <a href="{{ _meta_video.video }}" class="m-video"><i class="fa fa-play"></i>{{ 'products.product.video' | t }}</a>
                      </div>

                      <script src="{{ 'jquery.fancybox-media.js' | asset_url  }}"></script>

                      <script>
                        $(document).ready(function() {
                          $('.m-video').fancybox({
                            openEffect  : 'none',
                            closeEffect : 'none',
                            helpers : {
                              media : {}
                            }
                          });
                        });
                      </script>

                    {% endunless %}

                  {% endif %}

                  <div class="more-view-image">
                    <ul id="gallery-image" class="gallery-image-thumb">
                      {% for image in product.images %}
                        <li>
                          <a class="thumb-img{% if forloop.index == 1 %} active{% endif %}" data-image="{{ image | product_img_url: '1024x1024' }}" data-zoom-image="{{ image | product_img_url: 'original' }}">
                            <img src="{{ image.src | product_img_url: 'compact' }}" alt="{{ product.title | escape }}">
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>

                {% else %}

                  <img src="{{ 'default-image.jpg' | asset_url }}" />

                {% endif %}

              </div>

              {% if settings.show_social_sharing_product %}
                {% include 'social-sharing' %}
              {% endif %}
            </div>

            <!-- End #product-image /- -->


            <!-- Begin #product-info -->

            <div id="product-info" class="{{ _product_info_class }} product-info">

              <div itemprop="offers" {% comment remove microdata structured data %}itemscope{% endcomment %} itemtype="http://schema.org/Offer">

                <h1 itemprop="name" content="{{ product.title }}" class="page-heading">{{ product.title }}</h1>
                <meta itemprop="priceCurrency" content="{{ shop.currency }}" />

                {% if settings.show_product_vendor and product.vendor %}
                  <div class="author">{{ product.vendor | link_to_vendor }}</div>
                {% endif %}

                <div class="group-wlcp">
                  {% if settings.enable_product_wishlist %}	
                    <a class="btn add-to-wishlist add-product-wishlist" data-handle-product="{{product.handle}}" href="javascript:void(0);" title="{{ 'products.product.add_to_wishlist' | t }}"><span class="flaticon-favorite"></span>{{ 'products.product.add_to_wishlist' | t }}</a>
                  {% endif %}

                  {% if settings.enable_product_compare %}
                    <a class="btn add-to-compare add-product-compare" data-handle-product="{{product.handle}}" href="javascript:void(0);" title="{{ 'products.product.add_compare' | t }}"><span class="flaticon-graphic"></span>{{ 'products.product.add_compare' | t }}</a>
                  {% endif %}
                </div>

                {% if settings.product_tab_review %}
                  <div class="rating-links">
                    <div class="shopify-product-reviews-badge" data-id="{{ product.id }}"></div>
                    <a href="#tab_review">{{ 'products.product.add_your_review' | t }}</a>
                  </div>
                {% endif %}

                <div class="clearfix"></div>

                {% if product.available %}
                  <link itemprop="availability" href="http://schema.org/InStock" />
                {% else %}
                  <link itemprop="availability" href="http://schema.org/OutOfStock" />
                {% endif %}

                {% unless settings.custom_field == blank %}
                  <div class="custom-filed">{{ settings.custom_field }}</div>
                {% endunless %}

                <div class="rtp-wrapper">
                  <span class="total">{{ 'cart.general.total' | t }}</span>
                  <div class="group-total-price">{{ accessory_1.price | plus: accessory_2.price | money }}</div>
                </div>

                <div class="group-cw clearfix"> 

                  <form action="{{routes.cart_url}}" method="post" class="product-action variants" enctype="multipart/form-data">
                    <div id="product-action"  class="options">

                      {% assign meta_bw = product.metafields.c_f %}
                      
                      {% unless meta_bw.buy_with_1 == blank and meta_bw.buy_with_2 == blank %}
                        <div class="bundled-items">

                          {% unless meta_bw.buy_with_1 == blank %}
                            <div class="bundled-item">
                              <div class="bundled-item-image">
                                {% assign featured_image_1 = accessory_1.selected_or_first_available_variant.featured_image | default: accessory_1.featured_image %}
                                <a href="{{ accessory_1.url }}">
                                  <img src="{{ featured_image_1 | product_img_url: '100x' }}" alt="{{ accessory_1.title | escape }}" />
                                </a>
                              </div>

                              <div class="variants-wrapper clearfix">
                                <h4><a href="{{ accessory_1.url }}">{{ accessory_1.title }}</a></h4>

                                <div id="purchase-{{ accessory_1.id }}" class="product-price">
                                  <div class="detail-price detail-price-1" itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}">
                                    <span class="price">{{ accessory_1.price | money }}</span>
                                    <span class="t-price hide">{{ accessory_1.price }}</span>
                                  </div>
                                </div>

                                <select id="product-select-0" name='id[]'>

                                  {% for variant in accessory_1.variants %}

                                    {% if variant.available %}
                                      <option {% if variant == accessory_1.selected_or_first_available_variant %} selected="selected" {% endif %} value="{{ variant.id }}">{{ variant.title }}</option>

                                    {% else %}
                                      <option disabled="disabled">
                                        {{ variant.title }} - {{'products.product.sold_out' | t }}
                                      </option>

                                    {% endif %}

                                  {% endfor %}

                                </select>
                              </div>
                            </div>
                          {% endunless %}

                          {% unless meta_bw.buy_with_2 == blank %}
                            <div class="bundled-item">
                              <div class="bundled-item-image">
                                {% assign featured_image_2 = accessory_2.selected_or_first_available_variant.featured_image | default: accessory_2.featured_image %}
                                <a href="{{ accessory_2.url }}">
                                  <img src="{{ featured_image_2 | product_img_url: '100x' }}" alt="{{ accessory_2.title | escape }}" />
                                </a>
                              </div>

                              <div class="variants-wrapper clearfix">

                                <h4><a href="{{ accessory_2.url }}">{{ accessory_2.title }}</a></h4>

                                <div id="purchase-{{ accessory_2.id }}" class="product-price">
                                  <div class="detail-price detail-price-2" itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}">
                                    <span class="price">{{ accessory_2.price | money }}</span>
                                    <span class="t-price hide">{{ accessory_2.price }}</span>
                                  </div>
                                </div>

                                <select id="product-select-1" name='id[]'>
                                  {% for variant in accessory_2.variants %}

                                    {% if variant.available %}
                                      <option {% if variant == accessory_2.selected_or_first_available_variant %} selected="selected" {% endif %} value="{{ variant.id }}">{{ variant.title }}</option>

                                    {% else %}
                                      <option disabled="disabled">
                                        {{ variant.title }} - {{'products.product.sold_out' | t }}
                                      </option>

                                    {% endif %}

                                  {% endfor %}
                                </select>
                              </div>

                            </div>
                          {% endunless %}

                        </div>
                      {% endunless %}
                      

                      {% if settings.meta_description_excerpt %}
                        {% assign meta_shortdes = product.metafields.meta %}
                        {% assign key = 'description_excerpt' %}

                        {% unless meta_shortdes.description_excerpt == blank %}
                          <div class="short-description">{{ meta_shortdes.description_excerpt }}</div>
                        {% endunless %}

                      {% endif %}

                      <div class="quantity-product">
                        <div class="quantity">
                          <label>{{ 'products.product.quantity' | t }}</label>
                          <input type="number" id="quantity" class="item-quantity" name="quantity" value="1" />
                          <span class="qty-wrapper">
                            <span class="qty-inner">

                              <span class="qty-up" title="Increase" data-src="#quantity">
                                <i class="fa fa-plus"></i>
                              </span>

                              <span class="qty-down" title="Decrease" data-src="#quantity">
                                <i class="fa fa-minus"></i>
                              </span>

                            </span>
                          </span>
                        </div>

                        {% if settings.meta_size_chart %}
                          {% assign meta_sizechart = product.metafields.meta %}
                          {% assign key = 'image_size_chart' %}

                          {% unless meta_sizechart.image_size_chart == blank %}

                            <div class="size-chart">
                              <a href="#size-chart-popup">{{ 'products.product.size_chart' | t }}</a>
                            </div>

                            <div id="size-chart-popup" style="display: none;"><img src= "{{ meta_sizechart.image_size_chart | split: 'https:' }}" alt="" /></div>

                            <script>
                              jQuery(document).ready(function($) {   
                                $(".size-chart a").fancybox();
                              });
                            </script>

                          {% endunless %}

                        {% endif %}

                      </div>

                      {% if settings.enable_remaining_quantity_message %}
                        {% if product.variants.first.inventory_management == "shopify" and product.variants.first.inventory_policy == "deny" and product.variants.first.inventory_quantity > 0 and product.variants.first.inventory_quantity < 10 %}
                          <div id="stock">
                            <span>{{"products.product.remaining_quantity_message_1" | t }} {{ product.variants.first.inventory_quantity }} {{"products.product.in_stock" | t }}</span>
                          </div>
                        {% endif %}
                      {% endif %}

                      <div class="action-button">
                        <button id="add-to-cart" class="add-to-cart btn btn-default" type="button"><span class="flaticon-commerce"></span>{{ 'products.product.add_to_cart' | t }}</button> 
                      </div>

                    </div>
                  </form>
                </div>

                <div class="detail-deal">{% include 'product-detail-deals' %}</div>

                {% if settings.show_secure_image or settings.show_paypal_image %}
                  <div class="secure-image">

                    {% if settings.show_secure_image %}
                      <img src = "{{ 'secure_image.png' | asset_url }}" alt="Secure" />
                    {% endif %}

                    {% if settings.show_paypal_image %}
                      <img src = "{{ 'paypal_image.png' | asset_url }}" alt="Secure" />
                    {% endif %}

                  </div>
                {% endif %}
                
                {% if settings.product_multi_tabs_style == 'accordion' %}
                  {% include 'product-accordion-tab' %}
                {% endif %}

                <!-- endif product.avaiable /- -->

              </div>

            </div>

            <!-- End #product-info /- -->

          </div>
        </div>

        <!-- End .product /- -->

        {% unless settings.product_multi_tabs_style == 'accordion' %}
          {% if settings.product_multi_tabs_style == 'tab' or settings.product_tab_review  %}
            {% include 'product-tab' %}
          {% endif %}
        {% endunless %}

        {% if settings.enable_related_product %}
          {% include 'related-product' %}
        {% endif %}
        
        {% if settings.enable_recently_viewed %}
        	{% include 'recently-viewed' %}
        {% endif %}

      </div>
    </div>

    <!-- End #col-main /- -->

    {% if settings.product_sb_placement == 'right' %}
      {% include 'sidebar-product' %}
    {% endif %}

  </div>

</div>

{% include 'notify-product-slider' %}

<script type="text/javascript">

	// initialize multi selector for product
	$(window).load(function() {
      
        setTimeout(function(){
          AT_Main.scareWidth();
        }, 1000);
      
      	$(".qty-inner .qty-up").on("click", function() {
			var oldValue = $("#quantity").val(),
				newVal = 1;
				newVal = parseInt(oldValue) + 1;
				$("#quantity").val(newVal);
		});
		$(".qty-inner .qty-down").on("click", function() {
			var oldValue = $("#quantity").val();
			if (oldValue > 1) {
				newVal = 1;
				newVal = parseInt(oldValue) - 1;
				$("#quantity").val(newVal);
			}
		});

		/* selectCallback */
		var selectOptionsCallback = function(variant, selector) {
          
          
			var add_to_cart = '#add-to-cart';
			var $price = '#purchase-' + selector.product.id.toString() + ' .detail-price';
			if (variant && variant.available) {
              
              	if(variant.inventory_management == "shopify" && variant.inventory_policy == "deny" && variant.inventory_quantity > 0 && variant.inventory_quantity < 10) {
                  jQuery("#stock").html('<span>{{"products.product.remaining_quantity_message_1" | t }} ' + variant.inventory_quantity + ' {{"products.product.remaining_quantity_message_2" | t }}</span>').show();
                }
                                        
                else{
                  jQuery("#stock").hide();
                }
              	

				// selected a valid variant
				$(add_to_cart).removeClass('disabled').removeAttr('disabled').html('<span class="flaticon-commerce"></span>{{ "products.product.add_to_cart" | t }}'); // remove unavailable class from add-to-cart button, and re-enable button

				$($price).html('<span class="price">'+Shopify.formatMoney(variant.price, '{{shop.money_format}}')+'</span><span class="t-price hide">' + variant.price +'</span>');
                
                                                                                        
				{% if settings.show_multiple_currencies %}
                   /* Update currency */
                   currenciesCallbackSpecial('#product-info span.money');
				{% endif %}
				  
			} 
			else {
              	jQuery("#stock").hide();
				$(add_to_cart).addClass('disabled').attr('disabled', 'disabled'); // set add-to-cart button to unavailable class and disable button
				var message = variant ? "{{'products.product.sold_out' | t }}" : "{{'products.product.unavailable' | t }}";
				$(add_to_cart).html(message);
				//$($price).html('<span class="unavailable">' + message + '</span>');
			}
                
		};

        {% if accessory_1.variants.size > 1 %}
            new Shopify.OptionSelectors("product-select-0", { product: {{ accessory_1 | json | remove:'\u003E' | remove:'\u003C' | remove:'\u00a0' }}, onVariantSelected: selectOptionsCallback });
        {% endif %}
          
        {% if accessory_2.variants.size > 1 %}
            new Shopify.OptionSelectors("product-select-1", { product: {{ accessory_2 | json | remove:'\u003E' | remove:'\u003C' | remove:'\u00a0' }}, onVariantSelected: selectOptionsCallback });
        {% endif %}
          
        // Add label if only one product option
		{% if accessory_1.options.size == 1 and accessory_1.options.first != 'Title' %}
			$('.selector-wrapper:eq(0)').prepend('<label>{{ accessory_1.options.first | escape }}</label>');
		{% endif %}
												 
		// Hide selectors if we only have 1 variant and its title contains 'Default'.
		{% if accessory_1.variants.size == 1 and accessory_1.variants.first.title contains 'Default' %}
			$('.selector-wrapper').hide();
		{% endif %}
          
          
        // Add label if only one product option
		{% if accessory_2.options.size == 1 and accessory_2.options.first != 'Title' %}
			$('.selector-wrapper:eq(0)').prepend('<label>{{ accessory_2.options.first | escape }}</label>');
		{% endif %}
												 
		// Hide selectors if we only have 1 variant and its title contains 'Default'.
		{% if accessory_2.variants.size == 1 and accessory_2.variants.first.title contains 'Default' %}
			$('.selector-wrapper').hide();
		{% endif %}

	});
      
    $(document).on('change','.selector-wrapper',function(e){
      
      {% unless meta_bw.buy_with_1 == blank %}
      var _price1 = Number($(".detail-price-1 .t-price").html());
      {% else %}
      var _price1 = 0;
      {% endunless %}
      
      {% unless meta_bw.buy_with_2 == blank %}
      var _price2 = Number($(".detail-price-2 .t-price").html());
      {% else %}
      var _price2 = 0;
      {% endunless %}
      
      var _price = $('.group-total-price');
      var _tprice = _price1 + _price2;
      
      $(_price).html('<span class="price">'+Shopify.formatMoney(_tprice, '{{shop.money_format}}')+'</span>');
                                                                
      {% if settings.show_multiple_currencies %}
         currenciesCallbackSpecial('.group-total-price span.money');
      {% endif %}
      
    });
     
</script>