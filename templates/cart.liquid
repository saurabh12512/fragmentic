{% assign full_url = request.host | append: request.path %}

<div id="col-main" class="page-cart">

  <div class="gift-title">
    <strong>
      <img class="gift-icons-box" src="https://cdn.shopify.com/s/files/1/0414/0715/2281/files/cart-Photoroom_1.png?v=1768137705" alt="Gift Icon">
          {{ 'cart.general.cart_heading' | t }}
    </strong>
  </div>

    <div class="text-center cart-empty-wrapper" rv-show="cart.item_count | lt 1">
      <p class="cart empty">{{ 'cart.general.empty' | t }}</p>
