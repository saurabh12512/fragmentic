    <div id="form-status"></div>
  {% endif %}

</form>
{% if is_arabic %}
  <div class="confirmation-container" dir="rtl">
    <div class="svgIcons">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
    </div>

    <h1>لقد تم تقديم طلبك</h1>

    <p>
        شكرًا لك على تقديم طلبك للحصول على العطر.<br>
        يقوم فريقنا حاليًا بمراجعة الطلب مع شبكة موزّعينا الموثوقين وموردينا المعتمدين.  
        ستتلقى تحديثًا عبر واتساب بمجرد تأكيد التوفّر والأسعار.
    </p>

    <div class="response-time">
        الوقت المقدر للاستجابة: ٣–٧ أيام عمل.
    </div>

    <a href="https://www.fragmantic.com/" class="continue-btn">اكمل التسوق</a>
</div>
{% else %}
  <div class="confirmation-container">
   <div class="svgIcons">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" >
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
    </svg>
</div>
    <h1>Your Request Has Been Submitted</h1>
    <p>Thank you for submitting your perfume request.<br>
    Our team is now reviewing it with our network of trusted distributors and authorised suppliers. You will receive a WhatsApp update once availability and pricing are confirmed.</p>

    <div class="response-time">Estimated Response Time: 3–7 Business Days</div>

    <a href="https://www.fragmantic.com/" class="continue-btn">Continue Shopping</a>
</div>
{% endif %}
<script>
  window.isArabic = {{ is_arabic | json }};
</script>
<script>
document.addEventListener("DOMContentLoaded", function() {
  
  const wrapper = document.getElementById("perfumeWrapper");
  const addButton = document.querySelector(".addPerfume");

  // Add new perfume field
  {% comment %} addButton.addEventListener("click", function() {
    const row = document.createElement("div");
    row.classList.add("rowGsheet2");

    row.innerHTML = `
      <input type="text" name="fragrance_name[]" placeholder="Ex. Guess Seductive W EDT 75ml" required>
      <button type="button" class="removePerfume">−</button>
    `;

    wrapper.appendChild(row);
  }); {% endcomment %}
  // Add new perfume field
  addButton.addEventListener("click", function() {

    const placeholderText = window.isArabic 
      ? "عطر جيس سيداكتيف للنساء، ماء عطر، 75 مل."
      : "Ex. Guess Seductive W EDT 75ml";

    const row = document.createElement("div");
    row.classList.add("rowGsheet2");

    row.innerHTML = `
      <input type="text" name="fragrance_name[]" placeholder="${placeholderText}" required>
      <button type="button" class="removePerfume">−</button>
    `;

    wrapper.appendChild(row);
  });

  // Remove perfume field
  wrapper.addEventListener("click", function(e) {
    if (e.target.classList.contains("removePerfume")) {
      e.target.parentElement.remove();
    }
  });


  // Submit form
  document.getElementById("gsheet-form").addEventListener("submit", function(e) {
    e.preventDefault();

    $('.loading').show();

    const form = this;

    const perfumes = [...document.querySelectorAll('input[name="fragrance_name[]"]')]
                      .map(i => i.value.trim())
                      .filter(v => v !== "");

    if (perfumes.length === 0) {
      alert("Enter at least one perfume name");
      return;
    }

    const customer_name = form.customer_name.value;
    const phone_number = form.phone_number.value;
    const reference_link = form.reference_link.value;
    const additional_notes = form.additional_notes.value;

    // Send all perfumes as separate rows
    const rows = perfumes.map(name => ({
      fragrance_name: name,
      customer_name,
      phone_number,
      reference_link,
      additional_notes
    }));

    fetch("https://script.google.com/macros/s/AKfycbxSPQDMjTn_XjvxDtXDIQmcK4uhORERYwieCeqlYIHQ0cM01JUI2dq3ke1qNaSft23BbQ/exec", {
      method: "POST",
      body: JSON.stringify(rows)
    })
    .then(res => res.text())
    .then(() => {
      $('.loading').hide();
      {% comment %} document.getElementById("form-status").innerHTML = "Submitted successfully!"; {% endcomment %}
       // Hide form
      document.querySelector("form#gsheet-form").style.display = "none";

      // Show confirmation box
      document.querySelector(".confirmation-container").style.display = "block";
      form.reset();
    })
    .catch(() => {
      $('.loading').hide();
      document.getElementById("form-status").innerHTML = "Error! Please try again.";
    });

  });

});
</script>


