<style>
form#gsheet-form {
    background: #f8f7f5;
    border-radius: 20px;
    padding: 20px;
    max-width: 500px;
    margin: 50px auto;
}
svg#perfume {
    width: 40px;
    margin: 0 auto 20px;
    display: block;
}
h2.fragranceH2 {
    font-weight: 700;
    line-height: 1.1em;
    text-align: center;
    margin-bottom: 10px;
    color: #222;
    font-family: Poppins, Arial, Helvetica, sans-serif;
    text-transform: capitalize;
    font-size: 22px;
}
p.fragrinfo {
    font-weight: 400;
    line-height: 1.3;
    text-align: start;
    color: #7f7f7f;
    font-family: Poppins, Arial, Helvetica, sans-serif;
    margin-bottom: 20px;
    font-size: 12px;
}
.rowGsheet {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
}
.confirmation-container{
display:none;}
.rowGsheet label , .rowGsheetCon label{
    font-weight: 500;
    line-height: 1.1em;
    text-align: start;
    color: #222;
    font-family: Poppins, Arial, Helvetica, sans-serif;
    margin-bottom: 0;
    font-size: 15px;
}
.rowGsheet input , .rowGsheet textarea , .rowGsheet2 input {
    font-weight: 500;
    line-height: 1.1em;
    text-align: start;
    color: rgb(34, 34, 34);
    font-family: Poppins, Arial, Helvetica, sans-serif;
    margin-bottom: 0px;
    font-size: 15px;
    background: #fff;
    border-radius: 10px;
    width:100%;
}
.rowGsheet2 {
    display: flex;
    gap: 10px;
}
.rowGsheetCon {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
}
button.addPerfume {
    width: 45px;
    background: #fff;
    font-size: 25px;
    border-radius: 9px;
    border: 1px solid #e1e1e1;
    flex-shrink: 0;
}
form#gsheet-form> button:hover {
    background: #b2b2b2;
    border-color: #b2b2b2;
    box-shadow: none;
}
form#gsheet-form> button {
    background: #000;
    width: 100%;
    height: 40px;
    border-radius: 10px;
    color: #fff;
    font-weight: 500;
    line-height: 1.1em;
    text-align: center;
    font-family: Poppins, Arial, Helvetica, sans-serif;
    margin-bottom: 0px;
    font-size: 15px;
    border:0px;
}
button.removePerfume {
    width: 45px;
    background: #fff;
    font-size: 25px;
    border-radius: 9px;
    border: 1px solid #e1e1e1;
    flex-shrink: 0;
}
div#perfumeWrapper {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
div#form-status {
    text-align: center;
    color: green;
    margin: 10px 0;
    font-size: 18px;
}

  .confirmation-container {
    background-color: #ffffff;
    padding: 40px 30px;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    max-width: 400px;
    text-align: center;
    margin: 20px auto;
}

    .confirmation-container svg {
        width: 40px;
        height: 40px;
            color: #ffffff;
        
    }

  .confirmation-container h1 {
    font-size: 22px;
    margin: 0 0 15px;
    font-weight: 700;
    color: #111111;
    text-transform: capitalize;
}

    .confirmation-container p {
        font-size: 16px;
        color: #555555;
        line-height: 1.5;
        margin: 0 0 20px;
    }

    .response-time {
        display: block;
        padding: 10px 15px;
        border: 1px solid #cccccc;
        border-radius: 6px;
        font-size: 14px;
        color: #333333;
        margin-bottom: 25px;
    }

    .continue-btn {
        background-color: #111111;
        color: #ffffff;
        padding: 12px 25px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
        text-decoration: none;
    }
      .svgIcons {
          width: 50px;
          height: 50px;
          margin: 0 auto 20px;
          background: #4caf50;
          display: flex;
          justify-content: center;
          align-items: center;
          border-radius: 50px;
      }
    .continue-btn:hover {
        background-color: #333333;
    }

@media only screen and (max-width:767px){
  form#gsheet-form {
    margin: 0px auto;
}
}
</style>

{% assign full_url = request.host | append: request.path %}
{% if full_url contains '/ar/' %}
  {% assign is_arabic = true %}
{% else %}
  {% assign is_arabic = false %}
{% endif %}

<form id="gsheet-form"> 
