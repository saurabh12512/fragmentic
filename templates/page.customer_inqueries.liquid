    <path d="M403.512,221.082c2.24-9.226,0.32-18.719-5.28-26.078l-19.092-25.172c-5.813-7.573-14.932-12.106-24.426-12.106h-36.052v-6.133c0-11.306-9.173-20.533-20.533-20.533h-14.506v-5.28h-55.25v5.28h-14.506c-11.36,0-20.533,9.226-20.533,20.533v6.133h-36.052c-9.493,0-18.612,4.533-24.426,12.106l-19.092,25.172c-5.6,7.359-7.52,16.852-5.28,26.078c18.132,74.449,18.132,153.112,0,227.561c-2.24,9.173-0.32,18.719,5.28,26.078l19.092,25.172c5.759,7.573,14.932,12.107,24.426,12.107h197.429c9.493,0,18.665-4.534,24.426-12.107l19.092-25.172c5.599-7.359,7.52-16.906,5.28-26.078C385.38,374.194,385.38,295.531,403.512,221.082z M389.753,468.268l-19.145,25.172c-3.733,4.96-9.706,7.893-15.892,7.893h-197.43c-6.186,0-12.159-2.933-15.892-7.893l-19.145-25.172c-3.626-4.8-4.907-11.039-3.412-17.119c18.559-76.049,18.559-156.471,0-232.575c-1.493-6.08-0.214-12.319,3.412-17.119l19.145-25.172c3.733-4.96,9.706-7.893,15.892-7.893h76.689v3.573c0,10.293,7.093,18.933,16.693,21.279V227h10.666v-33.758c9.599-2.347,16.693-10.987,16.693-21.279v-3.573h76.689c6.186,0,12.159,2.933,15.892,7.893l19.145,25.172c3.626,4.8,4.907,11.039,3.413,17.119c-18.559,76.102-18.559,156.525,0,232.575C394.66,457.229,393.379,463.469,389.753,468.268z"></path>
  </svg>
  {% if is_arabic %}
    <h2 class="fragranceH2">لم تجد عطرك المفضل علي موقعنا ؟</h2>
    <p class="fragrinfo">
      ادخل بياناتك و اسم العطر و سيقوم فريقنا بالبحث عنه في شبكه الوكلاء و الموزعين المعتمدين 
      و سنقوم بابلاغك بسعره و امكانيه توفيره
    </p>

    <div class="rowGsheet">
      <label>الاسم</label>
      <input type="text" name="customer_name" required placeholder="ادخل اسمك">
    </div>

    <div class="rowGsheet">
      <label>رقم الواتساب</label>
      <input type="text" name="phone_number" required placeholder="01xxxxxxx">
    </div>

    <div class="rowGsheetCon">
      <label>اسم العطر (اصلي فقط)</label>

      <div id="perfumeWrapper">
        <div class="rowGsheet2">
          <input type="text" name="fragrance_name[]" required placeholder="مثال : ديور سوفاج 100مل">
          <button type="button" class="addPerfume">+</button>
        </div>
      </div>

    </div>

    <div class="rowGsheet">
      <label>لينك مرجعي (اختياري)</label>
      <input type="text" name="reference_link" placeholder="رابط للمنتج من موقع اخر اذا وجد">
    </div>

    <div class="rowGsheet">
      <label>ملاحظات اخري</label>
      <textarea name="additional_notes" placeholder="ادخل اي تفاصيل اخري"></textarea>
    </div>

    <button type="submit">ارسال</button>
    <div id="form-status"></div>
  {% else %}

    <h2 class="fragranceH2">Can't find the Fragrance you like?</h2>
    <p class="fragrinfo">
      Enter your details and the perfume name, and our team will search for it through our network of trusted distributors and authorised suppliers, We will then Confirm the price and availability with you.
    </p>

    <div class="rowGsheet">
      <label>Name</label>
      <input type="text" name="customer_name" required placeholder="Enter Your Name">
    </div>

    <div class="rowGsheet">
      <label>WhatsApp Number</label>
      <input type="text" name="phone_number" required placeholder="01xxxxxxxx">
    </div>

    <div class="rowGsheetCon">
      <label>Perfume Name (Original Only)</label>

      <div id="perfumeWrapper">
        <div class="rowGsheet2">
          <input type="text" name="fragrance_name[]" required placeholder="Ex. Dior Sauvage M EDP 100ml">
          <button type="button" class="addPerfume">+</button>
        </div>
      </div>

    </div>

    <div class="rowGsheet">
      <label>Reference Link (Optional)</label>
      <input type="text" name="reference_link" placeholder="Link from another site if available">
    </div>

    <div class="rowGsheet">
      <label>Additional Notes</label>
      <textarea name="additional_notes" placeholder="Enter any other details…"></textarea>
    </div>

