{% if section.blocks.size > 0 %}

  <div class="home-banner-style-3">
    <div class="row">

      {% assign _class = "full" %}
      {% assign _image_size = "1920x" %}
      {% assign _banner_class = "col-lg-12 col-md-12 col-sm-12" %}
      {% for block in section.blocks %}
      
      {% if block.settings.width == 'half' %}
      	{% assign _class = "half" %}
        {% assign _image_size = "960x" %}
        {% assign _banner_class = "col-lg-6 col-md-6 col-sm-6" %}
      {% endif %}

      {%- assign image = block.settings.image -%}
      {%- assign text_1 = block.settings.text_1 -%}
      {%- assign size_text_1 = block.settings.size_text_1 -%}
      {%- assign color_text_1 = block.settings.color_text_1 -%}
      {%- assign text_2 = block.settings.text_2 -%}
      {%- assign size_text_2 = block.settings.size_text_2 -%}
      {%- assign color_text_2 = block.settings.color_text_2 -%}
      {%- assign text_3 = block.settings.text_3 -%}
      {%- assign size_text_3 = block.settings.size_text_3 -%}
      {%- assign color_text_3 = block.settings.color_text_3 -%}
      {%- assign text_4 = block.settings.text_4 -%}
      {%- assign size_text_4 = block.settings.size_text_4 -%}
      {%- assign color_text_4 = block.settings.color_text_4 -%}
      {%- assign text_5 = block.settings.text_5 -%}
      {%- assign size_text_5 = block.settings.size_text_5 -%}
      {%- assign color_text_5 = block.settings.color_text_5 -%}
      {%- assign button_text = block.settings.button_text -%}
      {%- assign size_button_text = block.settings.size_button_text -%}
      {%- assign color_button_text = block.settings.color_button_text -%}
      {%- assign link = block.settings.link -%}

      <div class="banner-item banner-item-{{ _class }} {{ _banner_class }} col-xs-12">
        <div class="image" style="background-image:url({{ image | img_url: _image_size  }});">
          
          {% if forloop.index == 1 %}
          <div class="text">
            {% unless text_1 == blank %}<span class="text-1" style="color: {{ color_text_1 }}; font-size: {{ size_text_1 }}">{{ text_1 }}</span>{% endunless %}
            {% unless text_2 == blank %}<span class="text-2" style="color: {{ color_text_2 }}; font-size: {{ size_text_2 }}">{{ text_2 }}</span>{% endunless %}
            {% unless text_3 == blank %}<span class="text-3" style="color: {{ color_text_3 }}; font-size: {{ size_text_3 }}">{{ text_3 }}</span>{% endunless %}
            {% unless text_4 == blank %}<span class="text-4" style="color: {{ color_text_4 }}; font-size: {{ size_text_4 }}">{{ text_4 }}</span>{% endunless %}
            {% unless text_5 == blank %}<span class="text-5" style="color: {{ color_text_5 }}; font-size: {{ size_text_5 }}">{{ text_5 }}</span>{% endunless %}
            {% unless button_text == blank %}<a class="button" style="color: {{ color_button_text }}; font-size: {{ size_button_text }}; border-top: 1px solid {{ color_button_text }}; border-bottom: 1px solid {{ color_button_text }};" href="{{ link }}">{{ button_text }}</a>{% endunless %}
          </div>
          
          {% else %}
          <div class="text">
            {% unless text_1 == blank %}<span class="text-1" style="color: {{ color_text_1 }}; font-size: {{ size_text_1 }}">{{ text_1 }}</span>{% endunless %}
            {% unless text_2 == blank %}<span class="text-2" style="color: {{ color_text_2 }}; font-size: {{ size_text_2 }}">{{ text_2 }}</span>{% endunless %}
          </div>
          {% endif %}
          
        </div>
      </div>

      {% endfor %}

    </div>
  </div>

{% endif %}

{% schema %}
{
  "name": "Banner Style #3",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "image",
      "name": "Banner",
      "settings": [
		{
          "type": "image_picker",
          "id": "image",
          "label": "=== Image",
          "info": "The width of image should be 960 px for half width and 1920 px for full width"
        },
		{
          "type": "select",
          "id": "width",
          "label": "=== Width",
          "options": [
            {
              "value": "half",
              "label": "Half Width"
            },
			{
              "value": "full",
              "label": "Full Width"
            }
          ],
          "default": "full"
        },
		{
          "type": "text",
          "id": "text_1",
          "label": "=== Text #1"
        },
		{
          "type": "text",
          "id": "size_text_1",
          "label": "Text #1 font size (in px)",
          "default": "26px"
        },
		{
          "type": "color",
          "id": "color_text_1",
          "label": "Text #1 color",
          "default": "#ffffff"
        },
		{
          "type": "text",
          "id": "text_2",
          "label": "=== Text #2"
        },
		{
          "type": "text",
          "id": "size_text_2",
          "label": "Text #2 font size (in px)",
          "default": "46px"
        },
		{
          "type": "color",
          "id": "color_text_2",
          "label": "Text #2 color",
          "default": "#ef3f3d"
        },
		{
          "type": "text",
          "id": "text_3",
          "label": "=== Text #3",
          "info": "Only for Full Width"
        },
		{
          "type": "text",
          "id": "size_text_3",
          "label": "Text #3 font size (in px)",
          "default": "22px"
        },
		{
          "type": "color",
          "id": "color_text_3",
          "label": "Text #3 color",
          "default": "#ffffff"
        },
		{
          "type": "textarea",
          "id": "text_4",
          "label": "=== Text #4",
          "info": "Only for Full Width"
        },
		{
          "type": "text",
          "id": "size_text_4",
          "label": "Text #4 font size (in px)",
          "default": "18px"
        },
		{
          "type": "color",
          "id": "color_text_4",
          "label": "Text #4 color",
          "default": "#ffffff"
        },
		{
          "type": "textarea",
          "id": "text_5",
          "label": "=== Text #5",
          "info": "Only for Full Width"
        },
		{
          "type": "text",
          "id": "size_text_5",
          "label": "Text #5 font size (in px)",
          "default": "16px"
        },
		{
          "type": "color",
          "id": "color_text_5",
          "label": "Text #5 color",
          "default": "#b9b9b9"
        },
		{
          "type": "text",
          "id": "button_text",
          "label": "=== Button text",
          "info": "Only for Full Width"
        },
		{
          "type": "text",
          "id": "size_button_text",
          "label": "Button text font size (in px)",
          "default": "13px"
        },
		{
          "type": "color",
          "id": "color_button_text",
          "label": "Button text color",
          "default": "#ffffff"
        },
		{
          "type": "url",
          "id": "link",
          "label": "=== Link",
          "info": "Only for Full Width"
        }
      ]
    }
    
  ],
  "presets": [
    {
      "name": "Banner Style #3",
      "category": "Banner",
      "blocks": [
        {
          "type": "image"
        },
		{
          "type": "image"
        },
		{
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
