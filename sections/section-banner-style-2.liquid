{% if section.blocks.size > 0 %}
  <style>
    .home-banner-style-2 img.mobonly {
      display: none !important;
    }
    @media all and (max-width: 700px) {
      .home-banner-style-2 img.deskonly {
        display: none;
      }
      .home-banner-style-2 img.mobonly {
        display: block !important;
      }
    }
  </style>

  <div class="container">
    <div class="home-banner-style-2">
      <div class="row">
        {% for block in section.blocks %}
          {%- assign image = block.settings.image -%}
          {%- assign image_mob = block.settings.image_mob -%}
          {%- assign link = block.settings.link -%}

          <div class="banner-item col-sm-{{ block.settings.width }} col-xs-12">
            <div class="image">
              <a href="{{ link }}">
                <img
                  class="lazyload {% if block.settings.image_mob != blank %} deskonly{% endif %}"
                  src="{{ block.settings.image | img_url: '1170x'}}"
                  data-src="{{ block.settings.image | img_url: '1170x' }}"
                  alt=""
                >
                {% if block.settings.image_mob != blank %}
                  <img
                    class="lazyload mobonly"
                    src="{{ block.settings.image_mob | img_url: '970x'}}"
                    data-src="{{ block.settings.image_mob | img_url: '970x' }}"
                    alt=""
                  >
                {% endif %}
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Banner Style #2",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "image",
      "name": "Banner",
