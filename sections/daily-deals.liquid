{% schema %}
{
  "name": "Daily Deals",
  "settings": [
    {
      "type": "number",
      "id": "products_per_day",
      "label": "Products per Day",
      "default": 4
    },
    {
      "type": "collection",
      "id": "saturday_collection",
      "label": "Saturday Collection"
    },
    {
      "type": "collection",
      "id": "sunday_collection",
      "label": "Sunday Collection"
    },
    {
      "type": "collection",
      "id": "monday_collection",
      "label": "Monday Collection"
    },
    {
      "type": "collection",
      "id": "tuesday_collection",
      "label": "Tuesday Collection"
    },
    {
      "type": "collection",
      "id": "wednesday_collection",
      "label": "Wednesday Collection"
    },
    {
      "type": "collection",
      "id": "thursday_collection",
      "label": "Thursday Collection"
    },
    {
      "type": "collection",
      "id": "friday_collection",
      "label": "Friday Collection"
    },
    {
      "type": "header",
      "content": "English Content"
    },
    {
      "type": "text",
      "id": "title_en",
      "label": "Title (EN)",
      "default": "Daily Deals"
    },
    {
      "type": "text",
      "id": "sub_title_en",
      "label": "Sub Title (EN)",
      "default": "A new Secret Deal Every day"
    },
    {
      "type": "text",
      "id": "counter_en",
      "label": "Counter (EN)",
      "default": "Deal Ended In"
    },
    {
      "type": "text",
      "id": "todays_deals_en",
      "label": "Today’s Deals (EN)",
      "default": "Today’s Deals"
    },
    {
      "type": "text",
      "id": "deal_has_ended_en",
      "label": "Deal has Ended (EN)",
      "default": "Deal has Ended"
    },
    {
      "type": "text",
      "id": "deal_ended_in_en",
      "label": "Deal ended in  (EN)",
      "default": "Deal ended in "
    },
    {
      "type": "header",
      "content": "Arabic Content"
    },
    {
      "type": "text",
      "id": "title_ar",
      "label": "Title (AR)",
      "default": "العروض اليومية"
    },
    {
      "type": "text",
      "id": "sub_title_ar",
      "label": "Sub Title (AR)",
      "default": "صفقة جديدة كل يوم"
    },
    {
      "type": "text",
      "id": "counter_ar",
      "label": "Counter (AR)",
      "default": "انتهى العرض في"
    },
    {
      "type": "text",
      "id": "todays_deals_ar",
      "label": "Today’s Deals (AR)",
      "default": "عروض اليوم"
    },
    {
      "type": "text",
      "id": "deal_ended_in_ar",
      "label": "Deal ended in  (AR)",
      "default": "العروض تنتهي خلال"
    },
    {
      "type": "text",
      "id": "deal_has_ended_ar",
      "label": "Deal has Ended (AR)",
      "default": "انتهى العرض"
    },
    {
      "type": "header",
      "content": "Days (EN)"
    },
    {
      "type": "text",
      "id": "days_en",
      "label": "Days (comma separated)",
      "default": "Sat,Sun,Mon,Tue,Wed,Thu,Fri"
    },

    {
      "type": "header",
      "content": "Days (AR)"
    },
    {
      "type": "text",
      "id": "days_ar",
      "label": "Days (comma separated)",
      "default": "السبت,الأحد,الاثنين,الثلاثاء,الأربعاء,الخميس,الجمعة"
    }
  ],
  "presets": [
    {
      "name": "Daily Deals"
    }
  ]
}
{% endschema %}

<section class="daily-deals lang-{{ request.locale.iso_code }}">
  <div class="container">
    <div class="daily-deals-wrapper">
      <div class="title-wrapper">
        {% if request.locale.iso_code == 'ar' %}
          <h3>{{ section.settings.title_ar }}</h3>
          <div class="line"><span class="mini-line"></span></div>
          <div class="small-text">
            <p>{{ section.settings.sub_title_ar }}</p>
          </div>
        {% else %}
          <h3>{{ section.settings.title_en }}</h3>
          <div class="line"><span class="mini-line"></span></div>
          <div class="small-text">
            <p>{{ section.settings.sub_title_en }}</p>
          </div>
        {% endif %}
      </div>

      {% if request.locale.iso_code == 'ar' %}
        {% assign button_text = section.settings.todays_deals_ar %}
      {% else %}
        {% assign button_text = section.settings.todays_deals_en %}
      {% endif %}

      {% if request.locale.iso_code == 'ar' %}
        {% assign deal_ended_text = section.settings.deal_has_ended_ar %}
      {% else %}
        {% assign deal_ended_text = section.settings.deal_has_ended_en %}
      {% endif %}

      {% if request.locale.iso_code == 'ar' %}
        {% assign day_string_lang = section.settings.days_ar %}
      {% else %}
        {% assign day_string_lang = section.settings.days_en %}
      {% endif %}

      {% if request.locale.iso_code == 'ar' %}
        {% assign deal_ended_in = section.settings.deal_ended_in_ar %}
      {% else %}
        {% assign deal_ended_in = section.settings.deal_ended_in_en %}
      {% endif %}

      {%- assign day_collections = 'saturday_collection,sunday_collection,monday_collection,tuesday_collection,wednesday_collection,thursday_collection,friday_collection'
        | split: ','
      -%}

      {%- capture day_string -%}
        {{ 'daily_deals.Sat' | t }},
        {{ 'daily_deals.Sun' | t }},
        {{ 'daily_deals.Mon' | t }},
        {{ 'daily_deals.Tue' | t }},
        {{ 'daily_deals.Wed' | t }},
        {{ 'daily_deals.Thu' | t }},
        {{ 'daily_deals.Fri' | t }}
      {%- endcapture -%}

      {%- assign days = day_string | strip | replace: ' ,', ',' | replace: ', ', ',' | split: ',' -%}
      {%- assign dayslang = day_string_lang | strip | replace: ' ,', ',' | replace: ', ', ',' | split: ',' -%}

      {%- assign shopify_day_index = 'now' | date: '%w' | plus: 0 -%}
      {%- case shopify_day_index -%}
        {%- when 6 -%}
          {%- assign today_index = 0 -%}
        {%- when 0 -%}
          {%- assign today_index = 1 -%}
        {%- when 1 -%}
          {%- assign today_index = 2 -%}
        {%- when 2 -%}
          {%- assign today_index = 3 -%}
        {%- when 3 -%}
          {%- assign today_index = 4 -%}
        {%- when 4 -%}
          {%- assign today_index = 5 -%}
        {%- when 5 -%}
          {%- assign today_index = 6 -%}
      {%- endcase -%}
     <div class="dealWrappers">
      <div class="deal-days">
        {% for day in dayslang %}
          {% assign day_index = forloop.index0 %}
          {% assign image_url = '' %}
          {% if day_index == today_index %}
            {% assign image_url = 'https://cdn.shopify.com/s/files/1/0414/0715/2281/files/Live_UnLocked-Photoroom.png?v=1759979817' %}
          {% elsif day_index < today_index %}
            {% assign image_url = 'https://cdn.shopify.com/s/files/1/0414/0715/2281/files/UnLocked-Photoroom.png?v=1759979818' %}
          {% else %}
            {% assign image_url = 'https://cdn.shopify.com/s/files/1/0414/0715/2281/files/Locked-Photoroom.png?v=1759979819' %}
          {% endif %}

          <div
            class="deal-day {% if day_index == today_index %}active current {% elsif day_index < today_index %}unlocked{% else %}locked{% endif %}"
            data-day-handle="{{ day_collections[day_index] | replace: '_collection', '' }}"
            data-day-translated="{{ day | strip | downcase }}"
          >
            <div class="lock-icon">
              <img src="{{ image_url }}" alt="{{ day }}" class="deal-day-icon">
            </div>
            <div class="day-text">
              <span class="day-label">{{ day | strip }}</span>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="deal-timer">
        <span id="deal-countdown">{{ deal_ended_in | strip }} : <span id="deal-countdown_time"></span></span>
      </div>
    </div>
      <div id="all-deals">
        {% for day_name in day_collections %}
          {% assign col = collections[section.settings[day_name]] %}
          {% unless col == blank %}
            <div class="product-slider-banner-content">
              <div
                class="deal-products ps-list owl-carousel lang-{{ request.locale.iso_code }}"
                data-owl-items="5"
                {% comment %} data-owl-responsive='{"0":{"items":1},{"375":{"items":2},"768":{"items":3},"1024":{"items":5}}' {% endcomment %}
                data-day="{{ day_name | replace: '_collection', '' }}"
                style="display:none;"
              >
                {% for product in col.products limit: 8 %}
                  <div class="deal-product product-wrapper">
                    {% include 'product-item' %}
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

