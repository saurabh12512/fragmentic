<script>
  document.addEventListener('DOMContentLoaded', function () {
    // === Countdown ===
    function updateCountdown() {
      const now = new Date();
      const end = new Date();
      end.setHours(24, 0, 0, 0);
      const diff = end - now;
      if (diff > 0) {
        const h = Math.floor(diff / (1000 * 60 * 60));
        const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((diff % (1000 * 60)) / 1000);
        document.getElementById('deal-countdown_time').innerText = `${h}h ${m}m ${s}s`;
      }
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    var buttonText = {{ button_text | json }};
    // === Language & Day Mapping ===
    const dayMap = {};
    document.querySelectorAll('.deal-day').forEach((d) => {
      dayMap[d.dataset.dayTranslated] = d.dataset.dayHandle;
    });

    const today = new Date();
    const englishDays = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
    const todayEnglish = englishDays[today.getDay()];

    // Show today's deals
    document.querySelectorAll('.deal-products').forEach((div) => {
      div.style.display = div.dataset.day === todayEnglish ? 'grid' : 'none';
    });

    // === Click logic ===
    const dealDays = document.querySelectorAll('.deal-day');
    const allProducts = document.querySelectorAll('.deal-product');

    dealDays.forEach((day) => {
      day.addEventListener('click', function () {
        if (day.classList.contains('locked')) return;

        // Get English handle via translated label
        const translatedLabel = day.dataset.dayTranslated;
        const targetEnglish = dayMap[translatedLabel];

        // Toggle active state
        document.querySelectorAll('.deal-day').forEach((d) => d.classList.remove('current'));
        day.classList.add('current');

        // Show correct products
        document.querySelectorAll('.deal-products').forEach((div) => {
          div.style.display = div.dataset.day === targetEnglish ? 'grid' : 'none';
        });

        // Overlay handling for unlocked days
        if (day.classList.contains('unlocked')) {
          allProducts.forEach((p) => {
            p.classList.add('overlay-product');
            if (!p.querySelector('.check-today-real-btn')) {
              const btn = document.createElement('button');
              btn.className = 'check-today-real-btn';
              btn.textContent = buttonText;
              const img = document.createElement('img');
              img.src =
                'https://cdn.shopify.com/s/files/1/0414/0715/2281/files/lock-cross-svgrepo-com_2.png?v=1761586875';
              img.className = 'check-today-deal-img';
              p.appendChild(btn);
              p.appendChild(img);
            }
          });
        } else {
          allProducts.forEach((p) => {
            p.classList.remove('overlay-product');
            const btn = p.querySelector('.check-today-real-btn');
            const img = p.querySelector('.check-today-deal-img');
            if (btn) btn.remove();
            if (img) img.remove();
          });
        }
      });
    });

    // Remove overlay on "Check Today Deal"
    document.body.addEventListener('click', function (e) {
      if (e.target.classList.contains('check-today-real-btn')) {
        e.preventDefault();
        document.querySelectorAll('.deal-products').forEach((div) => {
          div.style.display = div.dataset.day === todayEnglish ? 'grid' : 'none';
          setTimeout(() => {
            document.querySelectorAll('.deal-product').forEach((p) => {
              p.classList.remove('overlay-product');
              const btn = p.querySelector('.check-today-real-btn');
              if (btn) btn.remove();
              document.querySelectorAll('.deal-day').forEach((d) => d.classList.remove('current'));
              document.querySelectorAll('.deal-day.active').forEach((d) => d.classList.add('current'));
            });
          }, 400);
        });
      }
    });
  });
</script>
