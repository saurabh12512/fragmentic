{% schema %}
{
  "name": "Bubble Section",
  "settings": [],
  "blocks": [
    {
      "type": "bubble",
      "name": "Bubble",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "text_ar",
          "label": "Text (Arabic)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Bubble Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<!-- Swiper CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />

{% if section.blocks.size > 0 %}
<div class="container bubble-section-wrapper" {% if request.locale.iso_code == 'ar' %}dir="rtl"{% endif %}>
  <div class="swiper bubble-swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% assign image = block.settings.image %}
        {% assign text = block.settings.text %}
        {% assign text_ar = block.settings.text_ar %}
        {% assign link = block.settings.link %}
        <div class="swiper-slide">
          <a href="{{ link | default: '#' }}" class="banner-card">
            <div class="banner-image">
              {% if image %}
                <img src="{{ image | image_url: width: 150 }}" alt="{{ text | escape }}" width="150" height="150" loading="lazy">
              {% endif %}
            </div>
            <p class="banner-text">
              {% if request.locale.iso_code == 'ar' and text_ar != blank %}
                {{ text_ar }}
              {% else %}
                {{ text }}
              {% endif %}
            </p>
          </a>
        </div>
      {% endfor %}
    </div>

    <!-- Arrows -->
  <div class="swiper-button-prev">
  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="15 18 9 12 15 6" />
  </svg>
</div>
<div class="swiper-button-next">
  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="9 18 15 12 9 6" />
  </svg>
</div>
  </div>
</div>
{% endif %}

<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.bubble-swiper', {
      slidesPerView: 6,
      spaceBetween: 0,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      speed: 300,
      grabCursor: true,
      threshold: 1, // light touch starts move
      cssMode: false,
      centeredSlides: false,
      rtl: document.documentElement.getAttribute('dir') === 'rtl',

       breakpoints: {
        0: {
          slidesPerView: 2.5,
          spaceBetween: 0,
        },
         375: {
          slidesPerView: 3.5,
          spaceBetween: 0,
        },
        640: {
          slidesPerView: 4,
        },
        1024: {
          slidesPerView: 6,
        },
      }
    });
  });
</script>

<style>
  .bubble-swiper {
    padding: 10px 0;
  }

  .swiper-slide {
    text-align: center;
    width: auto;
  }

  .banner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
  }

  .banner-image {
    width: 150px;
    height: 150px;
   
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: clip;
  }

  .banner-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
    will-change: transform;
  }

  .banner-card:hover .banner-image img {
    transform: scale(1.05);
  }

  .banner-text {
    margin-top: 8px;
    font-size: 14px;
    color: #333;
    font-weight: 700;
    max-width: 100px;
    text-align: center;
  }

  [dir="rtl"] .banner-text {
    text-align: right;
  }

  .bubble-section-wrapper .swiper-button-next,
  .bubble-section-wrapper .swiper-button-prev {
    background: #fafafa;
    width: 35px;
    height: 35px;
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
    color: #505255;
  }

  .bubble-section-wrapper .swiper-button-next::after,
 .bubble-section-wrapper .swiper-button-prev::after {
    font-size: 16px;
    font-weight: 700;
  }

  .swiper-button-next:after, .swiper-button-prev:after {
     display:none;
}
  .swiper-button-disabled {
    opacity: 0 !important;
}
  @media only screen and (max-width: 767px) {
    .banner-image {
      width: 100px;
      height: 100px;
    
    }
     .banner-text {
      padding-left:5px;
      padding-right:5px;
    font-size: 12px;
   
}
  }
</style>
