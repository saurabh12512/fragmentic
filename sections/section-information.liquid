<div id="home-info-{{ section.id }}" class="home-infor-section">
  <div class="row">
    
    <div class="block-left col-md-6 col-sm-12 col-xs-12" style="background-color: {{ section.settings.bg_color }}">
      <div class="block-left-inner">

        {%- assign title = section.settings.title -%}
        {%- assign subtitle = section.settings.subtitle -%}

        {% unless title == blank %}
          <div class="title-wrapper">
            <h3>{{ title }}</h3>
            <span class="mini-line"></span>
            {% unless subtitle == blank %}<span>{{ subtitle }}</span>{% endunless %}
          </div>
        {% endunless %}
        
        <div class="block-left-content">
          
          <div class="content-wrapper">
            <div class="content">
              
              <img class="lazyload" data-src = "{{ section.settings.b_image_1 | img_url: '30x' }}" alt="" />
              <div class="title">{{ section.settings.b_title_1 }}</div>
              <div class="caption">{{ section.settings.b_content_1 }}</div>
              
            </div>
          </div>
          
          <div class="content-wrapper">
            <div class="content">
              
              <img class="lazyload" data-src = "{{ section.settings.b_image_2 | img_url: '30x' }}" alt="" />
              <div class="title">{{ section.settings.b_title_2 }}</div>
              <div class="caption">{{ section.settings.b_content_2 }}</div>
              
            </div>
          </div>
          
          <div class="content-wrapper">
            <div class="content">
              
              <img src = "{{ section.settings.b_image_3 | img_url: '30x' }}" alt="" />
              <div class="title">{{ section.settings.b_title_3 }}</div>
              <div class="caption">{{ section.settings.b_content_3 }}</div>
              
            </div>
          </div>
          
          <div class="content-wrapper">
            <div class="content">
              
              <img class="lazyload" data-src = "{{ section.settings.b_image_4 | img_url: '30x' }}" alt="" />
              <div class="title">{{ section.settings.b_title_4 }}</div>
              <div class="caption">{{ section.settings.b_content_4 }}</div>
              
            </div>
          </div>
          
        </div>

      </div>
    </div>
    
    <div class="block-right col-md-6 col-sm-12 col-xs-12" style="background-image:url({{ section.settings.deal_banner | img_url: '960x' }});">
      <div class="block-right-inner">
      
        <div class="text_1">{{ section.settings.text_1 }}</div>
        <div class="text_2">{{ section.settings.text_2 }}</div>
        
        {%- assign expire = section.settings.expire_offer  -%}
        
        {% unless expire == blank %}
          {%- assign dueDate = expire | split: '-' -%}

          <div class="wrapper-countdown">
            <div class="countdown_{{ section.id }}"></div>
          </div>

          <script type="text/javascript">

            jQuery(document).ready(function($){

              var currentDate = new Date();
              var dueDate = new Date( {{ dueDate[2] }}, {{ dueDate[0] | plus:0 }} - 1, {{ dueDate[1] | plus:0 }} );
              if(currentDate < dueDate){
                $('.countdown_{{ section.id }}').countdown({until: dueDate, format: 'DHMS'});
              }
              else{
                $('.countdown_{{ section.id }}').parent().hide();
              }
            });

          </script>
        
        {% endunless %}
        
       <a href="{{ section.settings.link }}">{{ section.settings.button }}</a>
        
      </div>
    </div>
    
  </div>
</div>

