{% if section.blocks.size > 0 %}
  {%- assign number = section.settings.number -%}

  <div class="partner-wrapper">
    {%- unless request.design_mode -%}
      <template class="">
    {%- endunless -%}
    <div class="container">
      <div class="widget-partner widget-partner-{{ section.id }} owl-carousel">
        {% for block in section.blocks %}
          <div class="partner-item">
            <a href="{{ block.settings.link }}">
              {% render 'image', image: block.settings.image, limit: 160 %}
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
    <script>
      jQuery(document).ready(function ($) {
        setTimeout(function () {
          jQuery('.widget-partner-{{ section.id }}').length &&
            jQuery('.widget-partner-{{ section.id }}').owlCarousel({
              nav: true,
              dots: false,
              loop: true,
              autoplay: true,
              margin: 30,
              rtl: arnTheme.rtl,
              responsive: {
                0: { items: 1, margin: 0 },
                768: { items: 3 },
                991: { items: 5 },
                1024: { items: 6 },
                1200: { items: +'{{ number }}' },
              },
              navText: ['<span class="button-prev"></span>', '<span class="button-next"></span>'],
            });
        }, 1200);
      });
    </script>
    {%- unless request.design_mode -%}
      </template>
    {%- endunless -%}
  </div>
{% endif %}

{% schema %}
{
  "name": "Partner",
  "max_blocks": 10,
  "settings": [
    {
      "type": "select",
      "id": "number",
      "label": "Number of items per row",
      "options": [
        { "value": "4", "label": "4 items" },
        { "value": "5", "label": "5 items" },
        { "value": "6", "label": "6 items" }
      ],
      "default": "6"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Our size is 160x80 px"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Partner",
      "category": "Banner",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
