body {
 direction: ltr;
}
body * {
 direction: rtl;
}
.templateIndex[dir="rtl"] .swiper-button-prev {
  left: auto;
  transform: rotate(180deg);
  background-image: none;
}
.templateIndex[dir="rtl"] .swiper-button-next {
  right: auto;
  transform: rotate(180deg);
  background-image: none;
}
.daily-deals .owl-nav {
    right: unset !important;
    left: 0;
}
.service-bar-wrapper {
    height: 37px;
}
