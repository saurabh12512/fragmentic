      	padding-top: 15px;
      }
	  .share-label {
		display: inline-block;
		font-size: $font-medium;      
		color: $body-title-color;
		font-weight: 700;		
		text-transform: uppercase; 
		line-height: 45px;
		padding: 0 10px 0 0;		
	  }  
	  .list-inline {
	    display: inline-block;
	  }
