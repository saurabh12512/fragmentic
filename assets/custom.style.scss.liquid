/* Popup newsletter ------------------------------*/
.fancybox-skin {
  padding: 0px !important;  
  color: $body-general-color;
  @include border-radius-reset;
  .fancybox-close {       
    @include border-radius-circle;    
    @include box-shadow(0 0px 0px rgba($black, 0.5));
    @include ab(-15px, n, n, -15px);          
    width: 35px;
    height: 35px;
    cursor: pointer;
    display: block;
    cursor: pointer;
    background-color: $main-color;
    background-image: none;
    text-align: center;
    &:before {
      content: "\f00d";
      font-family: FontAwesome;
      color: $white;
      width: 100%;      
      line-height: 35px;
    }   
  }
  #mailchimp-popup {
    background-color: $body-background-color;
	background-image: url(//www.fragmantic.com/cdn/shop/t/28/assets/mailchip_popup_bg.jpg?v=148828066190076221741690777230);
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
    overflow: hidden;
    position: relative;    
    height: 100%;
    @media (max-width: 767px) {
      min-height: 300px;
    }
  }
  .mailchimp-popup-img {       
    width: 100%;
    display: none;
    img {
      width: 100%;
    }
  }
  .mailchimp-popup-content {    
    padding: 70px 280px 70px 70px;     
    color: $body-title-color;    
    vertical-align: middle;    
    margin: 0;            
    width: 100%;
    height: 100%;
