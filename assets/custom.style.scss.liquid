    white-space: nowrap;
    overflow-y: hidden;
    overflow-x: auto;
    li {
      float: none;
      display: inline-block;
      position: relative;
      border: none;
      &:before {
        content: '';
        width: 1px;
        height: 22px;
        background: $border-light-color;
        @include ab(0, -3px, n, n);
        @include rotate(45);        
      }
      a {
        @include border-radius-reset;
        text-transform: uppercase;
        font-size: $font-small;
        font-family: $font-heading;
        font-weight: 700;
        color: $body-light-color;
        margin: 0;
        line-height: 22px;
        padding: 0 22px;
        border: none;
        &:hover {
          border: none;
          background: none;        
        }
        &:focus {
          border: none;
          background: none;          
          color: $main-color;
        }
        @media (min-width: 1025px) {
          &:hover {            
            color: $main-color;
          }
        }
      }      
      &.active {
        a {
          border: none;
          background: none;
          color: $main-color;
          &:focus {
            border: none;
            background: none;
            color: $main-color;
          }
          @media (min-width: 1025px) {
            &:hover {
              border: none;
              background: none;
              color: $main-color;
            }
          }
        }
      }
      &:first-child {
        &:before {
          content: none;
        }
      } 
    }
  }
