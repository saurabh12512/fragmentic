    			margin-right: 5%;
    		}
    	}
      @media (max-width: 767px) {
        margin-bottom: 0;
      }
    }
    #stock {      
      clear: both;
      font-size: 12px;
      color: $body-title-color;
      text-transform: uppercase;             
      line-height: 16px;
      margin: 10px 0 15px;
      > span {
        display: block;
        text-align: center;                
        font-weight: 700;
        color: $body-title-color;
        font-size: $font-medium;
      }
      .fa {
      	margin-right: 8px;
      }
    }
    .product-code {      
      color: $body-title-color;
      text-transform: uppercase;      
      margin: 10px 0 5px;
      overflow: hidden;
      line-height: 28px;
      span {
      	&:first-child {
      	  float: left; 
          margin: 0;          
          /*width: 110px;
          font-size: 14px;
          text-transform: uppercase;        */  
          font-weight: 700;
          color: $body-title-color;
      	}
      }
    }
    .group-price-sale {
    	overflow: hidden;
    	margin: 0 0 15px;
    	padding: 0 0 15px;
    	border-bottom: 1px solid #f0f0ed;    
    }
    .sale-detail {
    	float: left;
    	border: 2px solid $body-label-sale-background;
    	color: $body-label-sale-background;
    	text-transform: uppercase;
    	font-size: $body-font-size;
    	padding: 0px 20px;
    	line-height: 26px;
    	@media (max-width: 479px) {
    		padding: 0 10px;
    	}
    }
    .product-price {        
      text-align: left;     
      border: none;   
      line-height: 30px;   
      float: left;             
      padding: 0;
      margin: 0 40px 0 0;
      @media (max-width: 479px) {
      	margin-right: 20px;
      }
      .price-sale {              
        line-height: 30px;       
        display: inline-block;    
        font-size: $size-h3;
        float: left;
      }
      .price {                    
        text-align: left;
        padding: 0;
        border: none;      
        overflow: hidden;                         
        margin: 0;
        float: left;
        font-size: $size-h3;
      }
      .price-compare { 
        margin-right: 10px; 
        line-height: 30px;        
        display: inline-block;                   
        font-size: $size-h6;
        float: left;
      }
