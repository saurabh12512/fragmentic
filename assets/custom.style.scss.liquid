            }
          }
        }
        &:hover {
          @media (min-width: 1025px) {
            .currencies {
              display: block;
            }
          }
        }
      }      
    }
  }
  .header-logo {   
    display: block;  
    margin: 0 auto; 
    text-align: center;
    @media (max-width: 767px){
     	width: 40%;
     	position: relative;
     	z-index: 2;   
      padding: 0;  	
    }
    .logo-text {
      display: table !important;
      font-weight: 700;
      font-family: $font-heading;
      word-break: break-word;
      text-align: center;
