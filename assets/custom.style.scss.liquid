  	min-height: 186px;
  }
  .header-menu-wrapper {  	
  	position: relative;
  }  
  .list-customer-left {
  	float: left;  	
  	list-style: none;
  	> li {
  	  float: left;
  	  padding: 5px 15px;
  	  position: relative;
  	  > a {
  	  	padding: 0;
  	  	line-height: 20px;
  	  	font-size: $top-font-size;
        color: $nav-link-color;
  	  	.number {
  	  	  position: relative;
  	  	  &:before {
  	  	  	content: '(';
  	  	  }
  	  	  &:after {
  	  	  	content: ')';
  	  	  }
  	  	}
        &:hover {
          color: $nav-link-hover-color;
        }
  	  }
  	  &:after {
  	  	content: '';
  	  	width: 1px;
  	  	height: 12px;
  	  	background: $nav-link-color;
  	  	@include ab(9px, n, n, 0);
  	  }
      &:first-child {
        padding-left: 0;
      }
  	  &:last-child {
  	  	&:after {
  	  	  content: none;
  	  	}
  	  }
  	}
  }
  .list-customer-right {
  	float: right;
  	list-style: none;
  	> li {
  	  float: left;
  	  padding: 5px 15px;
  	  position: relative;
  	  > a {
  	  	padding: 0;
  	  	line-height: 20px;
  	  	font-size: $top-font-size;
        color: $nav-link-color;
        &:hover {
          color: $nav-link-hover-color;
        }
        .fa {
          margin-left: 3px;
        }
  	  }
  	  &:after {
  	  	content: '';
  	  	width: 1px;
  	  	height: 12px;
  	  	background: $nav-link-color;
  	  	@include ab(9px, n, n, 0);
  	  }
  	  &:last-child {
  	  	padding-right: 0;
  	  	&:after {
  	  	  content: none;
  	  	}
  	  }
  	}
  }
  .header-main { 
    position: relative; 
    clear: both;      
    padding: 20px 0 0;
    .table-row {  
      @media (min-width: 992px) {
        position: relative;  
        text-align: center;
        .searchbox {
          float: left;
          text-align: left;
          margin: 20px 0 0;
        }
        .header-logo {
          display: inline-block;
          margin: 0px auto;
        }
        .top-cart-holder {
          margin: 15px 0 0;
          float: right;
          text-align: left;
        }
      }
    }
  }    
  .searchbox {
    margin: 0;    
    display: inline-block;    
    > a {
      display: block;
      width: 100%;
      text-align: center;
      position: relative;
      z-index: 991;
      .fa {
        &:before {
          font-size: $size-h6;
        }
      }
    }   
    .dropdown-menu {          
      left: auto;
      right: 0;            
      width: 300px;  
      display: block;  
      visibility: hidden;
      z-index: -99;
      @include translate(0%, 10px);  
      @include opacity(0);
      @include  transition(all 0.35s ease);    
      @media (max-width: 400px) {
        width: 280px;
        right: -60px;
      }       
    }
    &:hover {
      @media (min-width: 1025px) {
        .dropdown-menu {              
          visibility: visible;
          z-index: 99;          
          @include opacity(1);  
          @include translate(0%, 0px);
          &:before {
            content: '';
            height: 30px;
            width: 100%;
            @include ab(-20px, 0, n, n);
          }
        }
      }
    }
    &.open {
      .dropdown-menu {  
        visibility: visible;
        z-index: 99;          
        @include opacity(1);  
        @include translate(0%, 0px);  
      }
    }
    .search-icon {
      @include ab(0px, n, n, 0);  
      z-index: 3;
      width: 38px;
      height: 38px;
      padding: 0;
      margin: 0;
      border: none;    
      background: none;
      text-align: center;     
      &:before {
      	content: "\f002";
      	font-size: 14px;
      	color: $nav-link-color;
      	display: block;     
      	font-family: FontAwesome; 	
      }
      &:hover {
      	&:before {
      	  color: $nav-link-hover-color;
      	}
      }
    }
    .navbar-form {        
      margin: 0;  
      padding: 0;          
      display: block;
      height: 40px;
      border: 1px solid rgba($nav-link-color, 0.2);
      background: transparent;
      position: relative;
      @include box-shadow(0 0 0 $white);     
      width: 210px;   
    }
    .form-control {     
      width: 100%;     
      height: 38px;
      padding: 9px 40px 9px 10px;          
      border: none;
      line-height: 18px;       
      float: left;             
      text-transform: none;     
      color: $nav-link-color;
      @include box-shadow(inset 0 0 0 #fff);         
      &:hover,
      &:focus {
        @include box-shadow(0 0 0 #fff);    
        background: none;    
      }
    }
    #result-ajax-search {
      text-align: left;
      position: absolute;
      top: 100%;      
      width: 100%;    
      max-width: 350px;  
      padding: 0px; 
      margin: 15px 0 0;       
      display: none;
      z-index: 12;  
      border: none;
      background: $body-background-color;
      @include box-shadow(0 0px 18px rgba($black, 0.21));  

      &:before,
      &:after {
        content: "";
        display: inline-block;
        height: 0;
        width: 0;
        @include ab(-10px, 20px, n, n);           
      }
      &:after {
        border-bottom: 9px solid #ffffff;
        border-left: 8px solid rgba(0, 0, 0, 0);
        border-right: 8px solid rgba(0, 0, 0, 0);
        right: 82px;
        top: -9px;
      }
      &:before {
        border-bottom: 10px solid $body-border-color;
        border-left: 10px solid rgba(0, 0, 0, 0);
        border-right: 10px solid rgba(0, 0, 0, 0);
      }
      ul {
        margin: 0;
        padding: 15px 0;
        max-height: 580px;
        overflow: auto ; 
        background: $white;   
        width: 100%;
        li {
          display: block;
          overflow: hidden;
          padding: 13px 15px;
          .search-item-img {            
            margin:0;            
            width: 100px;           
            text-align: center;
            img {              
              margin-right: 15px;
            }
          }
          .search-item-title {
            display: block;                       
            font-weight: 400;
            font-size: 16px;
            line-height: 1.0;
            margin: 0 0 5px;
            .marked {
              color: $main-color;
            }
            &:hover {

            }
          }
          .product-price, .price {
            font-size: 18px;
            font-weight: 700;
            color: $body-price-color;
          }      
          .price-compare {
            font-size: 17px;            
            color: $body-price-sold-out-color;
          }    
          .price-sale {
            font-size: 18px;
            font-weight: 700;
            color: $body-price-sale-color;
          }
          p {
            margin: 0;                            
          }
          &:hover {

          }
        }
      }
    }
    &.s-loading {
      .navbar-form {
        @media (min-width: 1025px) {
          &:before {
            width: 25px;
            height: 25px;
            @include ab(7px, n, n, 7px);
            z-index: 5;          
            font-size: 22px; 
            vertical-align: middle; 
            line-height: 25px; 
            display: block;
            font-family: FontAwesome;
            content: "\f110"; 
            -webkit-animation: fa-spin 2s infinite linear;
            animation: fa-spin 2s infinite linear;
            color: $main-color;
            background: $header-bg;
          }
        }        
      }
    }
  }
  .header-text-widget {
    display: inline-block;
    padding-right: 85px;
    .widget-description {
      padding: 0 45px;
      text-align: left;
      .fa {
        font-size: 36px;
        color: $main-color;
        float: left;
        padding: 0 20px 0 0;
        line-height: 36px;
      }
      span {
        color: $body-light-color;
        font-size: 15px;
        display: inline-block;
        font-family: $font-heading;
        font-weight: 400;
        line-height: 14px;
        &.text-2 {
          display: block;
          font-weight: 300;
          white-space: nowrap;
          font-size: 14px;
          color: $body-light-color;
        }
      }     
    }
  }
  .header-other {
    margin: 0;
    text-align: right;
  }
  .header-nav{
    > .container{
      position: relative;
    }     
  }
  .top-cart-holder {      
    > .cart-target  {          
      background: $bg-header-cart;
      height: 100%;
      width: 100%;
      position: relative;
      > .basket {
        display: block;               
        position: relative;
        overflow: hidden;        
        padding: 10px 20px 10px 50px;
        color: $nav-link-color;
        border: 1px solid rgba($nav-link-color, 0.2);
        @media (max-width: 767px){
          padding: 10px;
        }
        .text {
          text-transform: uppercase;
          font-weight: 700;
          font-size: $body-font-size;
          font-family: $font-heading;          
          line-height: 1.1;
          display: block;
          padding: 3px 0 0;
          @media (max-width: 767px) {
            display: none;
          }
        }
        .flaticon-shop.small {
          float: left;
          @include ab(10px, 15px, n, n);
          @media (max-width: 767px) {
          	display: none;
          }
          &:before {
            margin: 0px;
            font-size: 25px;
          }
        }
        .flaticon-shop.big {
          @include ab(n, n, -22px, -10px);
          &:before {
            font-size: 45px;
            margin: 0;
            color: rgba($main-color, 0.4);
          }
        }
        .number {
          display: inline-block;  
          font-size: 12px;
          text-transform: uppercase;
          @media (max-width: 767px) {
            font-size: 0;
            position: relative;
            > span {
              display: block;
              font-size: 12px;
            }
          }
        }
        .n-item {
          display: inline-block;            
        } 
        &:hover {          
	      	@media (min-width: 1025px) {
	      	  color: $nav-link-hover-color;
	      	}
	      }       
      }      
      &.open {
        .cart-dd {
          visibility: visible;
          z-index: 9999;
          @include opacity(1);
          @include translate(0, 0);
        }
      }      
    }   
    &:hover {
      @media (min-width: 1025px) {
        .cart-dd {
          visibility: visible;
          z-index: 9999;
          @include opacity(1);
          @include translate(0, 0);
        }
      }
    }
  }  
  .header-menu-top {
    position: relative;
    padding: 6px 0px 0 0;
    li {      
      &.currency-block {
        position: relative;       
        .currencies {
          min-width: 100px;
          width: 100%;
          padding: 5px 0;                    
          a {
            font-size: 14px;
            padding: 4px 15px;
            &:hover {
