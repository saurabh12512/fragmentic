    @include translate(0%, -50%);

    .title {
      color: $body-title-color;
      font-weight: 700;
      font-family: $font-heading;            
      font-size: $size-h2;
      line-height: 1.0;
      margin: 0 0 5px;        
      text-transform: uppercase;   
      letter-spacing: 2px;
    }
    .mailchimp-caption-1 {      
      margin: 0 0 30px;
      font-size: $size-h5;      
      color: $body-general-color;
      line-height: 1.5;
      font-weight: 700;      
      span > span {
        color: $main-color;
      }         
    }   
    #mc-form {
      margin: 0;
      padding: 0;
      border: none;
      position: relative;      
      clear: both;      
      max-width: 420px;
      #mc-email {                
        width: 100%;        
        margin-left: 0px;              
        background: none;
        padding-right: 50px;
        background: $white;
        &:focus {
          @include box-shadow(0 0 0 #fff);
          background: $white;          
        }
      }
      .btn {                                
        text-align: center; 
        @include ab(0, n, n, 0);
        background: none;
        padding: 0;
        border: none;
        font-size: 0;
        height: 45px;
        width: 50px;
        &:before {
          content: "\f1d8";
          font-family: FontAwesome;
          color: $main-color;
          font-size: $size-h5;
          width: 100%;
          text-align: center;
          line-height: 45px;
          display: block;
        }
      } 
      .fa {
        display: none;
      }     
    }    
  }
  .widget-social {
  	@include ab(n, 0, 0, 0);
  	@include transparent($main-color, 0.6);
  	text-align: center;
  	padding: 20px;
  	z-index: 2;
  	h5 {
  	  font-size: 16px;
  	  color: $white;
  	  margin-bottom: 10px;
  	}
  	.widget-social-icons {
  	  padding: 0 0 5px;
  	  li {
  	  	display: inline-block;
  	  	a {
  	      display: block;
  	      width: 35px;
  	      height: 35px;
  	      border: 1px solid $white;
  	      line-height: 33px;
  	      color: $white;
  	      font-size: $size-h6;
  	      margin: 0 0 5px;
  	      > span {
  	      	display: none;
  	      }
  	  	}
  	  }
  	}
  }
}

/* Back to top ---------------------------------*/
#scroll-to-top {
  @include transition(all 0.2s ease-out 0s); 
  -moz-backface-visibility: hidden;
  opacity: 0;
  filter: alpha(opacity=0);
  position: fixed;
  /*right: -50px;*/
  bottom: 10px;
  z-index: 1000;
  display: block;
  cursor: pointer;
  text-align: center;
  &.on {
    bottom: 10%;
    opacity: 1;
    right: 30px;
    filter: alpha(opacity=100); 
  }
  i {   
    display: none;    
  }
  a {
    position: relative;
    width: 45px;
    height: 45px;
    line-height: 45px;    
    display: block;
    border: none;
    @include transparent($main-color, 0.5);
    @include transition(all 0.3s ease-in-out 0s);    
    &:before {
      content: "\f106";
      font-size: 28px;
      padding: 0;
      width: 45px;
      height: 45px;
      line-height: 45px;
      text-align: center;  
      color: $white;
      font-family: Fontawesome;
      display: block;      
      @include transition(all 0.3s ease-in-out 0s);
    }
  }

  &:hover{
    a {
      @include transparent($main-color, 1);
      &:before {        
        color: $white;
      }
    }
  }
}

/*menu on PC---------------------------------*/
.horizontal-menu {      
  background: none;  
  position: relative;
  text-align: center;    
  clear: both;
  margin: 20px auto 0;
  .navigation .navbar .navbar-collapse {
    .main-nav { 
      width: 100%;     
      > li {
        &.dropdown {  
          > .dropdown-menu {
          	display: block !important;  
          	top: 100%;
            left: 0px !important;    
          	visibility: hidden;
          	z-index: -99;
          	@include translate(0%, 10px);  
            @include opacity(0);
          	@include transition(all 0.35s ease-in-out 0s);
          }
          &:hover,                    
          &.hover {
            > a { 
              position: relative;                         
            }
            > .dropdown-menu {              
              background: $nav-dropdown-background;                         
              visibility: visible;
          	  z-index: 99;          
              @include opacity(1);  
              @include translate(0%, 0px);        		          		
            }
          }
          &.mega-menu {
            position: static;            
            > .dropdown-menu {                    
              left: 50% !important;                                  
              @include translate(-50%, 10px);                              
              .dropdown-menu {
                font-size: $body-font-size;                 
              } 
              &.column-4 {
                width: 100%;
                @media (min-width: 768px) {			  
				  width: 730px;				
                }
                 @media (min-width: 992px) {			  
				  width: 950px;				
                }
                @media (min-width: 1200px) {				  
				  width: 1170px;				
                }
              }
              &.column-3 {
                width: 75%;  
                 @media (min-width: 768px) {			  
				  width: 730px;				
                }
                 @media (min-width: 992px) {			  
				  width: 705px;				
                }
                @media (min-width: 1200px) {				  
				  width: 870px;				
                }              
              }
              &.column-2 {
                width: 50%;
                 @media (min-width: 768px) {			  
				  width: 730px;				
                }
                 @media (min-width: 992px) {			  
				  width: 950px;				
                }
                @media (min-width: 1200px) {				  
				  width: 1170px;				
                }
              }
              &.column-1 {
                width: 25%;
                 @media (min-width: 768px) {			  
				  width: 730px;				
                }
                 @media (min-width: 992px) {			  
				  width: 950px;				
                }
                @media (min-width: 1200px) {				  
				  width: 1170px;				
                }
              }
            }
            &:hover,                    
            &.hover {
              > a { 
                position: relative;  
              }
              > .dropdown-menu {    
                @include translate(-50%, 0px);                
                /*max-height: 550px;
                overflow-y: auto; */
              }
            }
          }                  
        }
        > a {
          position: relative;          
        }
        &:hover/*,
        &.active */{          
          @include border-radius(0px, 0px, 0, 0);
          > a {
            color: $nav-link-hover-color;             
          }
          > span.expand {
            .fa {
              color: $nav-link-hover-color; 
            }
          }
        }
        &:last-child {

        }
      }
    }
  }
}
