.search-sb{
  .title{
    margin-bottom: 20px;
  }

  #header-search{
    display: block;
    width: 100%;

    .search_box{
      width: 100%;
      padding-right: 35px;
    }

    button.search-submit {
      border: 0;
      background: 0;
      color: $body-link-color;
      @include ab(0px,n,n,5px);
      font-size: 20px;
      width: 32px;
      height: 32px;

    }
