/* Page FAQS ----------------------------------*/
.s4com-helpcenter {
  padding: 0;
  h1 {
    text-align: center;    
    margin: 0px auto 30px;
  }
  .s4com-panel {    
    padding: 0px;
    border: none;
    input {
      border: 1px solid $body-border-color;      
      height: 50px;
      padding: 15px 30px;
    }
  }

  .s4com-top-heading {
    padding: 0;
    margin: 0 0 50px;
    font-size: $size-h3;
    border: none;    
    text-align: center;
    font-weight: 400;
    display: none;
  }
  .s4com-sub-heading {
    padding: 0 !important;
    margin: 0px 0 30px;    
    text-align: center;
    font-weight: 400;
    border: none;
    display: none;
  }
  .s4com-articles {        
    border: none;    
    padding: 0;
    margin: 0 0 30px;  
    > a {
      color: $body-title-color;     
      display: block;     
      font-weight: 500;             
      position: relative; 
      padding: 0; 
      font-size: 18px;          
      @include transition(all 0.35s ease 0s); 
      > h4 {
        display: block;
        padding: 20px 70px 20px 35px;
        font-size: 18px;    
        font-weight: 700 !important;   
        line-height: 30px;        
        color: $body-title-color;     
        background: $body-second-color;
        border: 1px solid $body-border-color;
        @media (max-width: 767px) {
          font-size: 16px;
          padding: 10px 40px 10px 15px;
          line-height: 20px;
        }
      }
      &:before {
        @include ab(0px, n, n, 0px);        
        @include transition(all 0.35s ease 0s);          
        left: auto;
        text-align: center;
        width: 70px;
        height: 70px;
        line-height: 70px;
        padding: 0;
        margin: 0;
        content: "\f106";
        font-family: FontAwesome;
        font-size: 35px;
        color: $body-title-color; 
        @media (max-width: 767px) {
          width: 40px;
          height: 40px;
          line-height: 40px;
          font-size: 25px;
        }
      }
      @media (min-width: 1025px) { 
        &:hover {
          color: $main-color; 
          h4 {
            color: $main-color; 
          }
          &:before {
            content: "\f106";            
          }
        }
      }
      &.s4com-active {
        color: $main-color; 
        h4 {
          color:$main-color; 
        }
        &:before {
          content: "\f107";     
          color: $main-color;    
        }
      }
      .s4com-icon-wrap {
        display: none;
        .s4com-icon-arrow-down {
          content: "\f107";
          font-family: FontAwesome;
          margin: 0;
        }
        .s4com-icon-arrow-right {
          content: "\f106";
          font-family: FontAwesome;
          margin: 0;
        }
      }
    }  
    .s4com-article-body {
      margin: 0px;
      padding: 35px;
      border: 1px solid $body-border-color;
      border-top: none;
      line-height: 1.6;
      @media (max-width: 767px) {
      	padding: 15px;
      }
    } 
  }
  .s4com-space-bottom {
    padding: 0;
    margin: 0 0 34px;
    border: none;
  }

}

