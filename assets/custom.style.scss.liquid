    .custom-filed {
      color: $main-color;
      margin: 0 0 10px;
    }
    .group-cw {
      position: relative;
      display: block;
      width: 100%;
      margin: 0;   
      clear: both;   
    }
    .swatch {      
      margin: 0px 0 10px;
      position: relative;
      /*padding: 0 0 0 110px;      */
      .tooltip {
      	@media (max-width: 767px) {
      		display: none;
      	}
      }
      .header {
        padding: 0 10px 0 0;
        display: block;     
        margin: 0;
        line-height: 35px;                                            
        color: $body-title-color;             
        font-weight: 700;           
        float: left;
        width: 110px;
        /*font-size: $font-medium;  
        text-transform: uppercase; 
        @include ab(0, 0, n, n);*/
      }
      .swatch-element {
        margin: 0; padding: 0;        
        float: left;
        label {
          position: relative;
          background: transparent;                 
          border: 1px solid $body-border-color;
          margin: 0px 10px 10px 0; 
          text-align: center;
          cursor: pointer;     
          min-width: 35px !important;
          height: 35px !important;
          padding: 5px;  
          line-height: 23px !important;
          color: $body-general-color;
          font-size: $body-font-size;
          @include border-radius-reset;
          @include box-shadow(0 0 0 1px #ffffff inset);
          @include transition(all 0.35s ease 0s);                    
        }
        input:checked + label{
          box-shadow: none;          
          cursor: default;
          border-color: $button-btn1-border;  
          color: $button-btn1-txt;
          background: $button-btn1;
          @include box-shadow(0 0 0 2px #ffffff inset);
        }       
        &:hover { 
          @media (min-width: 1025px) {
            label{
              border-color: $button-btn1-border;  
              color: $button-btn1-txt;
              background: $button-btn1;   
              @include box-shadow(0 0 0 2px #ffffff inset); 
            }
          }
        }
        &.soldout {
          label {
            cursor: default;
            background: transparent !important;
            color: #a39d94 !important;  
          } 
          &:hover {
            @media (min-width: 1025px) {
              label {
                cursor: default;
                background: transparent !important;
                color: #a39d94 !important;  
              }
            }
          }
        }               
      }
      &.size {        
        .swatch-element {
          label {
            @include box-shadow(0 0 0 0 $white);
          }
          input:checked + label {
            border-color: $button-btn1-border;  
            color: $button-btn1-txt;
            background: $button-btn1;   
            @include box-shadow(0 0 0 0 $white);
          }
          &:hover {
            @media (min-width: 1025px) {
              label {
                border-color: $button-btn1-border;  
                color: $button-btn1-txt;
                background: $button-btn1;   
                @include box-shadow(0 0 0 0 $white);
              }
            }            
          }
        }        
      }       
    }   
   
    .action-button {                 
      width: 100%;
      margin: 0 0 25px;
      /*max-width: 370px;*/
      .btn {
        min-width: 40px;
        line-height: 38px;
        padding: 10px 15px;
        /*font-family: $font-standard;*/
        font-size: $font-medium + 2px;
        font-weight: 700;
        height: 60px;
        width: 100%;
        .flaticon-commerce {
          &:before {
          	margin-right: 8px;
          	font-size: 14px;
          }
        }  
      } 
    }
    .product-action {    	
      .variants-wrapper {
        margin: 5px 0 0;
        clear: both;       
        .selector-wrapper {
          margin-bottom: 20px;
          clear: both;
          text-align: left;         
          select{
            min-width: 200px;
            height: 40px;
            padding: 0px 10px;
            line-height: 38px;
            font-size: 12px;        
            color: $body-general-color;     
            font-family: $font-heading;
            text-transform: uppercase;
            @media (max-width: 767px) {
              -webkit-appearance:none;
            }
          }          
        }
        label{    
          color: $body-title-color;               
          font-weight: 700; 
          margin: 0;          
          float: left;
          line-height: 40px;
          min-width: 110px;
          padding: 0 15px 0 0;
          white-space: nowrap;
          /*font-size: $font-medium;  
          text-transform: uppercase;*/
        }
      }      
      .quantity-product {
        margin: 0 0 20px;    
        overflow: hidden;
        label {
          float: left; 
          margin: 0;
          line-height: 40px;
          width: 110px;
          /*font-size: 14px;
          text-transform: uppercase;     */     
          font-weight: 700;
          color: $body-title-color;
        }            
        .quantity {     
          float: left;
          margin-right: 20px;         
          .qty-inner > span.qty-down {
          	left: 110px;
          }
        }
        .size-chart {
          float: left;
          > a {
          	color: $main-color;
            text-decoration: underline;
            display: inline-block;
            line-height: 40px;
            &:hover {
            	text-decoration: none;
            }
          }
        }
        .qty-stock {
          display: inline-block;
          margin-bottom: 15px;
        }        
        @media (max-width: 379px) {
	      float: none;	  
	      width: 100%;
	      margin: 0 0 15px 0;    
	    }  
      }
      .total-price{        
        color: $body-price-color;
        display: inline-block;
        margin-right: 10px;
        margin-top: 16px;
        .price-sale{
          margin-right: 10px;
        }
      }     
    }    
  }
  &.product-extended {
    .product-info .product-action .action-button .add-to-cart {      
      width: 100%;                
      &:hover {        
        color: $white;
      }      
    }    
  }
  #related_item {
  	margin: 55px auto 0px;
