/*Popup Cart*/
#layer-addcart-modal {
  z-index: 9999;
  .addcart-overlay {
    background: rgba(0, 0, 0, 0.8);   
    height: 100%;
    left: 0;    
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 9990;
  }
  .addcart-modal-box {    
    @include ab(15%, n, n, n);  
    margin: 0 25%;
    padding: 30px;
    width: 50%;
    height: auto;
    max-height: 90%;    
    z-index: 9991;
    background: $body-background-color;    
    .note {
      background: $body-background-color;     
      display: block;
      margin: 0px 0 20px;
      padding: 0px;
      color: $main-color;
      .fa {
        color: $main-color;
        margin-right: 5px;
      }
    }
    .addcart-modal-product {
      padding: 0px 0px 20px;
      display: table;
      table-layout: fixed;
      overflow: hidden;
      width: 100%;
      .addcart-modal-image {
        display: table-cell;
        vertical-align: middle;
        padding: 0 20px 0 0;
        width: 35%;        
      }
      .addcart-modal-info {
        display: table-cell;
        vertical-align: middle;
        width: 65%;
        > div {
          margin: 0 0 10px;
          &.addcart-modal-title {           
            color: $body-title-color;
            font-size: $size-h5;                        
          }
          &.addcart-modal-qty {
            strong {
              font-weight: normal;
            }
          }
          &.addcart-modal-price {
            color: $body-price-color;           
            font-size: $size-h6;
            font-weight: 700;
            strong {
              color: $body-title-color;              
            }
          }
        }
        strong {
          margin: 0 10px 0 0;
        }
      }
    }
    .addcart-modal-action {           
      padding: 5px 0px 0px;
      clear: both;
      .addcart-modal-number {
        display: block;       
        margin: 0 0 15px;
      }
      .addcart-modal-subtotal {
        color: $body-price-color;  
        font-weight: 700;     
        font-size: $size-h6;
        strong {
          margin: 0 20px 0 0;
          color: $body-title-color;
          font-family: $font-heading;
          font-weight: 700;
          font-size: 16px;
          text-transform: uppercase;
        }
      }
      .addcart-modal-button {        
        padding-top: 10px;
        .fa {
          display: none;
        }
        .addcart-modal-continue {
          float: left;          
          border: none;
          margin: 10px 0 0;         
        }
        .addcart-modal-checkout {
          float: right; 
          margin: 10px 0 0;
          .btn {                  
          }
        }
        @media (max-width: 610px) {
          .addcart-modal-continue,
          .addcart-modal-checkout {
            float: left;
            clear: both;
            width: 100%;
            max-width: 300px;   
            .btn {
              width: 100%;
              padding: 9px 15px;
            }    		
          }
        }
      }
    }
  }  
  .addcart-modal-close {    
   @include border-radius-circle;    
    @include box-shadow(0 0px 0px rgba($black, 0.8));
    @include ab(-15px, n, n, -15px);          
    width: 35px;
    height: 35px;
    cursor: pointer;
    display: block;
    cursor: pointer;
    background-color: $main-color;
    background-image: none;
    text-align: center;
    &:before {
      content: "\f00d";
      font-family: FontAwesome;
      color: $white;
      width: 100%;      
      line-height: 35px;
    }   
    .fa {
      display: none;
    }  
    @media (max-width: 767px)  {
    	/*top: 0;
    	right: 0;*/
    }
  }
}
