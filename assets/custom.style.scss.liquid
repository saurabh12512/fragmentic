    display: table;
    width: 100%;
    table-layout: fixed;
    .no-padding {
      padding: 0;      
      height: 100%;
      @media (min-width: 768px) {
      	display: table-cell;
        vertical-align: middle;
        float: none;
      }
    }
    .banner-container {
      @include box-shadow(0 0px 8px rgba(#c9c9c9, 0.75));
    }
  }
  .banner-item {
  	.image {
  	  position: relative;
  	  text-align: center;
