  .product-info { 
    position: relative;
    margin-bottom: 30px; 
    h1[itemprop="name"] {      
      font-weight: 700;        
      text-align: left; 
      font-size: $product-detail-title-size;      
      margin: 0 0 15px;      
      text-transform: none;        
    }
    .author {
      padding: 0 0 12px;
      margin: 0;
      font-size: $body-font-size;      
      color: $body-light-color;
      overflow: hidden;
      text-transform: uppercase;      
    }
    .rating-links {     
      margin: 10px 0px 15px;
      line-height: 20px;
      white-space: 	nowrap;	
      overflow: hidden;
       > a {
      	color: $body-light-color;      	      	
      }
    }
    .detail-deal {
      display: block;     
      text-align: center;
      .deal-text {
      	font-weight: 700;
      	display: block;
      	line-height: 28px;
      	padding: 0 0 10px;
      }
      .wrapper-countdown {
      	margin: -7px 0 30px;        
        > div{
          text-align: center;
          margin: 0;
          padding: 0;
          background: none;
          border: none;
          .countdown-row {
          	display: block;
          }
          .countdown-section {
            margin: 0 15px;
            padding: 0;
            display: inline-block; 
            float: none;
            width: auto; 
            position: relative;
            @media (max-width: 479px) {
              margin: 0 7px;
            }
            &:before {
              content: ':';
              color: $body-title-color;
              font-size: 30px;
              font-weight: 700;
              line-height: 1.2;
              @include ab(0px, n, n, -17px);
              @media (max-width: 479px) {
                font-size: 26px;
                right: -8px;
              }
            }
            &:last-child {
              &:before {
              	content: none;
              }
            }
          }
          .countdown-amount {
          	display: block;
          	color: $body-title-color;
            font-size: 30px;
            font-weight: 700; 
            line-height: 1.2;            
            @media (max-width: 479px) {
              font-size: 26px;
            }
          }
          .countdown-period {
          	display: block;
          	color: $body-title-color;
            font-size: $font-medium;
            font-weight: 700; 
            text-transform: uppercase;   
            @media (max-width: 1199px) and (min-width: 992px) {
              font-size: 12px;
            }         
            @media (max-width: 479px) {
              font-size: 12px;
            }
          }
        }
      }
    }
    .product-detail-review {
      margin: 0 0 15px;
      display: inline-block;
      > a {
        margin-left: 8px;
        font-size: 13px;        
        &:hover {
          color: $main-color;
        }
      }
    }
    .product-availability-wrapper {
      margin: 0 0 15px;
      ul {
        li {
          line-height: 22px;
          color: $black;
          position: relative;
          padding: 0 0 0 100px;
          span:first-child {
            color: $body-light-color;
            padding: 0 5px 0 0;
            @include ab(0, 0, n, n);
          }
        }
      }
    }   
    .short-description {
      padding: 0 0 20px;      
      line-height: 1.6;
      color: $body-light-color;
      h5 {
        display: none;
      }                
    }
    .spr-badge {
      margin: 0 15px 0 0;         
      display: inline-block;   
      float: left;     
      position: relative;
      &:after {
      	content: '';
      	width: 1px;
      	height: 12px;
      	background: $body-light-color;
      	@include ab(4px, n, n, -8px);
      }
      .spr-badge-caption {
        float: left;    
        display: inline-block;                       
        &:before{
          content: "(";
        }
        &:after{
          content: ")";
        }
      }      
    }   
    .price-preview-container {
      overflow: hidden;
    }
    .group-wlcp {
      overflow: hidden;
      margin: 0;      
      .add-to-compare,
       .add-to-wishlist {        
        float: left;
        padding: 0;
        margin: 0;
        line-height: 28px;
        background: none;
        border: none;
        width: auto;
        height: 28px;
        min-width: 40px;
        color: $body-title-color;
        font-size: $body-font-size;
        font-family: $font-standard;
        text-transform: none;    		
        letter-spacing: 0;
        font-weight: normal;
        @include border-radius-reset; 	
        span {
          height: 100%;
          width: auto;
          float: left;
          &:before {
          	margin: 0 7px 0 0;
          	font-size: 14px;
          	line-height: 28px;
          }
        }	
        &:hover {
          color: $main-color;
        }        
