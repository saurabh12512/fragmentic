/* ajjax cart ------------------------------*/
.jGrowl-notification{
  @include box-shadow(2px 0 15px #bebebe);
  div.jGrowl-close{   
    @include border-radius(0%, 0%, 0%, 0%);
    position: absolute;
    top: -1px !important;
    right: -1px !important;
    left: auto !important;    
    text-align: center; 
    background: $button-btn1;     
    text-align: center;   
    z-index: 1;
    cursor: pointer; 
    margin: 0;  
    height: 30px;
    line-height: 30px !important;
    width: 30px;
    font-size: 0;    
    &:before {
      content: "\f00d";
      font: 14px/30px Fontawesome !important;
      color: $button-btn1-txt;
    }
    &:hover {
      background:$button-hover-btn1;
      &:before {
        color: $button-hover-btn1-txt;
      }
    }
    .fa {
      display: none;
    }
  }
  .jGrowl-message{
    .effect-item-action{
      .your-cart{
        padding: 10px 20px;
        display: inline-block;
        margin-top: 15px;
      }
    }
  }
