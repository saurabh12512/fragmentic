        background: transparent;        
        @include border-radius(0, 0, 0, 0);
        > li.dropdown.mega-menu {
          > .dropdown-menu {
	        margin-left: 0;
	      }
          &:hover > .dropdown-menu {
	        margin-left: 0;
	      }
        }
