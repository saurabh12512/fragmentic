/* Quick view ----------------------------------*/
.quantity{
  position: relative;
  display: inline-block;
  input{
    text-align: center;
    padding: 0 25px;    
    width: 85px;
    height: 40px;
    color: #323232;
    border: 1px solid $body-border-color;
    @include border-radius-reset;
    background-repeat: no-repeat;
    background-attachment: fixed;
    background: transparent;
    -moz-appearance:textfield;  
    -webkit-appearance:textfield;     
    -webkit-appearance: none; 
    &:focus, 
    &:active,
    &:hover {
      background: none;
    }
  } 
  .qty-inner {       
    > span {      
      width: 25px;
      height: 40px;
      text-align: center;
      padding: 0px;      
      font-weight: 400;
      cursor: pointer;
      display: inline-block;
      line-height: 40px;
      font-size: 10px;
      &.qty-up {
        @include ab(0px, n, n, 0);
        @include border-radius-reset;          
        .fa {
          width: 100%;
          height: 100%;          
          @include transition(all 0.35s ease 0s);
          &:before,
          &:after {
            content: '';
            width: 11px;
            height: 1px;
            background: $body-title-color;
            display: block;
            @include ab(50%, 50%, n, n);
            @include translate(-50%, -50%);	        
          } 
          &:after {
            width: 1px;
            height: 11px;
          }
        }
      }

      &.qty-down{
        @include ab(0, 0, n, n);
        @include border-radius-reset;          
        .fa {
          width: 100%;
          height: 100%;         
          @include transition(all 0.35s ease 0s); 
          &:before {
            content: '';
            width: 11px;
            height: 1px;
            background: $body-title-color;
            display: block;
            @include ab(50%, 50%, n, n);
            @include translate(-50%, -50%);
          }
        }                      
      }
      &:hover{        
        i{
          background: $button-btn1;
          &:before,
          &:after {
            background: $button-btn1-txt !important;
          }
        }
      }
    }
  }
}
