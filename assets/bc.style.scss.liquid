          font-size: $body-font-size;
          color: $body-title-color;
          &:hover {          
            color: $main-color;
          }
        }        
      }
      .cart-item-price {        
        color: $body-price-color;        
        line-height: 1.3;
        font-weight: 700;
        font-size: $size-h6;
      }      
