    animation-fill-mode:both;
  }
}

.product-list-item .switch,
.product-wrapper .product .image {
  overflow: hidden;
  position: relative;
  text-align: center;
  > a {
    > span.hidden-sm {     
      visibility: hidden;
      width: 100%;
      @include opacity(0);
      @include ab(0, 0, n, n);
      @include transition(all 0.35s ease-in-out 0s);
    }
    &:hover {
      > span.hidden-sm {
        @include opacity(1);
        @include rotateY(0deg);
        @include transition(all 0.35s ease-in-out 0s);
        visibility: visible;
      }
    }
  }  
}
