      margin: 0 0 30px;
      font-size: $size-h5;      
      color: $body-general-color;
      line-height: 1.5;
      font-weight: 700;      
      span > span {
        color: $main-color;
      }         
    }   
    #mc-form {
      margin: 0;
      padding: 0;
      border: none;
      position: relative;      
      clear: both;      
      max-width: 420px;
      #mc-email {                
        width: 100%;        
        margin-left: 0px;              
        background: none;
        padding-right: 50px;
        background: $white;
        &:focus {
          @include box-shadow(0 0 0 #fff);
          background: $white;          
        }
      }
      .btn {                                
        text-align: center; 
        @include ab(0, n, n, 0);
        background: none;
        padding: 0;
        border: none;
        font-size: 0;
        height: 45px;
        width: 50px;
        &:before {
          content: "\f1d8";
