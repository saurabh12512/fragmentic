        font-weight: 700;
        @media (max-width: 991px) and (min-width: 768px) { 
          padding-left: 30px;
          padding-right: 30px;
        }
      }
    }
  }
  .swiper-slide  {
    width: 33.333333%;
    text-align: center;
    @include opacity(0.5);
    @include transition(all 0.35s ease 0s);
    @media (max-width: 767px) {
      width: 100%;
    }
    &.swiper-slide-prev,
    &.swiper-slide-next  {
      width: 30%;
      @media (max-width: 767px) {
        width: 100%;
      }
    }
    &.swiper-slide-active {
      width: 41%;
      margin-top: -7%;
      @include opacity(1);   
      @media (max-width: 767px) {
        width: 100%;
        margin-top: 0;
      }
      .text {
        top: 57%;
        border: 10px solid rgba(#e5ecf8, 0.5);
        @include transparent($black, 0.35);
