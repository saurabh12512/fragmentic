/*css----*/

.alert-danger {
  border-radius: 0;
  border-color: #d02e2e;
  color:#d02e2e;
  background-color:#fff6f6;    
}

.alert-success {
  border-radius: 0;
  border-color: #56ad6a;
  color:#56ad6a;
  background-color:#ecfeee;    
}

.loading {
  background: transparent url({{"loading.gif" | asset_url}}) center center no-repeat;
  position: fixed;
  top: 50%!important;
  bottom: auto;
  left: 50%;
  right: auto;
  width: 80px;
  height: 80px;
  margin-left: -28px;
  margin-top: -28px;
  overflow: hidden;
  padding: 0;
  text-align: center;
  text-indent: -999em;
  background-size: 85%;
  z-index: 99999;
  background-color: $white;
  @include border-radius(3px, 3px, 3px, 3px);
  @include box-shadow(0 0px 10px rgba(#d1d1d1, 0.75));   
}

/*Fixed CSS*/
#body-content {    
  min-height: 250px;  
  margin: 0 auto 0;  
  width: 100%; 
  @media (max-width: 767px) {
    margin: 0px auto 30px;
  }
}
.zoomContainer {
/*   z-index: 1; */
  overflow: hidden;
}

.modal-open .zoomContainer {
  z-index: 1050;
}

#related-product .product-wrapper .product-head .product-button{
  display: none! important;
}

.add-to-cart.disabled,
.add-to-wishlist.disabled{
  cursor: not-allowed;
  pointer-events: none;
  @include opacity(0.6);
  background: $button-btn1 !important;
  border-color: $button-btn1-border !important;
  color: $button-btn1-txt !important;
  -webkit-box-shadow: none;
  box-shadow: none;
}

.heatmap {
  width: 100%;
  height: 100%;
  position: absolute!important;
  z-index: 10;
  opacity: 0;
  display: none;
}
.boxes {
  @include box-shadow(0 0 8px #ddd);
}

.boxes-wrapper {
  {% if settings.boxes_mode_bg == 'image' %}
  background: url({{ 'body_bg_image.jpg' | asset_url}}) repeat fixed transparent;
  {% else %}
  background-color: {{settings.body_bg_color}};
  {% endif %}
}

