      text-align: center;
      position: relative;
      z-index: 991;
      .fa {
        &:before {
          font-size: $size-h6;
        }
      }
    }   
    .dropdown-menu {          
      left: auto;
      right: 0;            
      width: 300px;  
      display: block;  
      visibility: hidden;
      z-index: -99;
      @include translate(0%, 10px);  
      @include opacity(0);
      @include  transition(all 0.35s ease);    
      @media (max-width: 400px) {
        width: 280px;
        right: -60px;
      }       
    }
    &:hover {
      @media (min-width: 1025px) {
