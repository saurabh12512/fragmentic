        .pc-inner {
          position: relative;
          height: 100%;
          padding: 0 95px 0 0;
          @media (max-width: 479px) {
            padding: 0;
          }
        } 	
        .product-name {
          font-weight: 700;
        }
        .product-author {
          text-transform: uppercase;
          font-size: 12px;	  	  
        }
        .product-variants {
