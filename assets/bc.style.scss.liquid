    padding: 20px;
    z-index: 2;
    h5 {
      font-size: 16px;
      color: $white;
      margin-bottom: 10px;
    }
    .widget-social-icons {
      padding: 0 0 5px;
      li {
        display: inline-block;
        a {
          display: block;
          width: 35px;
          height: 35px;
          border: 1px solid $white;
          line-height: 33px;
          color: $white;
          font-size: $size-h6;
          margin: 0 0 5px;
          > span {
            display: none;
          }
        }
      }
    }
  }
