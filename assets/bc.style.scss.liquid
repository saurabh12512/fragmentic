/*Oder form*/
.filter-order-form,
.filter-sidebar {
  top: 0 !important;
  position: fixed;
  width: 260px;
  z-index: 100000;
  height: 100%;    
  left: 0px;
  -webkit-transform: translate(-100%, 0);
  -moz-transform: translate(-100%, 0);
  -ms-transform: translate(-100%, 0);
  -o-transform: translate(-100%, 0);
  transform: translate(-100%, 0);
  -moz-transition: all 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  -o-transition: all 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  -webkit-transition: all 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  transition: all 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  padding: 20px 15px;
  background: #fff;
  @include opacity(0);
  @include box-shadow(0 0px 8px rgba(#c9c9c9, 0.75));
  .sb-filter-wrapper {
    max-height: 100%;
    overflow: auto;
    .grid-uniform {
      border: 1px solid $body-border-color;
      background: $body-second-color;
      overflow: hidden;
    }
    .sb-filter {
      display: block;
      clear: both;
      width: 100%;
      float: left;
      text-align: left;
      font-weight: normal;
      > div .sbf-title {
        padding: 17px 20px 12px;
      }
      .advanced-filters {
        max-height: 290px;
        overflow: auto;
        li.advanced-filter {
          line-height: 20px;
          margin-bottom: 7px;
          a{
            position: relative;
            padding-left: 30px;
            min-height: 20px;
            display: inline-block;    
            font-size: $body-font-size;        
            &:before{
              content: "";
              @include ab(3px,0,n,n);              
              width: 16px;
              height: 16px;              
              border: 1px solid $body-border-color;  
              @include transition(all 0.35s ease 0s);            
            }

            &:after {
              content: "\f00c";
              font-family: FontAwesome;
              font-size: 12px;
              width: 16px;
              height: 16px; 
              @include ab(1px, 3px, n, n);              
              @include opacity(0);
              @include transition(all 0.35s ease 0s);              
            }
            &:hover {
              @media (min-width: 1025px) {
                &:before {
                  border-color: $main-color;
                }
                &:after {
                  @include opacity(1);
                }
              }              
            }
          }

          &.af-color {
            border: none;
            padding: 0;
            float: none;
            width: inherit;
            margin: 0 4px 4px 0;
            width: 33px;
            height: 33px;
            line-height: 33px;            
            position: relative; 
            cursor: pointer;
            float: left;
            border: 1px solid $body-border-color;            
            @include box-shadow(0 0 0 1px #ffffff inset);  
            @include transition(all 0.35s ease 0s);
            a{              
              display: block;
              padding: 0;
              position: relative;
              display: block;  
              content: '';
              width: 100%;
              height: 100%;           

              &:before,
              &:after {                
                content: none !important;
              }
            }
            &:hover {
              @media (min-width: 1025px) {
                border-color: $main-color;
                @include box-shadow(0 0 0 1px #ffffff inset); 
              }
            }
            &.active-filter {
              border-color: $main-color;
              @include box-shadow(0 0 0 1px #ffffff inset); 
            }
          }

          &.active-filter {            
            a{
              &:before {
                border-color: $main-color;
              }
              &:after{
                @include opacity(1);
              }
            }
          }
        }
      }

      &.size {
        .advanced-filters {
          li.advanced-filter {
            width: auto;
            display: inline-block;
            float: left;
            margin: 0 4px 4px 0;
            border: 1px solid $body-border-color;   
            background: $white;     
            @include transition(all 0.35s ease 0s);    
            a{              
              padding: 0px 5px;              
              text-transform: uppercase;              
              text-align: center;
              height: 33px;
              min-width: 33px;
              line-height: 33px;
              display: inline-block; 
              font-size: 12px;                          
              color: #717171;
              font-family: $font-heading;              

              &:before, &:after{
                width: 0;
                height: 0;
                border: 0;
                content: none;
              }              
            }
            &.active-filter {
              border-color: $button-btn1-border;
              a{
                background: $button-btn1;
                color: $button-btn1-txt;
              }
            }
            &:hover {                
              @media (min-width: 1025px) {
                border-color: $button-btn1-border;
                a{
                  background: $button-btn1;
                  color: $button-btn1-txt;
                }
              }
            }
          }
        }
      }
      &.price {
        @media (min-width: 1025px) {
          display: none;
        }
      }
    } 
  }
  .fof-close,
  .fsb-close {
    position: absolute;
    right: -30px;
    top: 0px;
    width: 30px;
    height: 30px;
    line-height: 26px;
    text-align: center;
    border: 2px solid $main-color;
    color: $white;
    background-color: $main-color;
    z-index: 999;
    cursor: pointer;
    @include opacity(0);
  }
  &.opened {
    @include opacity(1);
    -webkit-transform: translate(0px, 0);
    -moz-transform: translate(0px, 0);
    -ms-transform: translate(0px, 0);
    -o-transform: translate(0px, 0);
    transform: translate(0px, 0);
    .fof-close,
    .fsb-close {
      @include opacity(1);
    }
  }
}
.group-toolbar {
  .filter-of-icon,
  .filter-icon {
    float: left;
    margin: 0 6% 10px 0;
    height: 40px;
    padding: 0 20px 0 15px;
    line-height: 38px;
    border: 1px solid $main-color;
    background: $main-color;
    color: $white;
