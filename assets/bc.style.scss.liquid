            }
            &.active{
              cursor: default;
            }
          }
        }
      }
      .owl-controls{
        .owl-nav{
          >div{
            top: 50%;            
            border: none;
            text-align: center;
            padding: 0px;
            font-size: 0;    
            width: 30px;
            height: 30px;
            line-height: 30px;       
            @include translate(0, -50%);
            @include box-shadow(0 0px 2px rgba(0, 0, 0, 0.2));           
            span {
              width: 30px;
              height: 30px;
              line-height: 30px;
              &:before {
                font-size: 20px;
              }
            }
            &.owl-next{
              right: 1px;              
            }

            &.owl-prev{
              left: 1px;  
            }
          }
        }
      }
