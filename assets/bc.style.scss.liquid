    .more-view-image #gallery-image{
      margin: 15px 0px 0; 
      list-style: none;  
      li {
        float: left;
        width: 25%;
        padding: 0 10px;
      }
      &.owl-carousel {
        li {        
          width: 100%;  
          padding: 0;
        }  
      }      
      .thumb-img {
        display: block;          
      }
      .owl-stage-outer{
        .owl-item{         
          a{                   
            img{                                            
              max-width: 100%;              
