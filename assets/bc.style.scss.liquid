@mixin CSStransform2D($x, $y){
  transform: scale($x, $y);
  -moz-transform: scale($x, $y);
  -webkit-transform: scale($x, $y);
  -ms-transform: scale($x, $y);
  -o-transform: scale($x, $y);
}

@mixin button1(){
  text-transform: uppercase;
  text-align: center;      
  padding: 9px 25px;
  line-height: 25px;   
  font-weight: 700;
  font-family: $font-heading; 
  background: $button-btn1;
  color: $button-btn1-txt;  
  border: 1px solid $button-btn1-border;   
  @include transition(all 0.35s ease 0s);  
  &:hover{       
    text-decoration: none;    
    background: $button-hover-btn1;
    color: $button-hover-btn1-txt;
    border-color: $button-hover-btn1-border;
  }
}

@mixin button2(){
  text-transform: uppercase;
  text-align: center;      
  padding: 9px 25px;
  line-height: 25px;    
  font-weight: 700;
  font-family: $font-heading;
  background: $button-btn3;
  color: $button-btn3-txt;  
  border: 1px solid $button-btn3-border;    
  @include transition(all 0.35s ease 0s);  
  &:hover{
    background: $button-hover-btn3;       
    text-decoration: none;
    color: $button-hover-btn3-txt;
    border-color: $button-hover-btn3-border;
  }
}

@mixin transparent($color, $alpha) {
  $rgba: rgba($color, $alpha);
  $ie-hex-str: ie-hex-str($rgba);
  background-color: transparent;
  background-color: $rgba;
  filter:progid:DXImageTransform.Microsoft.gradient(startColorstr=#{$ie-hex-str},endColorstr=#{$ie-hex-str});
zoom: 1;
}

@mixin translate($x, $y) {
  -webkit-transform: translate($x, $y);
  -ms-transform: translate($x, $y); // IE9+
  -o-transform: translate($x, $y);
  transform: translate($x, $y);
}
@mixin box-shadow($shadow...) {
  -webkit-box-shadow: $shadow; 
  -ms-transform: $shadow; // IE9+
  -o-transform: $shadow;
  box-shadow: $shadow;
}

@mixin translate3d($x, $y, $z) {
  -webkit-transform: translate3d($x, $y, $z);
  transform: translate3d($x, $y, $z);
  -ms-transform: translate3d($x, $y, $z);
  -o-transform: translate3d($x, $y, $z);
} 
@mixin border-radius($tl, $tr, $br, $bl) {
  border-radius: $tl $tr $br $bl;
  -moz-border-radius: $tl $tr $br $bl;
  -webkit-border-radius: $tl $tr $br $bl;
}
@mixin opacity ( $value )/*: 0.5 */ {
  opacity: $value; 
}

@mixin skew($x, $y) {
  -webkit-transform: skew($x, $y);
  -ms-transform: skewX($x) skewY($y); 
  -o-transform: skew($x, $y);
  transform: skew($x, $y);
}

@mixin ab($t, $l, $b, $r) {
  position: absolute;
  display: block;
  @if $l != n { left: $l; }
  @if $t != n { top: $t; }
  @if $r != n { right: $r; }
  @if $b != n { bottom: $b; }
}

@mixin rotateY($degree) {
  -moz-transform:    rotateY($degree);
  -webkit-transform: rotateY($degree);
  -o-transform:      rotateY($degree);
  -ms-transform:      rotateY($degree);
  transform:         rotateY($degree);
}

@mixin rotateX($degree) {
  -moz-transform:    rotateX($degree);
  -webkit-transform: rotateX($degree);
  -o-transform:      rotateX($degree);
  -ms-transform:      rotateX($degree);
  transform:         rotateX($degree);
}

@mixin transform($transforms) {
  -moz-transform: $transforms;
  -o-transform: $transforms;
  -ms-transform: $transforms;
  -webkit-transform: $transforms;
  transform: $transforms;
}

@mixin rotate ($deg) {
  @include transform(rotate(#{$deg}deg));
} 

@mixin transition($transition...) {
  -moz-transition:    $transition;
  -o-transition:      $transition;
  -webkit-transition: $transition;
  transition:         $transition;
}

@mixin before {     
  @media (min-width: 1025px) {
    content:'';
    @include ab(0, 0%, n, n);
    @include opacity(0);
    @include transition(all 0.35s ease 0s);
    width:100%; 
    height:100%;  
    background: transparent;
  }
}
@mixin hover-before {
  @include opacity(1);
  background: rgba($black, 0.4);
}
@mixin border-radius-reset {
  @include border-radius(0px, 0px, 0px, 0px);
}
@mixin border-radius-circle {
  @include border-radius(50%, 50%, 50%, 50%);
}
