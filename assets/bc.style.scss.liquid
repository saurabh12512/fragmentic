  }
}
.quick-shop-button {
  cursor: pointer;
  &:hover {
    color: $main-color;
  }
}
.add-cart-button {  
  box-sizing: border-box;
  -webkit-box-sizing: border-box;
  -moz-box-sizing: border-box;
  vertical-align: top; 
  border: 0;  
  .add-to-cart, .select-options {           
    padding: 0px;
    line-height: 28px;
    display: inline-block;        
    text-transform: uppercase;    
    &.focus, &:focus, &:hover {
      outline: none;
    }
  }
}

/*button slider*/
.owl-theme {
  .owl-controls .owl-nav > div{  
    @include ab(50%, 0, n, n);  
    @include translate(0, -50%);
    @include transition(all 0.35s ease 0s);
    background: #e5e5e5;
    display: inline-block;
    padding: 0;
    margin: 0;     
    height: 30px;     
    width: 30px;
    @media (max-width: 479px) {
      width: 25px;
      height: 25px;
    }
    span{
      display: inline-block; 
      height: 30px;
      width: 30px;   
      cursor: pointer;
      text-align: center;
      line-height: 28px;    
      @media (max-width: 479px) {
        width: 25px;
        height: 25px;
        line-height: 25px;
        background: #000;
      } 
      &:before {
        font-family: FontAwesome;
        font-size: 30px;
        color: $white;
        @media (max-width: 479px) {
          font-size: 20px;
        }
      }
    }

    &.owl-next {      
      right: 0px; 
      left: auto;     
      span {
        &:before {
          content: "\f105";
        }
      } 
    }
    &.owl-prev {
      span {
        &:before {
          content: "\f104";
        } 
      }
    }
    &:hover {
      @media (min-width: 1025px) {
        background: #b2b2b2;
      }
    }
  }

  &:hover {   
    .owl-controls .owl-nav > div {
      @include opacity(1);     
    }
  }
}

