/* Popup newsletter ------------------------------*/
.fancybox-skin {
  padding: 0px !important;  
  color: $body-general-color;
  @include border-radius-reset;
  .fancybox-close {       
    @include border-radius-circle;    
    @include box-shadow(0 0px 0px rgba($black, 0.5));
    @include ab(-15px, n, n, -15px);          
    width: 35px;
    height: 35px;
    cursor: pointer;
    display: block;
    cursor: pointer;
    background-color: $main-color;
    background-image: none;
    text-align: center;
    &:before {
      content: "\f00d";
      font-family: FontAwesome;
      color: $white;
      width: 100%;      
      line-height: 35px;
    }   
  }
  #mailchimp-popup {
    background-color: $body-background-color;
    background-image: url({{'mailchip_popup_bg.jpg' | asset_url }});
