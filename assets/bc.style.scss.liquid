/* Back to top ---------------------------------*/
#scroll-to-top {
  @include transition(all 0.2s ease-out 0s); 
  -moz-backface-visibility: hidden;
  opacity: 0;
  filter: alpha(opacity=0);
  position: fixed;
  /*right: -50px;*/
  bottom: 10px;
  z-index: 1000;
  display: block;
  cursor: pointer;
  text-align: center;
  &.on {
    bottom: 10%;
    opacity: 1;
    right: 30px;
    filter: alpha(opacity=100); 
  }
  i {   
    display: none;    
  }
  a {
    position: relative;
    width: 45px;
    height: 45px;
    line-height: 45px;    
    display: block;
    border: none;
    @include transparent($main-color, 0.5);
    @include transition(all 0.3s ease-in-out 0s);    
    &:before {
      content: "\f106";
      font-size: 28px;
      padding: 0;
      width: 45px;
      height: 45px;
      line-height: 45px;
      text-align: center;  
      color: $white;
      font-family: Fontawesome;
      display: block;      
      @include transition(all 0.3s ease-in-out 0s);
    }
  }

  &:hover{
    a {
      @include transparent($main-color, 1);
      &:before {        
        color: $white;
      }
    }
  }
}

/*menu on PC---------------------------------*/
.horizontal-menu {      
  background: none;  
  position: relative;
  text-align: center;    
  clear: both;
  margin: 20px auto 0;
  .navigation .navbar .navbar-collapse {
    .main-nav { 
      width: 100%;     
      > li {
        &.dropdown {  
          > .dropdown-menu {
            display: block !important;  
            top: 100%;
            left: 0px !important;    
            visibility: hidden;
            z-index: -99;
            @include translate(0%, 10px);  
            @include opacity(0);
            @include transition(all 0.35s ease-in-out 0s);
          }
          &:hover,                    
          &.hover {
            > a { 
              position: relative;                         
            }
            > .dropdown-menu {              
              background: $nav-dropdown-background;                         
              visibility: visible;
              z-index: 99;          
              @include opacity(1);  
              @include translate(0%, 0px);        		          		
            }
          }
          &.mega-menu {
            position: static;            
            > .dropdown-menu {                    
              left: 50% !important;                                  
              @include translate(-50%, 10px);                              
              .dropdown-menu {
                font-size: $body-font-size;                 
              } 
              &.column-4 {
                width: 100%;
                @media (min-width: 768px) {			  
                  width: 730px;				
                }
                @media (min-width: 992px) {			  
                  width: 950px;				
                }
                @media (min-width: 1200px) {				  
                  width: 1170px;				
                }
              }
              &.column-3 {
                width: 75%;  
                @media (min-width: 768px) {			  
                  width: 730px;				
                }
                @media (min-width: 992px) {			  
                  width: 705px;				
                }
                @media (min-width: 1200px) {				  
                  width: 870px;				
                }              
              }
              &.column-2 {
                width: 50%;
                @media (min-width: 768px) {			  
                  width: 730px;				
                }
                @media (min-width: 992px) {			  
                  width: 950px;				
                }
                @media (min-width: 1200px) {				  
                  width: 1170px;				
                }
              }
              &.column-1 {
                width: 25%;
                @media (min-width: 768px) {			  
                  width: 730px;				
                }
                @media (min-width: 992px) {			  
                  width: 950px;				
                }
                @media (min-width: 1200px) {				  
                  width: 1170px;				
                }
              }
            }
            &:hover,                    
            &.hover {
              > a { 
                position: relative;  
              }
              > .dropdown-menu {    
                @include translate(-50%, 0px);                
                /*max-height: 550px;
                overflow-y: auto; */
              }
            }
          }                  
        }
        > a {
          position: relative;          
        }
        &:hover/*,
        &.active */{          
          @include border-radius(0px, 0px, 0, 0);
          > a {
            color: $nav-link-hover-color;             
          }
          > span.expand {
            .fa {
              color: $nav-link-hover-color; 
            }
          }
        }
        &:last-child {

        }
      }
    }
  }
}
.navigation {  
  .navbar {
    position: static;    
    border: none;
    margin: 0;    
    @include box-shadow(0 0 0 transparent);
    @include border-radius(0, 0px, 0px, 0px);
    .navbar-collapse {
      padding-left: 0;
      padding-right: 0;
      position: static; 
      .main-nav {
        float: left;
        width: auto;
        position: static;         
        margin: 0px;        
        border: none;      
        background: $bg-main-nav;              
        @include border-radius(0px, 0px, 0, 0);
        span.expand {  
          padding: 0;     
          cursor: pointer;              
          margin-left: -10px;
          display: inline-block;
          position: relative;          
          .fa {font-size: 14px; color: $nav-link-color; }
        }

        > li { 
          display: inline-block;                
          padding: 0 8px;   
          margin: 0;          
          @include transition(all 0.35s ease 0s);                 
          margin-bottom: 0px;  
          > a {                  
            font-size: $nav-font-size;            
            margin: 0;            
            display: inline-block;
            text-decoration: none;            
            line-height: 28px;  
            padding: 10px 12px;
            font-weight: 700;
            color: $nav-link-color;    
            font-family: $font-heading;  
            text-transform: uppercase;  
            position: relative;
            &:before {
              /*content: '';*/
              width: 4px;
              height: 4px;
              background: $body-border-color;
              @include border-radius-circle;
              @include ab(20px, -4px, n, n);
            }    
            &:hover {               
              color: $nav-link-hover-color;
              &:before {
                background-color: $main-color;
              }
            }                     
          }   
          > span.expand {
            width: 15px;
            margin-left: -15px; 
            position: relative;
            left: -4px;
          }
          /*have submenu*/
          &.dropdown {
            position: relative;  
            > a {
              padding-right: 20px;
            }
            .dropdown-menu {
              li {
                position: relative;  
                .dropdown-link {
                  padding-right: 25px;
                }         		
                span.expand {
                  position: absolute;
                  top: 0;
                  right: 20px;
                  height: 46px;
                  width: 25px;
                  text-align: center;
                  line-height: 46px;
                  display: block;		            	  	
                }
              }
            }
            > .dropdown-menu {              
              left: 100%;
              top: 0%;              
              background: $nav-dropdown-background;              
              font-size: $body-font-size;
              padding: 4px 0;
              border: 1px solid $body-border-color;
              &.column-4 { width: 891px; }
              &.column-3 { width: 665px; }
              &.column-2 { width: 410px; }
              &.column-1 { width: 225px; }              
              > li {
                > a{                  
                  color: $nav-dropdown-link-color;
                  white-space: normal;
                  span{
                    color: $nav-dropdown-link-color;                                                            
                  }                  
                  &:hover{
                    span{
                      color: $nav-dropdown-link-hover-color;
                    }
                  }
                }
                .dropdown-menu {
                  background: $nav-dropdown-background;         
                  > li{
                    span.expand .fa {
                      color: $nav-dropdown-link-color;
                    }
                    > a{                      
                      color: $nav-dropdown-link-color;
                      white-space: normal;     
                      span{
                        color: $nav-dropdown-link-color;
                      }                     
                      &:hover{ 
                        span{
                          color: $nav-dropdown-link-hover-color;
                        }
                      }
                    }
                    &:hover {
                      > span.expand .fa {
                        color: $nav-dropdown-link-hover-color;
                      }
                      > a {
                        span {
                          color: $nav-dropdown-link-hover-color;
                        }
                      }
                    }
                    &:last-child {
                      > a {
                        border-bottom: none;
                      }
                    } 
                  }
                } 
                &:hover {
                  > span.expand .fa {
                    color: $nav-dropdown-link-hover-color;
                  }
                  > a {
                    span {
                      color: $nav-dropdown-link-hover-color;
                    }
                  }
                }
                &:last-child {
                  > a {
                    border-bottom: none;
                  }
                }               
              }
              > li.dropdown-submenu {                
                > .dropdown-menu{                                    
                  background: $nav-dropdown-background;
                }
              }
              .product-button {
                display: none;
              }
            }
            .dropdown-menu-sub {
              background: transparent;
              border: 0;
              border-radius: 0;
              box-shadow: none;
              position: static;
              width: 100%;
              min-width: auto;
              padding-top: 0;
              .bp-item {
                .bp-content-inner {
                  .bp-title {
                    margin: 0 0px 10px;
                    a {
                      padding: 0;
                      color: $body-general-color;
                    }
                    &:hover {
                      a, a:hover {
                        color: $main-color;
                      }
                    }

                  }
                }
              }
              > li{
                > a{                  
                  color: $nav-dropdown-link-color;
                  white-space: inherit;                  
                  span{
                    color: $nav-dropdown-link-color;
                  }

                  &:hover{                  
                    span{
                      color: $body-second-color;
                    }
                  }
                }
              }
            }            
            &:hover , &.hold {              
              z-index: 22;
              > .dropdown-menu{
                left: 100%;
                display: block;                
              }
            }            
            &.mega-menu:hover > .dropdown-menu, &.mega-menu.hold > .dropdown-menu {
              .dropdown-menu-sub {
                display: block;
              }
            }
          }
          &:first-child {
            > a {
              &:before {
                content: none;
              }
            }
          }
        }

        > li.mega-menu {
          > .dropdown-menu { 
            padding: 15px 30px; 
            .mega-image-bottom {
              margin-top: 21px;
              > a {
                display: block;
                position: relative;
                &:before {
                  @include before;
                }
                &:hover {
                  &:before {
                    @include hover-before;
                  }
                }
              }
            }          
            .mega-sub-link {
              overflow: hidden; 
              > a {                                                
                font-size: $size-h6 - 2px;                
                position: relative;
                display: block;
                padding: 6px 0;
                line-height: 24px;
                margin: 0;                             
                color: $body-title-color;
                font-family: $font-heading;    
                text-transform: uppercase;
                font-weight: 700;       
                border-bottom: 1px solid $border-menu;    
                &:hover {                 
                  color: $nav-dropdown-link-hover-color;
                }
                &.mega-image {                	
                  padding: 0;
                  margin: 15px auto 18px;
                  border: none;
                  position: relative;
                  &:before {
                    @include before;
                  }
                  &:hover {
                    &:before {
                      @include hover-before;
                    }
                  }
                }
              }
              > span.expand {
                display: none;
              }
              .dropdown-menu {
                margin-top: 10px;
              }
              .dropdown-menu-sub {              	
                &:before {
                  content: none;
                }
                li{
                  border: none;
                  padding: 0;
                  a{                                        
                    display: block;
                    padding: 4px 0;
                    border: none; 
                    margin: 0;                                
                    &:after {
                      content: none;
                    }
                    &:hover{                      
                      color: $nav-dropdown-link-hover-color; 
                      background: none;                      
                    }
                  }
                }
              }
              &.banners { 
                .dropdown-menu {
                  padding-top: 5px;                 
                  > li {
                    > a {
                      padding: 0; 
                      &:before {
                        @include before;
                      }
                      &:hover {
                        &:before {
                          @include hover-before;
                        }
                      }
                    }
                  }
                }
              }
            }
            .product-title {
              a{
                color: $nav-dropdown-link-color !important;
                &:hover{
                  color: $nav-dropdown-link-hover-color !important;
                }
              }
            }
          }

          .mega-col {
            > .dropdown {
              margin: 0 0 5px;
              &:nth-child(2) {
                margin-top: 32px;
              }
            }   
            img {
              @include transition(all 0.35s ease 0s);
              display: block;
              width: 100%;
              border: none !important;
              @include box-shadow(0 0 0 $white);
              &:hover {                
                @include box-shadow(0 0 0 $white);
              }
            }
            .bp-item {
              width: 100%;              
              display: block;     
              text-align: center;                                  
            }           
            .sb-product-head {
              padding-top: 5px;  
            }
            .sb-product-content {                             
              padding: 15px 0 0;
              .bp-content-inner > a {
                padding: 0 0 10px !important;                                  
                font-size: $size-h6 - 2px !important;
                display: inline-block;
                line-height: 1.2;
                &:after {
                  content: none;
                }
                &:hover {
                  background: none;
                }
              }             
              .sb-price { 
                .price-compare {
                  float: none;
                }
              }
            }            
            .dropdown-menu.fix{
              > li{
                border-bottom: 0 !important;
              }
            }
          }
        }
      }
    }
  }
}

/* Menu mobile -----------------------------*/

.mobile-version {
  width: 100%; 
}
.mm-wrapper {
  overflow: auto;
  height: 100%;
}
.mm-block-icons { 
  .list-inline {
    display: table;
    table-layout: fixed;
    width: 100%;
    border-bottom: 1px solid $border-menu;
    background: $button-btn1;
    position: relative;
    > li {
      display: table-cell;
      vertical-align: middle;  	 
      text-align: center;
      border-left: 1px solid $border-menu;
      > a {
        color: $button-btn1-txt;
        display: block;
        position: relative;
        padding: 12px 5px;
        font-size: 14px;
        > span {
          &:before {
            margin: 0px auto;
          }
        }
        .text {
        	display: block;
          	font-size: 12px;
        }
      }
      .wishlist-icon,
      .compare-icon {
        @include ab(5px, n, n, 8px);
        @include opacity(0);
      }
      &:first-child {
        border-left: none;
      }

      &.currency-block {
        .dropdown-menu {
          width: 100px;
          min-width: 100px;
          padding: 5px 0;
        }
      }
    }
  }
}
.menu-mobile {
  border: 0;
  .main-nav {
    .dropdown-menu li {
      padding: 0;
      border: none;
    }
    .dropdown {
      &.open > .dropdown-menu {
        display: none;
      }
      &.menu-mobile-open {
        > .dropdown-menu {
          display: block;
          clear: both;
          border: none; 
          background: $white;
          .container {
            width: auto;
            padding: 0;
            .row {
              margin: 0;
              div {
                width: 100%;
                padding: 0;
                &.banners {
                  display: none;
                }
              }
            }
          }
        }
      }    
    }

    > li {
      display: block;      
      clear: both;
      position: relative;
      a {
        padding: 7px 15px;
        display: block;   
        line-height: 26px;           
        color: $black;
        font-size: $body-font-size;
      }
      > a {
        color: $black;
        font-size: 14px;
        text-transform: uppercase;
        font-weight: 700;
        font-family: $font-heading;
      }     
      .icon-nav {
        display: none;
      }
      > a {
        &:hover, &:focus{
          text-decoration: none;
        }
      }
      > span.expand {
        width: 100%;
        text-align: right;
        padding-right: 15px;
        color: $black;
      }
      &.menu-mobile-open,
      &:hover {
        > a{
          text-decoration: none;          
          color: $nav-link-hover-color;          
        }
        > span.expand {
          i {
            color: $nav-link-hover-color;
            &:before {
              content: "\f0d7";
            }
          }
        }
      }

      &.dropdown {      
        &.menu-mobile-open {
          border-bottom: 1px solid $border-menu;
          > .dropdown-menu {
            display: block;
            width: 100% !important;
            background-image: none !important;
            min-height: 0 !important;
            @include box-shadow(0 0 0 rgba(0, 0, 0, 0.2));
          }
        }        
        .dropdown-menu{
          width: 100%;
          position: static;
          padding: 0;          
          border-top: none;
          >li {      
            >a {
              white-space: normal;
              padding: 7px 20px 7px 25px;              
              background: none;     
              margin: 0;   
              border-bottom: 1px solid $border-menu;        
              font-family: $font-standard;
              font-size: $body-font-size;           
            }
          }          
          .dropdown-submenu {           
            .dropdown-menu {
              padding: 0;
              display: none;
              visibility: hidden;
              @include translate(0, 0);
              @include box-shadow(0 0 0 rgba(0, 0, 0, 0.2));
              border-bottom: 1px solid $border-menu;
              li {
                border-bottom: 1px solid $border-menu;
                a {
                  color: $black;                  
                  border: 0;
                  padding: 7px 15px 7px 35px;
                  background: none;
                  font-family: $font-standard;
                  font-size: $body-font-size;     

                  &:hover {
                    text-decoration: none;
                    color: $nav-dropdown-link-hover-color;
                  }
                }
                &:last-child {
                  border-bottom: 0;
                }
              }
            }
            &.menu-mobile-open {
              > .dropdown-menu {
                display: block;
                visibility: visible;
                @include opacity(1);
              }
              >  span.expand {
                .fa {
                  color: $nav-dropdown-link-hover-color;  
                  &:before {
                    content: "\f0d8";
                  } 
                }
              }
            }
          }          
        }
      }
      &.li-on-mobile {        
        font-size: 18px;
        text-transform: uppercase;
        font-family: $font-heading;        
        text-align: center;
        padding: 10px;
        font-weight: 700;
        text-transform: uppercase;        
        border-bottom: 1px solid $border-menu;        
        color: $black;      
      }
    }
    .product-button {
      display: none !important;
    }
    span.expand {
      position: absolute;
      z-index: 5;
      right: 0px;
      top: 0px;
      width: 40px;
      height: 40px;
      line-height: 40px;
      text-align: center;
      font-size: 14px;
      cursor: pointer;      
      color: $black;      
      i{
        display: block;
        width: 100%;
        height: 100%;
        &:before {
          content: "\f0d7";
          font-family: Fontawesome;
          font-size: 14px;
          display: block;
          line-height: 40px;
        }               
      }
    }

    .mega-menu {
      .mega-image-bottom {
        padding: 0;
        > a {
          padding: 15px;
        }
      }
      .product-wrapper {
        padding: 0 18px 0 0;
        a{
          border: 0;
          padding: 0 ;
        }
        img{ width: 100%;}
      }
      .dropdown-menu {
        padding: 0px !important;
        @include box-shadow(0 0 0 rgba(0, 0, 0, 0.2));
        > .row{ margin: 0; }
        li a{
          padding: 15px 20px;
        }
        .mega-sub-link {         
          padding-bottom: 0;  
          clear: both;
          &.no-title-0 {
            > a,
            > span.expand {
              display: none !important;
            } 
            .dropdown-menu {
              display: block !important;              
            }
          }
          &.no-title-2 {
            > a,
            > span.expand {
              display: none !important;
            } 
            .dropdown-menu {
              display: block !important;              
            }          
          }
          > .dropdown-menu-sub {
            border-bottom: 1px solid $border-menu;
          }                
          a{
            padding: 7px 19px 7px 25px;    
            &.mega-image {
              padding: 15px;
            }
          }
          &.menu-mobile-open {
            > a{
              transition: none;
              -webkit-transition: none;
              border-bottom: 1px solid $border-menu;
              color: $nav-dropdown-link-hover-color;
            }
            span.expand {
              .fa {
                color: $nav-dropdown-link-hover-color;  
                &:before {
                  content: "\f0d7";
                } 
              }
            }
          }
          &.banners {		              
            .dropdown-menu-sub {
              a {
                padding: 15px;              
              }
              &.no-title-1 {
                > a,
                > span.expand {
                  display: none !important;
                } 
                .dropdown-menu {
                  display: block !important;              
                }
              } 
            }
          }
        }        
        .mega-col {
          padding: 0;          
          width: 100%; 
          clear: both;
          .bp-item {
            width: 100%;            
            display: block;
            margin: 0;
            padding: 15px;
            overflow: hidden;            
            .sb-product-head {
              padding: 0;
              a {
                padding: 0 !important;
                border: none;
                margin: 0 !important;

                &:hover {
                  border-color: $main-color;
                }
              }
            }
            .sb-product-content {
              padding: 10px 0 0;
              .bp-content-inner {
                a {
                  padding: 0;
                  margin: 0;
                  border: none;
                  font-size: $size-h6 - 2px;
                }
              }
              .product-review {
                display: none;
              }
            }            
          }         
          .dropdown-menu.fix {
            > li{
              border-bottom: 0 !important;
            }
          }
        }
        .dropdown-menu-sub{
          padding: 0px !important;          
          a{
            padding: 10px 15px 10px 35px;
            font-size: $body-font-size;            
            &:hover{
              text-decoration: none;
              color: $nav-dropdown-link-hover-color;
            }           
          }
          > li {
            &:last-child {
              > a {
                border-bottom: none;
              }
            }
          }
        }
      }     
    }

    li{
      clear: both;
      margin-bottom: 0;
      position: relative;
      a{
        border-bottom: 1px solid $border-menu;  
      }      
    }
    .menu-mobile-open > span.expand {     
      .fa {
        &:before {
          content: "\f0d7";
        }
      }
    }
  }
}

/* main slideshow -----------------------------------*/
.bc-wrapper {
  position: relative; 
  z-index: 1; 
  .swiper-button-white {
    @include opacity(1);
  } 
  &:hover {
    .swiper-button-white {
      @include opacity(1 !important);     

      &.swiper-button-disabled {
        @include opacity(0 !important);
      }
    }

    .video-slide {
      .video {
        z-index: 1;
      }
    }    
  }
}
.video-slide {
  .video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;  
    z-index: 3;      
  }
}
.container-box { 
  padding: 0;        
  position: relative;    
  > div {      
    background: transparent;  
    line-height: 1.0;
    padding: 0;     
    margin: 0px auto;                    
    b, strong {
      display: block;
    }
    &.heading {                            
      margin: 0 auto 2%;
      padding: 0;                
      line-height: 0.8;
      position: relative;   
      text-transform: none;     
      font-weight: 400;        
      font-family: $font-heading-2;
      position: relative;                                                         
      -webkit-animation-duration: 1s;
      animation-duration: 1s;
      -webkit-animation-fill-mode: backwards;
      -moz-animation-fill-mode: backwards;
      -ms-animation-fill-mode: backwards;
      -o-animation-fill-mode: backwards;
      animation-fill-mode: backwards;
      -webkit-animation-iteration-count: 1;
      animation-iteration-count: 1;   

      img {
        width: auto;
        max-width: 100%;
      }
    } 
    &.subheading {         
      font-weight: 700;
      line-height: 0.8;
      margin: 0 auto 2%;      
      position: relative;  
      text-transform: none;         
      font-family: $font-heading;
      text-transform: uppercase;
      -webkit-animation-duration: 1s;
      animation-duration: 1s;
      -webkit-animation-fill-mode: backwards;
      -moz-animation-fill-mode: backwards;
      -ms-animation-fill-mode: backwards;
      -o-animation-fill-mode: backwards;
      animation-fill-mode: backwards;
      -webkit-animation-iteration-count: 1;
      animation-iteration-count: 1;
      span {
        color: $main-color;
      } 
    }
    &.cation {
      position: relative;        
      margin: 0;      
      padding: 10px 50px;    
      font-weight: 700;                      
      line-height: 1.2;              
      text-transform: uppercase;
      letter-spacing: 14px;
      display: inline-block;            
      -webkit-animation-duration: 1s;
      animation-duration: 1s;
      -webkit-animation-fill-mode: backwards;
      -moz-animation-fill-mode: backwards;
      -ms-animation-fill-mode: backwards;
      -o-animation-fill-mode: backwards;
      animation-fill-mode: backwards;
      -webkit-animation-iteration-count: 1;
      animation-iteration-count: 1;
      @include transparent($main-color, 0.4);

      img{
        width: auto !important;
        display: inline-block;
      }         
    }
    &.caption-link {
      margin: 2% 0 0px;
      position: relative;                
      -webkit-animation-duration: 1s;
      animation-duration: 1s;
      -webkit-animation-fill-mode: backwards;
      -moz-animation-fill-mode: backwards;
      -ms-animation-fill-mode: backwards;
      -o-animation-fill-mode: backwards;
      animation-fill-mode: backwards;
      -webkit-animation-iteration-count: 1;
      animation-iteration-count: 1;  
      .slider-button {            
        text-transform: uppercase;
        font-weight: 700;
        font-size: $font-small;
        line-height: 30px;
        padding: 0;
        display: inline-block;      
        .fa {
          display: inline-block;
          width: 20px;
          height: 20px;
          line-height: 18px;
          border-style: solid;
          border-width: 1px;
          margin: 0 10px 0 0;
          text-align: center;
          @include border-radius-circle;
        }  
        @media (max-width: 479px) {          
          font-size: 12px;
        }
      }
    }
  }
}
#home-slideshow {  
  .swiper-slide {
    margin: 0px auto; 
    text-align: center;
    overflow: hidden;      
    background: center center; 
    background-repeat: no-repeat;
    background-size: cover;  
    /*background: none !important;*/
    @include opacity(0 !important);
    @media all and (min-width:0\0) and (min-resolution:.001dpcm) {
      @include opacity(1 !important);	
    }
    &.swiper-slide-active {
      @include opacity(1 !important);
    }
    > a  {
      display: block;
      width: 100%;
      height: 100%;
      position: relative;
      z-index: 1;
      > img {
        width: 100%;      
        @include opacity(0);
      } 
    }
    &.has-video:hover {
      @media (min-width: 1025px) {
        .container{ 
          z-index: 4;
        }    
      }      
    }
  }
  .container {    
    height: 100%;
    max-width: 100%;
    z-index: 0;
    @include ab(0, 0, 0, 0);
  }
  .swiper-content {       
    padding: 0 15px;                
    margin: 0px auto;    
    z-index: 3; 
    width: 50%;
    text-align: center;
    @include ab(n, n, 20%, n);               

    &.text-center {
      left: 0; 
      right: 0;  
    }
    &.text-left {
      left: 0;      
    }
    &.text-right {
      right: 0;      
    }
  }

  &.flexslider {
    border: 0;
    margin-bottom: 0;
    border-radius: 0;
    -webkit-border-radius: 0;
    -moz-border-radius: 0;

    .flex-direction-nav{
      a{
        position: absolute; 
        top: 45%; 
        z-index:4; 
        display: block; 
        height: 40px; 
        width: 40px;
        @include border-radius(0, 0 , 0, 0); 
        border: none;
        text-align: center;         
        background: rgba(0, 0, 0, 0.3);
        &:before {
          display: block;          
          color: $white; 
          line-height: 40px; 
          text-align: center; 
          font-family: fontawesome;
          font-size: 20px;
        }
        &:hover {
          @include opacity(1);
          background: rgba(0, 0 ,0 , 0.5);
        }
      }

      a.flex-prev{
        left: 10px;
        &:before{
          content: "\f104";
        }

        &:hover:before{

        }
      }
      a.flex-next {
        right: 10px;
        &:before{
          content: "\f105";
        }       
      }       
    }
    .flex-control-nav {
      bottom: 4%;
      z-index: 10;
    }
    .slides > li {
      position: relative;     
    }
  }
  .cameracurrent , .flex-active-slide{
    .camera_caption > div{
      @include opacity(1);
      -webkit-transition: all 0.5s ease 0s;
      transition: all 0.5s ease 0s;
    }
  }
  .flex-control-paging li {
    a {
      width: 12px;
      height: 12px; 
      margin: 0px;     
      background-color: $white;
      border: 2px solid #333; 
      background: #333;
      @include border-radius(50%, 50% , 50%, 50%);
      position: relative;
      padding: 0; 
      @include opacity(0.6);
      &:hover, &.flex-active {
        border-color: $main-color; 
        background: $main-color;      
      }
    }
  }
}
.swiper-button-white {
  position: absolute; 
  top: 50%; 
  z-index:4; 
  display: block; 
  height: 60px; 
  width: 60px;  
  background-image: none;  
  border: none;
  text-align: center;         
  background: none;
  color: $white;   
  margin: 0;  
  @include transition(all 0.35s ease 0s);    
  @include translate(0, -50%);
  @include transparent($main-color, 0.5);
  @media all and (min-width:0\0) and (min-resolution:.001dpcm) {
    display: none \9;
  }
  &:before {
    display: block;          
    color: $white;    
    text-align: center; 
    font: 35px/60px FontAwesome;
    width: 100%;
    height: 100%;
  } 
  &.swiper-button-prev {
    background-image: none;
    left: 0px;    
    &:before{
      content: "\f104";
      text-align: center;
    }   
  }
  &.swiper-button-next {
    background-image: none;
    right: 0px;
    &:before{
      content: "\f105";
    } 
  }
  &.swiper-button-disabled {
    cursor: default;
    @include opacity(0 !important);        
  }
  @media (max-width: 767px) {
    width: 30px;
    height: 30px;
    &:before {
      line-height: 30px;
      font-size: 25px;
    }
  }
  &:hover {
    @include transparent($main-color, 1);      
  }
}
.home-slideshow-wrapper { 
  /*Hack css for slider only IE9*/  
  @media all and (min-width:0\0) and (min-resolution:.001dpcm) {
    .swiper-button-white {
      display: none \9 ;
    }    
  }
  .owl-controls {   
    .owl-nav {
      > div {       
        &.owl-next {    
          color: $white;
          left: auto !important;
          right: 0px !important;               
          position: absolute;
          top: 50%;
          z-index: 99;
          height: 60px; 
          width: 60px;    
          background-image: none;          
          @include transition(all 0.35s ease 0s);    
          @include translate(0, -50%);
          @include transparent($main-color, 0.5);
          text-align: center;         
          .fa {           
            &:before {
              display: block;          
              color: $white;    
              text-align: center; 
              font: 35px/60px FontAwesome;
              width: 100%;
              height: 100%;
              content: "\f105";
            }
          }         
        }
        &.owl-prev {    
          left: 0px !important;
          right: auto !important;             
          position: absolute;
          top: 50%;
          z-index: 99;
          height: 60px; 
          width: 60px;    
          background-image: none;          
          @include transition(all 0.35s ease 0s);    
          @include translate(0, -50%);
          @include transparent($main-color, 0.5);
          text-align: center; 
          .fa {           
            &:before {
              display: block;          
              color: $white;    
              text-align: center; 
              font: 35px/60px FontAwesome;
              width: 100%;
              height: 100%;
              content: "\f104";
            }
          }
        }
        &:hover {
          @include transparent($main-color, 1);
          .fa {
            &:before {
              color: $white;
            }
            &:hover {
              &:before {
                color: $white;
              }
            }
          }
        }
      }
    }
  }
}
.swiper-wrapper {  
  .owl-controls .owl-dots {
    @include ab(n, n, 6%, 0);
    margin: 0px auto;
    text-align: center;
    width: 100%;
    .owl-dot {
      margin: 0 5px !important;
      display: inline-block;
      line-height: 20px;
      span {          
        width: 12px !important;
        height: 12px !important; 
        margin: 0px;     
        background: $main-color;
        border: 1px solid $main-color; 
        @include border-radius-circle;
        @include opacity(0.5);
        position: relative;
        display: inline-block;
        padding: 0;                
      }
      &:hover,
      &:focus,
      &.active {
        span {  
          @include opacity(1);

        }
      }
    }
  }
}
.swiper-container-horizontal .swiper-pagination {
  border: 0;
  margin-bottom: 0;
  @include border-radius(0, 0, 0, 0);
  @include translate(0, -50%);
  width: auto;
  bottom: 5%;
  left: 50%;
  z-index: 10; 
  line-height: 20px;
  .swiper-pagination-bullet {
    width: 12px;
    height: 12px;
    margin: 0 5px !important;    
    background: none;
    border: 1px solid $button-btn1;
    background: $button-btn1;
    @include border-radius-circle;
    @include opacity(0.5);
    &:hover {
      border-color: $button-btn1;
      background: $button-btn1;
      @include opacity(1);
    }
    &.swiper-pagination-bullet-active {
      border-color: $button-btn1;
      background: $button-btn1;
      @include opacity(1);
    }
  } 
}

/*product grid*/
.spr-badge[data-rating="0.0"] {
  display: none;
}
.spr-badge-caption {
  display: none;
}

.owl-carousel {
  .owl-wrapper { display: none;}
  .owl-item {
    .product-grid-item { 
      width: 100% !important;
    }	
    img {
      transform-style: inherit;
      -webkit-transform-style: inherit;
      -moz-transform-style: inherit;	
      width: auto;
    }
  }
}
.product-grid-item {  
  margin: 0px;
  float: left;
  display: inline-block;     
  .product-type {
    margin: 0 0 18px;
    text-transform: uppercase;
    font-size: 10px;
    color: $body-light-color;
  } 
}
.product-wrapper {
  position: relative;
  padding: 0px;
  margin: 0px;  
  .product-head {
    .product-image {
      position: relative; 
      margin: 0 auto;
      padding: 0; 
      text-align: center;   
      
      .featured-img {
        overflow: hidden;
        position: relative;        
        text-align: center; 
        margin: 0px auto;
        {% if settings.enable_image_blance == true %}
        width: $image-width + px;    
        height: $image-height + px;
        max-width: 100%;        
        a {  
          height: 100%;
          width: 100%;                                 
          img {                                    
            @include ab(50% , 50%, n, n);
            @include translate(-50%, -50%);
            max-height: $image-height + px;
          }          
        }
        {% endif %}
        a {
          display: block;    
          position: relative;
          > span.hidden-sm {
            img {
              @include ab(50% , 50%, n, n);
              @include translate(-50%, -50%);
              @include opacity(0);              
              max-height: 100%;
            }
          }
        }
        img {            
          max-width: 100%;
          height: auto;              
          margin: 0px auto;                    
          display:inline-block;
          vertical-align: middle;  
          @include transition(all 0.35s ease 0s);
        } 
        &.switch-image {
          a {            
            img {              
              -webkit-transform-style: preserve-3d;
              -moz-transform-style: preserve-3d;
              transform-style: preserve-3d;
              -webkit-backface-visibility: hidden;
              -moz-backface-visibility: hidden;
              backface-visibility: hidden;
            } 
          }
          &:hover {
            @media (min-width: 1025px) {
              a {                         
                > img {
                  @include opacity(0);
                }
                 > span.hidden-sm {
                  img {
                    @include opacity(1);                 
                  }
                }            
              }
            }
          }         
        }
      } 
    }

    .wrapper-countdown {
      @include ab(n,1px,6px,1px);
      @include transition(all 0.35s ease 0s);
      @include opacity(0.5);      
      z-index: 2;
      text-align: center;      
      > div{
        border: 0;
        background: none;        
        color: #fff;
        font-size: $body-font-size;
        text-align: center;

        > span{
          font-weight: 400;
          display: inline-block;
          margin: 0 2px;
          padding: 5px 8px;
          font-size: 12px;
          background: $body-label-deal-background;
          color: $body-label-deal-color;          
        }
      }
    }   
    .product-button {       
      padding: 8px;      
      z-index: 1;
      width: 100%;
      background: $white;
      @include transition(all 0.35s ease 0s);
      @include opacity(0);
      @include translate(0, 10px);
      @include ab(n, 0, 0, 0);
      > div {
        padding: 0;
        display: inline-block;
        line-height: 25px;
        a {
          padding: 0 10px;
          line-height: 25px;
          color: $body-light-color;
          span {
            width: auto;
            &:before {
              margin: 0;
              font-size: 14px;
            }
          }
          &:hover {
            color: $main-color;
          }
        }
      }      
      .flaticon-interface-1 {
        position: relative;
        top: 1px;
        &:before {
          margin: 0;
          font-size: 16px;
        }
      }
      .add-to-wishlist {        
        width: auto;      
        height: auto;
        max-height: 25px;  
        text-align: center;        
      }
    }
  }
  .product-review {        
    margin: 0;  
    .spr-badge-starrating {
      float: none;
      margin: 0;
    }
  }  
  .product-content {   
    position: relative;      
    text-align: center;
    padding: 12px 0 0;
    .product-author {
      padding: 0 0 10px;
      > a {
        text-transform: uppercase;
        color: $body-light-color;
        font-size: $product-font-size - 2px;
        /*font-family: $font-heading;*/
        @media (max-width: 479px) {
          font-size: 12px;
        }
        &:hover {
          @media (min-width: 1025px) {
            color: $main-color;
          }
        }
      }
    }
    .swatch {
      margin: 5px auto 0;
      .header {
        display: none;
      }
      .tooltip {
        left: -42px;
        @include opacity(0);      	
      }
      .swatch-element {
        float: none;
        display: inline-block;
        margin: 1px;
        padding: 0;
        position: relative;
        input {      		
          width: 10px;
          height: 10px;
          z-index: 1;
          cursor: pointer;
          padding: 0;
          margin: 0;
          @include ab(0, 0, n, n);      		
          @include opacity(0);
          @include border-radius-circle;
        }
        label {
          display: block;
          width: 10px !important;
          height: 10px !important;
          line-height: 10px !important;      	 
          min-width: 10px !important;
          @include border-radius-circle;      	  
        }
        &:hover {
          @media (min-width: 1025px) {
            .tooltip {
              /*@include opacity(1);*/
            }
          }
        }
      }
    }
    .pc-inner{
      display: block;
      width: 100%;      
    }
    .product-description {
      display: none;
    }   
    .product-name {            
      color: $body-title-product;
      font-weight: 400;            
      font-size: $product-font-size;
      font-family: $font-standard;
      margin: 0 0 5px;     
      text-transform: none;
      @include transition(all 0.35s ease 0s);
      @media (max-width: 479px) {
        font-size: $product-font-size - 2px; 
      }
      a {
        color: $body-title-product;      
      }

      &:hover a {        
        color: $main-color;
      }
    }
    .product-type {
      margin: 0 0 18px;
      padding: 0;
      border: none;
      text-transform: uppercase;
      font-size: 10px;
      color: $body-light-color;
    }
    .product-descrip {
      display: none;
    }
    .product-price {   
      padding-top: 7px;    
      p {
        display: none;
      }      
      .price-compare {        
        display: block; 
      }
    }
  }
  &:hover {
    @media (min-width: 1025px) {
      .product-head,
      .product-head:hover {     
        .wrapper-countdown {        
          @include opacity(1);
        }
        .product-button {
          @include opacity(1);
          @include translate(0, 0);
        }      
      }    
    }
  }    
}
.product-price,
.sb-price {
  color: $body-price-color;   
  font-size: $size-h6;
  font-weight: 700;
  padding: 0px;  
  @media (max-width: 479px) {
    font-size: $size-h6 - 4px;
  }
}
.price-sale {
  color: $body-price-sale-color;     
  font-size:16px;/* $size-h6;*/
  font-weight: 700;
  @media (max-width: 479px) {
    font-size: $size-h6 - 4px;
  }
}

.price-compare {  
