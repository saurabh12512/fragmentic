          font-size: 10px;
          cursor: pointer;
          z-index: 1;
          &.global-product-info-qty-minus {
            @include ab(0, 0, n, n);
            .fa {
              width: 100%;
              height: 100%;         
              @include transition(all 0.35s ease 0s); 
              &:before {
                content: '';
                width: 11px;
                height: 1px;
                background: $body-title-color;
                display: block;
                @include ab(50%, 50%, n, n);
                @include translate(-50%, -50%);
              }
            }
          }
          &.global-product-info-qty-plus {
            @include ab(0px, n, n, 0);
            .fa {
              width: 100%;
              height: 100%;          
              @include transition(all 0.35s ease 0s);
              &:before,
              &:after {
                content: '';
                width: 11px;
                height: 1px;
                background: $body-title-color;
                display: block;
                @include ab(50%, 50%, n, n);
                @include translate(-50%, -50%);	        
              } 
              &:after {
                width: 1px;
                height: 11px;
              }
            }
          }
          &:hover{        
            i{
              background: $button-btn1;
              &:before,
              &:after {
                background: $button-btn1-txt !important;
              }
            }
          }
        }
      }  	  
    }
    .product-wrapper {    	
      display: table;
      table-layout: fixed;
      width: 100%;
