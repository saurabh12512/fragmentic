      width: 100%;
      margin-bottom: 50px;
      > div {
        display: table-cell;
        vertical-align: top;
        height: 100%;
        float: none;
      }
    }
  }
  .widget-newsletter,
  .footer-widget-social {
    background: $footer_social_bg;
    padding: 30px;
    margin: 0px;
    height: 100%;
    color: $footer-static-text-color;
    h5 {
      font-size: $size-h6 - 2px;
      margin: 0 auto 20px;
      color: $footer-title-color;
    }
    @media (max-width: 767px) {
      margin-bottom: 30px;
      padding: 20px;
    }
  }
  .widget-newsletter {
    text-align: left;
    position: relative;
    display: table;
    width: 100%;
    vertical-align: top;
    &:before {
      content: '';
/*       border: 2px dashed $white; */
      @include ab(10px, 10px, 10px, 10px);
    }
    form {
      display: block;
      position: relative;
      .form-control {
        width: 100%;
        padding-right: 75px;
      }
      .btn {
        @include ab(0, n, n, 0);
        padding: 6px 20px;
        color: $button-btn1-txt;
        border-color: $button-btn1-border;
        text-transform: uppercase;
        &:hover {
          color: $button-hover-btn1-txt;
          border-color: $button-hover-btn1-border;
        }
        @media (max-width: 767px) {
          margin: 0;
        }
      }
    }
  }
  .footer-widget-social {
    text-align: center;
    .widget-social-icons {
      display: table;
      width: 100%;
      table-layout: fixed;
      padding: 0 0 10px;
      li {
        display: table-cell;
        vertical-align: middle;  	
        padding: 0 0 10px;  	
        a {
          display: block;
          .fa {
            width: 40px;
            height: 40px;
            display: inline-block;
            line-height: 40px;
            color: $white;
            font-size: $size-h6;
            background: $main-color;
            @include border-radius-circle;
          }
          span {
            display: block;
            font-weight: 700;
            color: $footer-static-text-color;
            padding: 7px 0 0;
            @media (max-width: 991px) and (min-width: 768px) { 
              display: none;
            }
            @media (max-width: 479px) {
              display: none;
            }
          }
          &:hover {
            span {
              color: $footer-hover-color;
            }
          }
        }
      }
    }
  }
  .footer-image {
    > a {
      display: inline-block;
      margin: 0 5px;
      max-width: 45%;
    }
  }
  .block-menu {
    padding: 11px 0;
    background: $footer_menu_bg;
  }
}

/* Footer Style #3 */
.footer-style-3 {
  .footer-widgets {
    .container {
      position: relative;
      &:after {
        content: '';
        height: 1px;
        @include transparent($footer-static-text-color, 0.4);
        @include ab(n, 15px, 0, 15px);
      }
    }
  }
  &#footer-content {
    padding-top: 75px;
  }
  .footer-block {
    margin: 0 0 50px;  	
    h3 {
      font-size: $size-h1 + 2px;
      margin: -3px auto 10px;
      color: $footer-title-color;
    }
    h4 {
      font-size: $size-h6 - 2px;
      margin: 0 auto 23px;
      color: $footer-title-color;
    }  	
    .slider-button {
      text-transform: uppercase;
      padding: 0 40px;
      margin: 43px 0 0;
      color: $footer-title-color;
      font-size: $font-small;
      line-height: 40px;
      font-weight: 700;
      display: inline-block;
      border-top: 1px solid rgba($footer-link-color, 0.4);
      border-bottom: 1px solid rgba($footer-link-color, 0.4);
      &:hover {
        color: $footer-hover-color;
        border-top-color: rgba($footer-hover-color, 0.4);
        border-bottom-color: rgba($footer-hover-color, 0.4);
      }
    }
  }
  .content {
    color: $footer-static-text-color;
    .list-links {
      li {
        padding: 0 0 5px;
        a {
          color: $footer-link-color;
          &:hover {
            color: $footer-hover-color;
          }
        } 
        &:last-child {
          padding-bottom: 0;
        } 	  	
      }
    }
  }
  .col-sm-6 {
    @media (max-width: 991px) and (min-width: 768px) {
      &:nth-child(2n + 1) {
        clear: both;
      }
    }
  }
}

