      border-color: $body-label-sale-background;
      @include rotate(45);

    }

    &.label-deal {    
      color: $body-label-deal-color;
      background-color: $body-label-deal-background;  
      border-color: $body-label-deal-background;          
    }
    &.label-new {
      left: -40px;
      color: $body-label-new-color;
      background-color: $body-label-new-background;
      border-color: $body-label-new-background;
      @include rotate(-45);
    }
    &.label-bp {
      left: -40px;
      font-size: 8px;
