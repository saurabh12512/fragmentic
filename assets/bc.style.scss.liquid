        font-size: 10px;
        cursor: pointer;
        font-weight: 400;
        text-align: center;
        z-index: 1;
        @include ab(0, n, n, n);
      }
        .global-product-info-qty-minus {
        left: 0;
      }
        .global-product-info-qty-plus {
