      .cart-item-info {
        padding-left: 120px;
        @media (max-width: 400px) {         
          padding-left: 80px;
        }
      }
      .cart-close {
        @include ab(0px, n, n, 0);
        width: 20px;
        height: 20px;
        line-height: 20px;
        text-align: right;
        &:before {
          content: "\f014";
          font-family: FontAwesome;
          font-size: 14px;
          color: #999;
          display: block;
