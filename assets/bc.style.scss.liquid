  font-weight: 400;
  @media (max-width: 479px) {
    font-size: $size-h6 - 4px;
  }
}

.product-label {  
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;    
  > span {       
    display: inline-block;
    float: left;
    clear: both;
    text-align: center;
    padding: 0;
    margin: 0;       
    border: none;        
    z-index: 1;
    width: 80px;
    height: 80px;
    line-height: 135px;
    @include ab(-40px, 0, n, n);

    &.label-sale {    
