.panel-group{
  margin: 0; padding: 0px;
  clear: both;
  .panel{
    border-radius: 0;
    border: 0;
    margin: 0;
    box-shadow: none;
    background: none;
    padding: 0px;
    .collapse  {
      border-top: 1px solid $body-border-color;
    }
    .panel-heading{
      background: none;           
      text-transform: uppercase;
      padding: 0;
      border-top: 1px solid $body-border-color;

      .panel-title{
        color: $body-title-color;
        font-size: $font-medium;
        font-weight: 700;
        font-family: $font-heading;
        padding: 7px 0;
        a{
          color: $body-title-color;
          font-size: $font-medium;
          font-weight: 700;
          font-family: $font-heading;
          text-transform: uppercase;
          display: block;                           
          position: relative; 
          padding-right: 45px;  
          line-height: 30px;          
          @include transition(all 0.35s ease 0s);
          &:after {
            content: "\f106";
            float: left;            
            @include ab(0, n, n, 15px);
            height: 30px;
            width: 30px;
            line-height: 28px;
            text-align: center;
            color: $body-title-color;  
            font-size: 16px;
            font-family: FontAwesome;
            border: 1px solid $body-title-color;
          }      
          &.collapsed {
            color: $body-title-color; 
            &:after {
              content: "\f107";
              float: left;            
              @include ab(0, n, n, 15px);
              height: 30px;
              width: 30px;
              line-height: 28px;
              text-align: center;
              color: $body-title-color;  
              font-size: 16px;
              font-family: FontAwesome;
              border: 1px solid $body-title-color;
            }
          }
          &:hover{            
            color: $body-title-color;             
          }         
        }
      }
    }
    .panel-collapse {
      > .panel-body, > .list-group{
        border: none;
        padding: 15px 0;
        background: none;
      }
    }
    + .panel{
      margin-top: 0;
    }

    .panel-body {   
      font-size: $body-font-size;
      line-height: 24px;      
      iframe{
        max-width: 100%;
      }
      ul {
        li {
          padding: 3px 0;
        }
      }
    }
    &:last-child {
      padding-bottom: 0;
      border-bottom: 1px solid $body-border-color;
    }
  }
}

.spr-icon { 
