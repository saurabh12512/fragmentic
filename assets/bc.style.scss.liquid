.product-bundled {
  .bundled-items {
    > h3 {
      text-transform: none;
      font-size: $body-font-size + 2px;			
      font-family: $font-standard;
      margin: 30px 0 15px;
    }
    .product-qty {						
      .global-qty-wrapper {
        float: left;
        position: relative;	
        > span {
          width: 25px;
          height: 40px;
          text-align: center;
          padding: 0px;      
          font-weight: 400;
          cursor: pointer;
          display: inline-block;
          line-height: 40px;
          font-size: 10px;
        }
        .global-product-info-qty-minus {
          left: 0;
          @include ab(0, 0, n, n);
          @include border-radius-reset;          
          .fa {
            width: 100%;
            height: 100%;         
            @include transition(all 0.35s ease 0s); 
            &:before {
              content: '';
              width: 11px;
              height: 1px;
              background: $body-title-color;
              display: block;
              @include ab(50%, 50%, n, n);
              @include translate(-50%, -50%);
            }
          }
          &:hover{        
            i {
              background: $button-btn1;
              &:before,
              &:after {
                background: $button-btn1-txt !important;
              }
            }
          }
        }
        .global-product-info-qty-plus {
          right: 0;
          @include ab(0px, n, n, 0);
          @include border-radius-reset;          
          .fa {
            width: 100%;
            height: 100%;          
            @include transition(all 0.35s ease 0s);
            &:before,
            &:after {
              content: '';
              width: 11px;
              height: 1px;
              background: $body-title-color;
              display: block;
              @include ab(50%, 50%, n, n);
              @include translate(-50%, -50%);	        
            } 
            &:after {
              width: 1px;
              height: 11px;
            }
          }
          &:hover {        
            i {
              background: $button-btn1;
              &:before,
              &:after {
                background: $button-btn1-txt !important;
              }
            }
          }
        }
      }		
      input[type="text"] {
        border: 1px solid $body-border-color;												
        width: 100px;
        text-align: center;
        height: 40px;
        padding: 10px 30px;				
      }			
    }
    .image-bundled {
      display: table;
      table-layout: fixed;			
      vertical-align: middle;
      margin: 0 0 20px -20px;
      @media (max-width: 767px) {
        max-width: 445px;
      }
      > div {
        display: table-cell;
        vertical-align: middle;
        width: 25%;
        position: relative;
        padding: 0 15px 0 20px;
        &.ib {
          > span {					
            width: 20px;	
            color: $main-color;
            font-size: 10px;				
            @include ab(50%, 0, n, n);
            @include translate(0%, -50%);
          }					
        }
        &.bundled-total-price {
          padding: 0;
          span {
            display: block;
            font-weight: 700;
            text-align: center;
            color: $body-title-color;
          }
          .total-price {
            span {
              color: $main-color;
            }
          }
        }
      }			
    }
    .product-default {
      display: table;
      table-layout: fixed;
      margin: 0 0 15px;
      > div {
        display: table-cell;
        vertical-align: middle;				
      }
      .title {
        padding: 0 20px 0 0;
        > span {
          display: inline-block;
          color: $body-title-color;
        }
        h4 {
          text-transform: none;
          font-size: $body-font-size;			
          font-family: $font-standard;
          line-height: 1.4;
          display: inline-block;
        }
      }
      .price-default {
        .price-compare {
          font-size: $body-font-size
        }
        .price {
          color: $main-color;
          font-weight: 700;
          font-size: $body-font-size;
        }
      }
    }
    .bundled-item {			
      margin: 0 0 10px;
      position: relative;
      padding: 0 0 0 25px;
      &.product-action {
        padding: 0;
        margin: 0;
      }
      input[type="checkbox"] {
        @include ab(0, 0, n, n);
        cursor: pointer;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        width: 25px;
        height: 25px;
        border: none;
        margin: 0;
        outline: 0;
        outline-offset: 0; 
        background: none;
        @include box-shadow(0 0 0 $white);
        @include transition(all 0.35s ease 0s); 
        &:after {
          content: '';
          border: 1px solid $body-border-color;
          width: 15px;
          height: 15px;
          @include ab(1px, 0, n, n);
        }
        &:before {
          content: "\f00c";
          width: 15px;
          height: 15px;
          line-height: 15px;
          text-align: center;
          color: $main-color;
          font-family: FontAwesome;
          font-size: 10px;
          @include ab(1px, 0, n, n);
          @include opacity(0);
        }
      }
      input[type="checkbox"]:checked {
        &:after {
          border-color: $main-color;
        }
        &:before {
          @include opacity(1);
        }
      }
      .b-info {												
        display: table-cell;
        vertical-align: middle;
        h4 {
          padding: 0 20px 0 0;
          text-transform: none;
          font-size: $body-font-size;			
          font-family: $font-standard;
          display: table-cell;
          font-weight: 400;
          line-height: 1.3;
        }
      }
      .bundled-price {
        display: table-cell;
        white-space: nowrap;
        .price-compare {
          font-size: $body-font-size
        }
        .price {
          color: $main-color;
          font-weight: 700;
          font-size: $body-font-size;
        }
      }
      &:hover {
        @media (min-width: 1025px) {
          input[type="checkbox"] {
            &:after {
              border-color: $main-color;
            }
            &:before {
              @include opacity(1);
            }
          }
        }
      }
    }
    .action-button {
      margin: 20px auto 25px;
    }
  }
}

