        &:hover{ 
          @media (min-width: 1025px) {
            a{
              color: $main-color;            
            }
          }          
        }
        &.active{          
          a{
            cursor: default;
            color: $main-color;           
          }
        }
        &:last-child {
          border-bottom: none;          
        }
      }
    }
    &:hover {
      #sort_by_box {
        visibility: visible;
        z-index: 99;          
        @include opacity(1);  
        @include translate(0%, 0px);
      }
    }
    @media (max-width: 1024px) {
      .dropdown-backdrop {
      	display: none;
      }
      .sort-by-inner {
        &.open {
        	#sort_by_box {
            visibility: visible;
            z-index: 99;          
            @include opacity(1);  
            @include translate(0%, 0px);
          }
        }
      }
    }
  }
  .show-by {
    float: left;
    margin: 0 4% 10px 0;
    position: relative;
    #cata_show_by {
      .title {
        float: left;
        line-height: 40px;
        padding: 0 7px 0 0;
      }
      #show_by_button {
        border: 1px solid $body-border-color;
        background: $white;
        outline: none;
        padding: 0 10px;
        line-height: 38px;
        @include border-radius-reset;
        .fa {
          font-size: 13px;
        }
      }
    }
    .dropdown-menu {
      width: auto;
      left: auto;
      right: 0;
      min-width: 85px;
      background: $white;     
      border: 1px solid $body-border-color;
      padding: 10px 15px;
      display: block;  
      visibility: hidden;
      z-index: -99;
      @include translate(0%, 10px);  
      @include opacity(0);
      @include  transition(all 0.35s ease);
      li{
        padding: 0;
        text-align: center;
        margin-bottom: 0; 
        border-bottom: 1px solid $border-menu;
        a {
          padding: 6px 0;
          line-height: 1.5;
          display: block;
          transition: none;                               
          font-size: $body-font-size;
          color: $body-light-color;
        }
        &:hover{     
          @media (min-width: 1025px) {
            a{
              color: $main-color;            
            }
          }	        
        }
        &.active{          
          a{
            cursor: default;
            color: $main-color;           
          }
        }
        &:last-child {
          border-bottom: none;          
        }
      }
    }
    &:hover{
      .dropdown-menu {
        visibility: visible;
        z-index: 99;          
        @include opacity(1);  
        @include translate(0%, 0px);
      }
    }
  }
  .top-pagination-holder {
    float: right;
    margin: 0 0 10px 0;
    > span {
      float: left;
      line-height: 40px;
      padding: 0 7px 0 0;
    }  
    .pagination {
      float: left;
    }	
  }
  .visible-xs{
    cursor: pointer;               
  }
}
.mobile-filter {
  text-align: center;  
  color: $white;
  background: $main-color;
  margin: 0px auto;  
  float: left;
  line-height: 40px;
  padding: 0 20px 0 15px;
  .fa {
    margin-right: 8px;
  }
}
.pagination {
  margin: 0;
  @include border-radius-reset;  	
  > li {
    > a,
    > span {
      border: none;
      padding: 0 6px;
      color: $body-light-color;
      background: none;
      line-height: 40px;	
      .fa {
        font-size: 13px;
      }
      &:focus,
      &:hover {  
        background: none;
        color: $main-color;
      }
    }
    &.disabled {
      display: none;
    }
    &.active {
      > a,
      > span {
        background: none;
        color: $main-color;
        &:focus,
        &:hover {  
          background: none;
          color: $main-color;
        }
      }
    }
    &:focus,
    &:hover {      
      > a,
      > span {
        background: none;
        color: $main-color;
      }      
    }
  }	
}
.cata-product {
  display: block;
  margin: 0px -15px;  
  padding: 40px 0 0;
  letter-spacing: -0.31em;
  vertical-align: top;
  clear: both;
  @media (max-width: 767px) {
    padding-top: 25px;
  }
  @media (max-width: 479px) {
    margin: 0 -7px;
  }
  &.cp-list {
    margin: 0px auto;
    letter-spacing: 0;
  } 
  .product-grid-item {     
    padding: 0px 15px;
    margin: 0 0 45px;   
    letter-spacing: 0;
    vertical-align: top;
    float: none;   
    display: inline-block;   
    @media (max-width: 767px) {
      width: 50%;
      margin-bottom: 35px;   
    } 
    @media (max-width: 479px) {
      padding: 0 7px;
    }
    &.number-2 {
      @media (min-width: 768px) {
        width: 50%;
      }      
    }
    &.number-3 {
      @media (min-width: 768px) {
        width: 33.333%;                       
      } 
    } 	
    &.number-4 {
      @media (min-width: 768px) {
        width: 25%;
      }    
    }
    &.number-5 {
      @media (min-width: 991px) {
        width: 20%;                   
      }
      @media (max-width: 991px) and (min-width: 768px) {         
        width: 25%;
      }      
    }
    &.number-6 {
      @media (min-width: 768px) {
        width: 16.666666%;              
      }
      @media (max-width: 1199px) and (min-width: 768px) { 
        width: 20%;          
      }
    }
  }
  .no-product {
    letter-spacing: normal;
    text-align: center;
    font-weight: bold;
    font-size: 15px;
    color: black;
  }
  .go-back {
  	text-transform: uppercase;
    text-align: center;
  }
}
.available {
  color: $main-color;
  font-weight: 600;
}
.not-available {
  color: $main-color;
  font-weight: 600;
}
.product-list-item {  
  clear: both;
  padding: 0px;
  margin: 0 0 50px; 
  width: 100%;  
  letter-spacing: 0;
  .product-wrapper {
    float: none;
    display: table;
    width: 100%;       
    table-layout: fixed;
    border: 1px solid transparent;
    @include transition(all 0.35s ease 0s);
    .product-head {
      display: table-cell;
      vertical-align: top;
      width: auto;
      padding: 0 30px 0 0;
      margin: 0;    
      position: relative;  
      width: 270px; 
      @media (max-width: 479px) {
        padding-right: 15px;      	
        width: 50%;
      }          
    }
    .product-image {      
      position: relative;
      overflow: hidden;
      padding: 0;
      max-width: 270px;
    }
    .product-content {
      text-align: left;
      display: table-cell;
      vertical-align: top;
      padding: 10px 0 0;      
      &:before {
        content: none;
      }    
      .add-cart-button {
        position: static;
        margin: 20px 0 0;
        padding: 0;
        text-align: left;
        background: transparent;
        @include opacity(1);
        .btn-default {
          @media (max-width: 479px) {
            padding: 5px;
            font-size: 14px;
          }        	
        }
      }      
    }
    .product-review {      
      min-height: 0;
      display: block;      
    }
    .wrapper-countdown {
      @include ab(n, 0px, 6px, 0px);      
      z-index: 2;
      @include opacity(1);
      > div{
        text-align: center;       
        padding: 0;
        margin: 0;
        background: none;
        border: none;
        span {
          margin: 0 5px;
          padding: 5px;
          display: inline-block;
          background: $body-label-deal-background;
          color: $body-label-deal-color;
          font-size: 12px;
          font-weight: normal;          
        }
      }      
    }
    .pc-inner {     
      .product-name {  
        height: auto !important;        
      }  
      .only-list {
        display: block;
        padding: 20px 0 0; 
        line-height: 1.5;
        color: $body-light-color;
        @media (max-width: 479px) {
          display: none;
        }
      }
    } 
    &:hover {
      background: $body-second-color;  
      border-color: $body-border-color;
      .product-content {      	      	       
        .product-price,
        .product-review {
          @include opacity(1);
        }        
      }
    }    
  } 
  @media (max-width: 767px) {
    margin-bottom: 30px;
  }
}
.pagination-holder {  
  .pagination {
    margin: 25px auto 0px;
    display: block;
    @include border-radius(0, 0, 0, 0);
    background: none;
    padding: 0;        
    text-align: center;    
    > li {
      margin: 0 auto 5px;
      display: inline-block;      
      > a,
      > span {
        display: inline-block;        
        padding:0;
        background: none;           
        border: 1px solid $body-border-color;   
        margin: 0px 4px;
        line-height: 38px;
        width: 40px;
        height: 40px;
        font-size: $size-h5;
        color: $body-title-color;        
        &.prev, &.next {               
          text-align: center;          
          width: auto;      
          padding-left: 15px;
          padding-right: 15px;
          text-transform: uppercase;
          font-family: $font-heading;
          color: $body-title-color; 

        }       
        &.disabled {
          @include opacity(0.7);
          cursor: no-drop;
          display: none;
        }
      }
      &:hover {       
        > a,
        > span {                    
          @media (min-width: 1025px) {
            color: $button-btn1-txt;           
            background: $button-btn1;           
          }
        }
      }      
      &.active {        
        > a,
        > span {          
          color: $button-btn1-txt;           
          background: $button-btn1;         
        }
      }
      &:first-child,
      &:last-child {
        > a, span {
          @include border-radius-reset;
        }
      }
    }
  }
}
/*end category page*/

/*Collection page*/
.category {    
  border: none;
  margin-bottom: 40px;      
  position: relative;  
  .category-name {
    text-transform: uppercase;
    font-family: $font-heading;
    font-size: $body-font-size +  2px; 
    font-weight: 700;      
    line-height: 1.2;
    display: block;
    margin: 25px 0 6px;          
    &:hover {   
      color: $main-color;   
    }
  }
  .detail-text {
    p {
      margin: 0;
    }
  }
  .category-image {
    text-align: center;    
    > a {
      display: block;
      position: relative;      
      &:before {
        @include before;
      }     
      &:hover {
        &:before {
          @include hover-before;
        }       
      }
    }
  }
  .button-in {
    @include opacity(0);
    @include ab(30%, 50%, n, n);
    @include translate(-50%, -50%);
    @include transition(all 0.35s ease 0s);  
    z-index: 2;
    @media (max-width: 1024px) {
      @include opacity(1);
      top: 50%;
    }
    a {
      display: inline-block;
      color: $white;
      padding: 5px 40px;
      line-height: 30px;
      text-transform: uppercase;
      font-size: $body-font-size;
      white-space: nowrap;
      border-top: 1px solid rgba($white, 0.4);
      border-bottom: 1px solid rgba($white, 0.4);  	
      @media (max-width: 1024px) {
        padding-left: 20px;
        padding-right: 20px;  			
      }	
    }  	
  }
  .tb-image {
    position: relative;
    &:before {
      @include before;
      @media (min-width: 1025px) {
         display: none;
      }
    }  	  	
    &:hover {
      @include opacity(1);  	  
      &:before {
        /*@include hover-before;*/
      }
      .button-in {
        top: 50%;
        @include opacity(1);
      }
    }
  }
}
.collection-item {
  @media (min-width: 992px) { 
    &:nth-child(3n + 1) {
      clear: both;
    }
  }
  @media (max-width: 991px) { 
    &:nth-child(2n + 1) {
      clear: both;
    }
  }  
}
.lookbooks-wrapper {  
  clear: both;
  margin-bottom: -50px;
  @media (max-width: 767px) {
    margin-bottom: -30px;
  }
  .bc-lookbooks {
    margin: 0 -15px;
    letter-spacing: -0.5em;
    vertical-align: top;
  }
  .look-item {
    padding: 0 15px;
    letter-spacing: 0;
    vertical-align: top;
    display: inline-block;
    float: none;
    text-align: center;
    background: none !important;
    width: 33.333333%;
    position: relative;
    margin: 0px auto 30px;
    @media (max-width: 500px) {
      width: 100% !important;
    }
    .look-point {  
      width: 40px;
      height: 40px;  	   
      position: absolute;  	   
      cursor: pointer;
      display: block;
      @include transparent($main-color, 0.7);
      @include transition(all 0.35s ease 0s);  
      &:before {
        content: '+';  	     
        color: $white;
        width: 100%;
        height: 100%;
        text-align: center;
        display: block;
        line-height: 40px;
        font-size: 45px;
      }
      .look-info {
        background: #fff;
        padding: 5px;
        width: 115px;  	
        z-index: -1;  
        height: 0;
        @include ab(150%, -30px, n, n);
        @include box-shadow(0 0px 4px rgba(#c9c9c9, 0.75));  
        @include opacity(0);	 
        @include transition(all 0.35s ease 0s);   		  	
      }
      .look-product-name {
        a {
          display: block;
          line-height: 1.2;
        }
      }
      &:hover {
        /*@media (min-width: 1025px) {*/
        @include transparent($main-color, 1);
        .look-info {
          height: auto;
          @include opacity(1);
          top: 100%;
          z-index: 9;
        }  	  	  
        /*}  	*/  
      }
    }
    &.double {
      width: 66.666666%;
    }  	
  }
}
/*End collection page*/

/* Page search ------------------------------------------*/
.page-search {
  > h4 {    
    margin-bottom: 30px;    
    text-align: center;
  }
  .cata-product {
    padding: 0;
    margin: 0;
    @media (max-width: 479px) {
      padding-left: 7px;
      padding-right: 7px;
    }
    .product-grid-item {
      .product-review {
        min-height: 0;
      }
      @media (min-width: 992px) {
        width: 25%;
        &:nth-child(4n + 1) {
          clear: both;
        }
      }
      @media (max-width: 991px) and (min-width: 768px) {
        width: 33.333%;
        &:nth-child(3n + 1) {
          clear: both;
        }
      }
      @media (max-width: 767px) {
        width: 50%;
        &:nth-child(2n + 1) {
          clear: both;
        }
      }
    }
  } 
  .article-grid-item {  
    width: 50%;     
    float: left;    
    padding: 0 15px;
    .post-item {          
      .post-des {
        padding: 0 0 15px;        
        font-size: $font-small;
        color: $body-light-color;
        font-weight: 300;
        line-height: 1.6;
      }      
    }    
    @media (min-width: 992px) {
      width: 33.333333%;       
      &:nth-child(3n+1)  {
        clear: both;
      }    
    }
    @media (max-width: 991px) {
      &:nth-child(2n+1) {
        clear: both;
      }
    }
    @media (max-width: 479px) {
      width: 100%;
      clear: both;
    }
  } 
}

