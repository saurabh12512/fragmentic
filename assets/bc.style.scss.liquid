    .subtotal {      
      overflow: hidden;      
      display: inline-block;            
      width: 100%;
      padding: 0 0 5px;
      line-height: 28px;
      font-family: $font-heading;
      font-size: $font-medium;
      text-transform: uppercase;      
      font-weight: 700;
      > span:first-child {        
        margin-right: 10px;  
        color: $body-title-color;          
      }
      .cart-item-total-price {                              
        font-size: $size-h6;
        color: $body-title-color;
        float: right;
      }

    }
    .action {
      padding: 0;
      overflow: hidden;
      .btn {
        width: 140px;
        line-height: 25px;
        padding: 9px 10px;
        margin: 10px auto 0;
        @media (max-width: 400px) {
          width: 48%;
          padding: 9px 5px;
        }
      }      
      .btn-default {
        float: right;
      }
    }
  }
}
.cart-dd {
  visibility: hidden;
  /*display: none;*/
  z-index: -9999;  
  display: block;
  @include opacity(0);
  @include translate(0, 10px); 

  #cart-info {
    max-height: 560px; 
    overflow-y: auto;
  }
}

.cart-sb {  
  position: fixed;  
  top: 0px!important;
  right: 0px !important;  
  z-index: 9999999;
  height: 100%;
  display: block;
  @include translate(470px, 0);
  @include box-shadow(0 0 0 #fff !important);
  -moz-transition: all 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  -o-transition: all 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  -webkit-transition: all 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  transition: all 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);    
  .cart-content {
    opacity: 0;
    visibility: hidden;    
    @include transition(all 0.2s ease-out 0s); 
  }  
  #cart-info {
    border: 0;
    padding: 0;
    height: 100%;
    overflow: auto;
    .cart-item-empty {      
      padding-top: 10px;
      text-align: left;
    }        
  }
  .c-close  {
    position: absolute;
    left: -30px;
    top: 0;
    width: 30px;
    height: 30px;
    line-height: 26px;
    text-align: center;
    border: 2px solid $main-color;
    color: $white;
    background-color: $main-color;
    z-index: 999; 
    cursor: pointer;
    @include opacity(0);
  }
  &.opened {
    @include translate(0px, 0);    
    margin-top: 0px !important;
    .c-close {
      @include opacity(1);
    }
    .cart-content{
      opacity: 1;
      visibility: visible;
    }   
  }
}

body.cart-opened #page-body:before {
  background: rgba(0,0,0,0.8);
  content: "" !important;
  display: inline-block !important;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99999;
}


.navmenu-shopping-cart {
  .btn {min-width: 180px;}
}

