    .share-links {
      clear: both;
      padding: 35px 0 0;
      text-align: center;
      overflow: hidden;
      @media (max-width: 767px) {
        padding-top: 15px;
      }
      .share-label {
        display: inline-block;
        font-size: $font-medium;      
        color: $body-title-color;
        font-weight: 700;		
        text-transform: uppercase; 
        line-height: 45px;
        padding: 0 10px 0 0;		
      }  
      .list-inline {
        display: inline-block;
      }
    }   
  }

  .product-info { 
    position: relative;
    margin-bottom: 30px; 
    h1[itemprop="name"] {      
      font-weight: 700;        
      text-align: left; 
      font-size: $product-detail-title-size;      
      margin: 0 0 15px;      
      text-transform: none;        
    }
    .author {
      padding: 0 0 12px;
      margin: 0;
      font-size: $body-font-size;      
      color: $body-light-color;
      overflow: hidden;
      text-transform: uppercase;      
    }
    .rating-links {     
      margin: 10px 0px 15px;
      line-height: 20px;
      white-space: 	nowrap;	
      overflow: hidden;
      > a {
        color: $body-light-color;      	      	
      }
    }
    .rating-links-all-reviews {     
      margin: 8px 0px 8px;
      line-height: 20px;
      white-space: 	nowrap;	
      overflow: hidden;
      > a {
        color: $body-light-color;      	      	
      }
    }
    .detail-deal {
      display: block;     
      text-align: center;
      .deal-text {
        font-weight: 700;
        display: block;
        line-height: 28px;
        padding: 0 0 10px;
      }
      .wrapper-countdown {
        margin: -7px 0 30px;        
        > div{
          text-align: center;
          margin: 0;
          padding: 0;
          background: none;
          border: none;
          .countdown-row {
            display: block;
          }
          .countdown-section {
            margin: 0 15px;
            padding: 0;
            display: inline-block; 
            float: none;
            width: auto; 
            position: relative;
            @media (max-width: 479px) {
              margin: 0 7px;
            }
            &:before {
              content: ':';
              color: $body-title-color;
              font-size: 30px;
              font-weight: 700;
              line-height: 1.2;
              @include ab(0px, n, n, -17px);
              @media (max-width: 479px) {
                font-size: 26px;
                right: -8px;
              }
            }
            &:last-child {
              &:before {
                content: none;
              }
            }
          }
          .countdown-amount {
            display: block;
            color: $body-title-color;
            font-size: 30px;
            font-weight: 700; 
            line-height: 1.2;            
            @media (max-width: 479px) {
              font-size: 26px;
            }
          }
          .countdown-period {
            display: block;
            color: $body-title-color;
            font-size: $font-medium;
            font-weight: 700; 
            text-transform: uppercase;   
            @media (max-width: 1199px) and (min-width: 992px) {
              font-size: 12px;
            }         
            @media (max-width: 479px) {
              font-size: 12px;
            }
          }
        }
      }
    }
    .product-detail-review {
      margin: 0 0 15px;
      display: inline-block;
      > a {
        margin-left: 8px;
        font-size: 13px;        
        &:hover {
          color: $main-color;
        }
      }
    }
    .product-availability-wrapper {
      margin: 0 0 15px;
      ul {
        li {
          line-height: 22px;
          color: $black;
          position: relative;
          padding: 0 0 0 100px;
          span:first-child {
            color: $body-light-color;
            padding: 0 5px 0 0;
            @include ab(0, 0, n, n);
          }
        }
      }
    }   
    .short-description {
      padding: 0 0 20px;      
      line-height: 1.6;
      color: $body-light-color;
      h5 {
        display: none;
      }                
    }
    .spr-badge {
      margin: 0 15px 0 0;         
      display: inline-block;   
      float: left;     
      position: relative;
      &:after {
        content: '';
        width: 1px;
        height: 12px;
        background: $body-light-color;
        @include ab(4px, n, n, -8px);
      }
      .spr-badge-caption {
        float: left;    
        display: inline-block;                       
        &:before{
          content: "(";
        }
        &:after{
          content: ")";
        }
      }      
    }   
    .price-preview-container {
      overflow: hidden;
    }
    .group-wlcp {
      overflow: hidden;
      margin: 0;      
      .add-to-compare,
      .add-to-wishlist {        
        float: left;
        padding: 0;
        margin: 0;
        line-height: 28px;
        background: none;
        border: none;
        width: auto;
        height: 28px;
        min-width: 40px;
        color: $body-title-color;
        font-size: $body-font-size;
        font-family: $font-standard;
        text-transform: none;    		
        letter-spacing: 0;
        font-weight: normal;
        @include border-radius-reset; 	
        span {
          height: 100%;
          width: auto;
          float: left;
          &:before {
            margin: 0 7px 0 0;
            font-size: 14px;
            line-height: 28px;
          }
        }	
        &:hover {
          color: $main-color;
        }        
      }
      .add-to-wishlist {
        margin-right: 15px;
      } 
    }
    .secure-image {
      overflow: hidden;
      margin: 0 auto 20px;
      img {
        float: left;
        max-width: 45%;
        &:first-child {
          margin-right: 5%;
        }
      }
      @media (max-width: 767px) {
        margin-bottom: 0;
      }
    }
    #stock {      
      clear: both;
      font-size: 12px;
      color: $body-title-color;
      text-transform: uppercase;             
      line-height: 16px;
      margin: 10px 0 15px;
      > span {
        display: block;
        text-align: center;                
        font-weight: 700;
        color: $body-title-color;
        font-size: $font-medium;
      }
      .fa {
        margin-right: 8px;
      }
    }
    .product-code {      
      color: $body-title-color;
      text-transform: uppercase;      
      margin: 10px 0 5px;
      overflow: hidden;
      line-height: 28px;
      span {
        &:first-child {
          float: left; 
          margin: 0;          
          /*width: 110px;
          font-size: 14px;
          text-transform: uppercase;        */  
          font-weight: 700;
          color: $body-title-color;
        }
      }
    }
    .group-price-sale {
      overflow: hidden;
      margin: 0 0 15px;
      padding: 0 0 15px;
      border-bottom: 1px solid #f0f0ed;    
    }
    .sale-detail {
      float: left;
      border: 2px solid $body-label-sale-background;
      color: $body-label-sale-background;
      text-transform: uppercase;
      font-size: $body-font-size;
      padding: 0px 20px;
      line-height: 26px;
      @media (max-width: 479px) {
        padding: 0 10px;
      }
    }
    .product-price {        
      text-align: left;     
      border: none;   
      line-height: 30px;   
      float: left;             
      padding: 0;
      margin: 0 40px 0 0;
      @media (max-width: 479px) {
        margin-right: 20px;
      }
      .price-sale {              
        line-height: 30px;       
        display: inline-block;    
        font-size: $size-h3;
        float: left;
      }
      .price {                    
        text-align: left;
        padding: 0;
        border: none;      
        overflow: hidden;                         
        margin: 0;
        float: left;
        font-size: $size-h3;
      }
      .price-compare { 
        margin-right: 10px; 
        line-height: 30px;        
        display: inline-block;                   
        font-size: $size-h6;
        float: left;
      }
    }    
    .custom-filed {
      color: #0c9c16;
      margin: 0 0 10px;
    }
    .group-cw {
      position: relative;
      display: block;
      width: 100%;
      margin: 0;   
      clear: both;   
    }
    .swatch {      
      margin: 0px 0 10px;
      position: relative;
      /*padding: 0 0 0 110px;      */
      .tooltip {
        @media (max-width: 767px) {
          display: none;
        }
      }
      .header {
        padding: 0 10px 0 0;
        display: block;     
        margin: 0;
        line-height: 35px;                                            
        color: $body-title-color;             
        font-weight: 700;           
        float: left;
        width: 110px;
        /*font-size: $font-medium;  
        text-transform: uppercase; 
        @include ab(0, 0, n, n);*/
      }
      .swatch-element {
        margin: 0; padding: 0;        
        float: left;
        label {
          position: relative;
          background: transparent;                 
          border: 1px solid $body-border-color;
          margin: 0px 10px 10px 0; 
          text-align: center;
          cursor: pointer;     
          min-width: 35px !important;
          height: 35px !important;
          padding: 5px;  
          line-height: 23px !important;
          color: $body-general-color;
          font-size: $body-font-size;
          @include border-radius-reset;
          @include box-shadow(0 0 0 1px #ffffff inset);
          @include transition(all 0.35s ease 0s);                    
        }
        input:checked + label{
          box-shadow: none;          
          cursor: default;
          border-color: $button-btn1-border;  
          color: $button-btn1-txt;
          background: $button-btn1;
          @include box-shadow(0 0 0 2px #ffffff inset);
        }       
        &:hover { 
          @media (min-width: 1025px) {
            label{
              border-color: $button-btn1-border;  
              color: $button-btn1-txt;
              background: $button-btn1;   
              @include box-shadow(0 0 0 2px #ffffff inset); 
            }
          }
        }
        &.soldout {
          label {
            cursor: default;
            background: transparent !important;
            color: #a39d94 !important;  
          } 
          &:hover {
            @media (min-width: 1025px) {
              label {
                cursor: default;
                background: transparent !important;
                color: #a39d94 !important;  
              }
            }
          }
        }               
      }
      &.size {        
        .swatch-element {
          label {
            @include box-shadow(0 0 0 0 $white);
          }
          input:checked + label {
            border-color: $button-btn1-border;  
            color: $button-btn1-txt;
            background: $button-btn1;   
            @include box-shadow(0 0 0 0 $white);
          }
          &:hover {
            @media (min-width: 1025px) {
              label {
                border-color: $button-btn1-border;  
                color: $button-btn1-txt;
                background: $button-btn1;   
                @include box-shadow(0 0 0 0 $white);
              }
            }            
          }
        }        
      }       
    }   

    .action-button {                 
      width: 100%;
      margin: 0 0 25px;
      /*max-width: 370px;*/
      .btn {
        min-width: 40px;
        line-height: 38px;
        padding: 10px 15px;
        /*font-family: $font-standard;*/
        font-size: $font-medium + 2px;
        font-weight: 700;
        height: 60px;
        width: 100% !important;
        .flaticon-commerce {
          &:before {
            margin-right: 8px;
            font-size: 14px;
          }
        }  
      } 
    }
    .product-action {    	
      .variants-wrapper {
        margin: 5px 0 0;
        clear: both;       
        .selector-wrapper {
          margin-bottom: 20px;
          clear: both;
          text-align: left;         
          select{
            min-width: 200px;
            height: 40px;
            padding: 0px 10px;
            line-height: 38px;
            font-size: 12px;        
            color: $body-general-color;     
            font-family: $font-heading;
            text-transform: uppercase;
            @media (max-width: 767px) {
              -webkit-appearance:none;
            }
          }          
        }
        label{    
          color: $body-title-color;               
          font-weight: 700; 
          margin: 0;          
          float: left;
          line-height: 40px;
          min-width: 110px;
          padding: 0 15px 0 0;
          white-space: nowrap;
          /*font-size: $font-medium;  
          text-transform: uppercase;*/
        }
      }      
      .quantity-product {
        margin: 0 0 20px;    
        overflow: hidden;
        label {
          float: left; 
          margin: 0;
          line-height: 40px;
          width: 110px;
          /*font-size: 14px;
          text-transform: uppercase;     */     
          font-weight: 700;
          color: $body-title-color;
        }            
        .quantity {     
          float: left;
          margin-right: 20px;         
          .qty-inner > span.qty-down {
            left: 110px;
          }
        }
        .size-chart {
          float: left;
          > a {
            color: $main-color;
            text-decoration: underline;
            display: inline-block;
            line-height: 40px;
            &:hover {
              text-decoration: none;
            }
          }
        }
        .qty-stock {
          display: inline-block;
          margin-bottom: 15px;
        }        
        @media (max-width: 379px) {
          float: none;	  
          width: 100%;
          margin: 0 0 15px 0;    
        }  
      }
      .total-price{        
        color: $body-price-color;
        display: inline-block;
        margin-right: 10px;
        margin-top: 16px;
        .price-sale{
          margin-right: 10px;
        }
      }     
    }    
  }
  &.product-extended {
    .product-info .product-action .action-button .add-to-cart {      
      width: 100%;                
      &:hover {        
        color: $white;
      }      
    }    
  }
  #related_item,
  .recently-viewed {
    margin: 55px auto;
    @media (max-width: 767px)  {
      margin-top: 40px;  	  
    }
    .title-wrapper {
      margin: 0 auto 43px;
    }
    .owl-theme .owl-controls .owl-nav > div {
      top: 40%;
    }
  }
}
