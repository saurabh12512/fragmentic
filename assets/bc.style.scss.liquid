    padding-top: 30px;
  }
}
.catalog-list {
  margin: 0 -15px;
  .item {
    background: $body-background-color;
    padding: 26px 15px 18px;
    width: 33.333333%;
    float: left;
    .title {
      padding: 0px 30px;
