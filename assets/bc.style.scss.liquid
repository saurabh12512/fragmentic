        padding: 0;
        margin: 0;        
        overflow: hidden;   
        a{
          color: $body-general-color;
          &:hover{            
            text-decoration: none;
            color: $main-color;
          }
        }        
      }             
    }
    .sb-filter {
      display: block;
      clear: both;
      width: 100%;
      float: left;
      text-align: left;
      font-weight: normal;
      .advanced-filters {
        max-height: 290px;
        overflow: auto;
        li.advanced-filter {
          line-height: 20px;
          margin-bottom: 7px;
          a{
            position: relative;
            padding-left: 30px;
            min-height: 20px;
            display: inline-block;    
            font-size: $body-font-size;        
            &:before{
              content: "";
              @include ab(3px,0,n,n);              
              width: 16px;
              height: 16px;              
              border: 1px solid $body-border-color;  
              @include transition(all 0.35s ease 0s);            
            }

            &:after {
              content: "\f00c";
              font-family: FontAwesome;
              font-size: 12px;
              width: 16px;
              height: 16px; 
              @include ab(1px, 3px, n, n);              
              @include opacity(0);
              @include transition(all 0.35s ease 0s);              
            }
            &:hover {
              @media (min-width: 1025px) {
                &:before {
                  border-color: $main-color;
                }
                &:after {
                  @include opacity(1);
                }
              }              
            }
          }

          &.af-color {
            border: none;
            padding: 0;
            float: none;
            width: inherit;
            margin: 0 4px 4px 0;
            width: 33px;
            height: 33px;
            line-height: 33px;            
            position: relative; 
            cursor: pointer;
            float: left;
            border: 1px solid $body-border-color;            
            @include box-shadow(0 0 0 1px #ffffff inset);  
            @include transition(all 0.35s ease 0s);

            a{              
              display: block;
              padding: 0;
              position: relative;
              display: block;  
              content: '';
              width: 100%;
              height: 100%;           

              &:before,
              &:after {                
                content: none !important;
              }
            }
            &:hover {
              @media (min-width: 1025px) {
                border-color: $main-color;
                @include box-shadow(0 0 0 1px #ffffff inset); 
              }
            }
            &.active-filter {
              border-color: $main-color;
              @include box-shadow(0 0 0 1px #ffffff inset); 
            }
          }

          &.active-filter {            
            a{
              &:before {
                border-color: $main-color;
              }
              &:after{
                @include opacity(1);
              }
            }
          }
        }
      }

      &.size {
        .advanced-filters {
          li.advanced-filter {
            width: auto;
            display: inline-block;
            float: left;
            margin: 0 4px 4px 0;
            border: 1px solid $body-border-color;   
            background: $white;     
            @include transition(all 0.35s ease 0s);    
            a{              
              padding: 0 5px;              
              text-transform: uppercase;              
              text-align: center;
              height: 33px;
              min-width: 33px;
              line-height: 33px;
              display: inline-block; 
              font-size: 12px;                          
              color: #717171;
              font-family: $font-heading;              

              &:before, &:after{
                width: 0;
                height: 0;
                border: 0;
                content: none;
              }              
            }
            &.active-filter {
              border-color: $button-btn1-border;
              a{
                background: $button-btn1;
                color: $button-btn1-txt;
              }
            }
            &:hover {                
              @media (min-width: 1025px) {
                border-color: $button-btn1-border;
                a{
                  background: $button-btn1;
                  color: $button-btn1-txt;
                }
              }
            }
          }
        }
      }
      &.price {
        @media (min-width: 1025px) {
          display: none;
        }
      }
    }    
    &.sb-product-type {
      .sb-title {
        margin-bottom: 10px;
      }
      > .type-list {
        border: 1px solid $body-border-color;        
        > li {
          margin: 0;
          > a {
            padding: 10px 20px;
            line-height: 26px;
            font-size: 15px;
            font-family: $font-heading;
            border-bottom: 1px solid $body-border-color;
            display: block;
            text-transform: uppercase;
            background: #fafafa;            
            &:hover {
              background: $main-color;
              color: $white;
            }
          }
          &:last-child {
            > a {
              border-bottom: none;
            }
          }         
        }
      }
    }   
  } 
}
