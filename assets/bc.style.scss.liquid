          background-color: #c5c5c5;
          text-indent :0;
          text-align: center;
          margin: 0;
          .fa {
            &:before, &:after {
              font-size: 17px;
            }
          }
          &.bx-next {
            bottom:0;
            top: auto;
          }
          &.bx-prev {
            top: 0;
          }
