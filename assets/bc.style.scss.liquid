      background-color: $body-label-bp-background;
      border-color: $body-label-bp-background;
      @include rotate(-45);
    }
  }
}
.image-sale-detail {
  font-size: 18px;
  font-weight: 700;
  text-transform: uppercase;    
  > span {       
    display: inline-block;
    float: left;
    clear: both;
    text-align: center;
    padding: 0;
    margin: 0;       
    border: none;        
    z-index: 1;
    width: 100px;
    height: 100px;
    line-height: 165px;
    @include ab(-50px, 0, n, n);
    &#image-label-sale {
      left: -50px;
      @include rotate(-45);
      color: $body-label-sale-color;
      background-color: $body-label-sale-background;
      border-color: $body-label-sale-background;  
    }
  }  
}
.add-to-wishlist {
  padding: 0 !important;
  border: none;
  @include border-radius-reset;
  span {
    width: 30px;
    height: 30px;    
    display: inline-block;
    text-align: center;    
  }
  &:hover {
