        @include ab(0, 0, 0, 0);
      }
    }
    &.banner-text {      
      @media (min-width: 768px) {
        height: 100%;
        width: 100%;
        display: table;
      }
    }    
    .text {
      display: table-cell;
      vertical-align: middle;
      padding: 5% 12%;
