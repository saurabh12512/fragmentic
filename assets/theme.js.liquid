		$(window).on( 'scroll' , function() {
			var b = jQuery(this).scrollTop();
			var c = jQuery(this).height();
			if (b > 100) {
				var d = b + c / 2;
			}
			else {
				var d = 1 ;
			}
			if (d < 1000 && d < c) {
				jQuery("#scroll-to-top").removeClass('on off').addClass('off');
			} else {
				jQuery("#scroll-to-top").removeClass('on off').addClass('on');
			}
		});
