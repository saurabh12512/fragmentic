						}
						,navText  : ['<span class="button-prev"></span>', '<span class="button-next"></span>']
					});
				})
				
				observer.unobserve(entry.target);
				

			}
		})
	  },  {
		root: null,
		rootMargin: "100px",
		threshold: 1
	  })
	  
	  const elements = document.querySelectorAll('.lazy-init')
