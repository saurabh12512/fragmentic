<body data-template="{{ template.suffix }}" class="{% if customer %}customer-logged-in {% endif %}template{{ template | split: '.' | first | camelize }}  {{ request.page_type }}" dir="{% if 'ar' contains request.locale.iso_code %}rtl{% else %}ltr{% endif %}">

    {% include 'navigation-mobile' %}

    {% if settings.cart_styles == 'sidebar' %}
      {% include 'cart-sidebar' %}
    {% endif %}

    {% if template contains 'collection.order-form' %}
      {% include 'filter-order-form' %}
    {% endif %}

    {% if settings.catalog_sb_placement == 'none' and template != 'collection.order-form' %}
      {% include 'filter-sidebar' %}
    {% endif %}

    <div id="page-body" class="breadcrumb-{{ settings.breadcrumb_styles }}{% if settings.general_placement == 'boxes' %} boxes{% endif %}">

      <!-- Begin Header -->

      <header class="notranslate header-content" data-stick="{{ settings.show_sticky_bar }}" translate="no">
{% include "starapps-core" %}

{% comment %} 
 {% endcomment %}


        {% include 'header-content' %}
      </header>
      
      {% section 'announcement' %}
      <!-- End Header -->

      <div id="body-content">

        <!-- Begin Breadcrumb-->
        {%- assign templateNotHaveBreadcrumb = 'index,collection' | split: ',' -%}
        {%- if settings.breadcrumb_styles != 'none' -%}
        	{%- unless templateNotHaveBreadcrumb contains request.page_type -%}
        		{%- unless page.handle contains "explore-our-brands" -%}
        		{% include 'breadcrumb' %}
        		{%- endunless -%}
        	{%- endunless -%}
        {%- endif -%}
        <!-- End Breadcrumb-->


        <!-- Begin Main Content -->

        <div id="main-content">
          <div class="main-content">

            {% unless template == 'index' %}
              <div class="container">
                {% endunless %}

                {% if template == 'list-collections' %}
                  {% include 'collections' %}
                {% else %}
                  {{ content_for_layout }}
                {% endif %}

                {% unless template == 'index' %}
              </div>
            {% endunless %}

          </div>
        </div>

        <!-- End Main Content -->

      </div>

      <!-- Begin Footer -->

      {% assign _style = settings.footer_style %}
      {% unless template contains 'collection.order-form' %}

        {% assign menu_style_3 = settings.footer_mennu  %}
        {% if _style == '3' and  menu_style_3 != blank %}
          <div class="block-menu bm-3">
            <ul class="list-inline">

              {% for l in linklists[menu_style_3].links %}
                <li><a href="{{ l.url }}"><span>{{ l.title }}</span></a></li>
              {% endfor %}

            </ul>
          </div>
        {% endif %}

        <footer id="footer-content" class="footer-style-{{ _style }}">
          {% include 'footer' %}
        </footer>
      {% endunless %}

      <!-- End Footer -->
    </div>
    {% if settings.show_back_to_top %}
      <div id="scroll-to-top" title="Back To Top">
        <a href="javascript:;"><i class="fa fa-angle-up"></i></a>
      </div>
    {% endif %}

    <div class="loading" style="display: none;"></div>
    {{ "api.jquery.js" | shopify_asset_url | script_tag }}

    {% if settings.cart_styles == 'dropdown' %}
      {% include 'cart-dd-custom' %}
    {% else %}
      {% include 'cart-sb-custom' %}
    {% endif %}

    {% include 'quick-shop' %}

    {% if settings.cart_styles == 'dropdown' %}
      {% include 'layer-cart-modal' %}
    {% endif %}

    {% include 'layout-wishlist' %}
    {% include 'layout-compare' %}
    {% include 'currencies' %}

    {% include 'mailchimp-popup' %}

    {% comment %} Linked Product Options {% endcomment %}
    {% unless template == 'product.group' or template == 'product.buy_with' %}
    {% include 'linked-options' %}
    {% endunless %}

    {% include 'bc-config-js' %}

    <script type="text/javascript">
      jQuery(function() {
        CartJS.init({{ cart | json }}, {
            dataAPI: true,
          	moneyFormat: '{{ shop.money_format }}',
            moneyWithCurrencyFormat: '{{ shop.money_with_currency_format }}',
            requestBodyClass: "cart-loading"
        });

      });
    </script>

    {% if settings.show_cookie_policy and settings.enable_js_minify != true %}
      <!--<script type="text/javascript" src="{{ 'eu-cookie-support-opt-in.js' | asset_url  }}"></script>
      <script type="text/javascript" src="{{ 'eu-require-opt-in.js' | asset_url  }}"></script>-->
    {% endif %}

  </div>

  {% if settings.enable_js_minify == true %}
	<script src="{{ 'theme.js' | asset_url }}"></script>
 {% endif %}

{% include 'gtranslate', float: 'yes' %}


{% include 'social-login' %}

  <script src="{{ 'seedgrow-whatsapp-button.js' | asset_url }}" defer="defer"></script>


